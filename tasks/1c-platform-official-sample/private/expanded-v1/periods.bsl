Функция Элемент(ИмяСправочника, Имя)
 Э = Справочники[ИмяСправочника].СоздатьЭлемент(); Э.Наименование = Имя;
 Если ИмяСправочника = "ФизическиеЛица" Тогда Э.@staff_date@ = Дата(2023,6,15); КонецЕсли;
 Э.Записать(); Возврат Э.Ссылка;
КонецФункции
Процедура График(Отдел, День, Часы)
 З = РегистрыСведений.@graph@.СоздатьМенеджерЗаписи(); З.Подразделение=Отдел; З.Дата=День; З.@resource@=Часы; З.Записать();
 З.Прочитать(); Если З.@resource@ <> Часы Тогда ВызватьИсключение "Observer graph fixture readback"; КонецЕсли;
КонецПроцедуры
Процедура Тариф(Сотрудник, Отдел, День, Значение)
 З = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); З.Период=День; З.Сотрудник=Сотрудник; З.Подразделение=Отдел; З.Ставка=Значение; З.Записать();
 З.Прочитать(); Если З.Ставка <> Значение Тогда ВызватьИсключение "Observer tariff fixture readback"; КонецЕсли;
КонецПроцедуры
Функция ДокументЗП(День)
 Д = Документы.НачислениеЗарплаты.СоздатьДокумент(); Д.Дата=День; Возврат Д;
КонецФункции
Процедура СтрокаЗП(Д, Сотрудник, Отдел, Вид, Начало, Конец)
 С=Д.@rows@.Добавить(); С.Сотрудник=Сотрудник; С.Подразделение=Отдел; С.ВидРасчета=ПланыВидовРасчета.@kinds@[Вид]; С.@start@=Начало; С.@end@=Конец;
КонецПроцедуры
Функция Данные(Д)
 З=Новый Запрос("ВЫБРАТЬ Подразделение.Наименование КАК Отдел, Сотрудник.Наименование КАК Сотрудник, ВидРасчета КАК Вид, ПериодРегистрации, Результат, Часы, Дни ИЗ РегистрРасчета.Начисления ГДЕ Регистратор=&Док УПОРЯДОЧИТЬ ПО ПериодРегистрации, Отдел, Сотрудник, Вид");
 З.УстановитьПараметр("Док",Д.Ссылка); В=З.Выполнить().Выбрать(); М=Новый Массив;
 Пока В.Следующий() Цикл М.Добавить(Новый Структура("department,employee,kind,month,amount,hours,days", В.Отдел,В.Сотрудник,?(В.Вид=ПланыВидовРасчета.@kinds@.Тариф,"Тариф",?(В.Вид=ПланыВидовРасчета.@kinds@.Премия,"Премия","Командировка")),Месяц(В.ПериодРегистрации),В.Результат,В.Часы,В.Дни)); КонецЦикла;
 Возврат М;
КонецФункции
Функция Отклоняет(Сотр,Отдел,Вид)
 Д=ДокументЗП(Дата(2025,2,25,12,0,0)); СтрокаЗП(Д,Сотр,Отдел,Вид,Дата(2025,1,10),Дата(2025,2,3));
 Попытка Д.Записать(РежимЗаписиДокумента.Проведение); Возврат Ложь; Исключение Возврат Истина; КонецПопытки;
КонецФункции
Функция Run() Экспорт
 Отдел=Элемент("Подразделения","Q_D"); Сотр=Элемент("ФизическиеЛица","Q_E"); Тариф(Сотр,Отдел,Дата(2024,10,1),100);
 Для Мес=10 По 12 Цикл
  График(Отдел,Дата(2024,Мес,10),1); Д=ДокументЗП(Дата(2024,Мес,25,12,0,0)); СтрокаЗП(Д,Сотр,Отдел,"Тариф",Дата(2024,Мес,1),КонецМесяца(Дата(2024,Мес,1))); Д.Записать(РежимЗаписиДокумента.Проведение);
 КонецЦикла;
 График(Отдел,Дата(2025,1,10),8); График(Отдел,Дата(2025,1,28),8); График(Отдел,Дата(2025,2,10),8); График(Отдел,Дата(2025,3,1),8);
 Д=ДокументЗП(Дата(2025,1,25,12,0,0)); СтрокаЗП(Д,Сотр,Отдел,"Тариф",Дата(2025,1,10),Дата(2025,1,31)); Д.Записать(РежимЗаписиДокумента.Проведение);
 Р=Новый Структура("within_month,tariff_rejected,bonus_rejected",Данные(Д),Отклоняет(Сотр,Отдел,"Тариф"),Отклоняет(Сотр,Отдел,"Премия"));
 К=ДокументЗП(Дата(2025,3,25,12,0,0)); СтрокаЗП(К,Сотр,Отдел,"Командировка",Дата(2025,1,28),Дата(2025,3,4)); К.Записать(РежимЗаписиДокумента.Проведение);
 З=Новый Запрос("ВЫБРАТЬ ПериодРегистрации, ПериодДействияНачало, ПериодДействияКонец ИЗ РегистрРасчета.Начисления ГДЕ Регистратор=&Док УПОРЯДОЧИТЬ ПО ПериодРегистрации"); З.УстановитьПараметр("Док",К.Ссылка); В=З.Выполнить().Выбрать(); М=Новый Массив;
 Пока В.Следующий() Цикл М.Добавить(Новый Структура("month,start_month,start_day,end_month,end_day",Месяц(В.ПериодРегистрации),Месяц(В.ПериодДействияНачало),День(В.ПериодДействияНачало),Месяц(В.ПериодДействияКонец),День(В.ПериодДействияКонец))); КонецЦикла;
 Р.Вставить("trip_segments",М); Возврат Р;
КонецФункции
