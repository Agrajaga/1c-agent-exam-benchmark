Функция Элемент(Справочник,Имя)
 Э=Справочники[Справочник].СоздатьЭлемент(); Э.Наименование=Имя; Э.Записать(); Возврат Э.Ссылка;
КонецФункции
Функция Свойство(Имя,Ном)
 Э=Справочники.@properties@.СоздатьЭлемент(); Э.Наименование=Имя; Э.@prop_item_field@=Ном; Э.Записать(); Возврат Э.Ссылка;
КонецФункции
Функция Товар(Имя,Вид)
 Э=Справочники.Номенклатура.СоздатьЭлемент(); Э.Наименование=Имя; Э.Артикул=Имя; Э.Вид=Перечисления.@type_enum@[Вид]; Э.Записать(); Возврат Э.Ссылка;
КонецФункции
Процедура Политика(Отдел,Метод)
 З=РегистрыСведений.@policy@.СоздатьМенеджерЗаписи(); З.Период=Дата(2025,1,1); З.Подразделение=Отдел; З.@policy_field@=Перечисления.@enum@[Метод]; З.Записать();
 З.Прочитать(); Если З.@policy_field@ <> Перечисления.@enum@[Метод] Тогда ВызватьИсключение "Observer policy fixture readback"; КонецЕсли;
КонецПроцедуры
Функция Приход(Отдел,Ном,Свойство,Кол,Цена,День)
 Д=Документы.ПриходнаяНакладная.СоздатьДокумент(); Д.Дата=День; Д.Подразделение=Отдел; @bu_off@
 С=Д.@goods@.Добавить(); С.Номенклатура=Ном; С.Свойство=Свойство; С.Количество=Кол; С.Цена=Цена; С.Сумма=Кол*Цена;
 Д.Записать(РежимЗаписиДокумента.Проведение); Возврат Д;
КонецФункции
Функция Движения(Д)
 З=Новый Запрос("ВЫБРАТЬ Подразделение.Наименование КАК Отдел, Номенклатура.Наименование КАК Товар, Свойство.Наименование КАК СвойствоТекст, ВидДвижения, СУММА(Количество) КАК Количество, СУММА(Стоимость) КАК Стоимость ИЗ РегистрНакопления.@parties@ ГДЕ Регистратор=&Док И Активность СГРУППИРОВАТЬ ПО Подразделение.Наименование,Номенклатура.Наименование,Свойство.Наименование,ВидДвижения УПОРЯДОЧИТЬ ПО Отдел,Товар,СвойствоТекст"); З.УстановитьПараметр("Док",Д.Ссылка); В=З.Выполнить().Выбрать(); М=Новый Массив;
 Пока В.Следующий() Цикл М.Добавить(Новый Структура("department,item,property,direction,quantity,cost",В.Отдел,В.Товар,Строка(В.СвойствоТекст),?(В.ВидДвижения=ВидДвиженияНакопления.Расход,"expense","receipt"),В.Количество,В.Стоимость)); КонецЦикла; Возврат М;
КонецФункции
Функция Остатки()
 З=Новый Запрос("ВЫБРАТЬ Подразделение.Наименование КАК Отдел,Номенклатура.Наименование КАК Товар,Свойство.Наименование КАК СвойствоТекст,СУММА(КоличествоОстаток) КАК Количество,СУММА(СтоимостьОстаток) КАК Стоимость ИЗ РегистрНакопления.@parties@.Остатки СГРУППИРОВАТЬ ПО Подразделение.Наименование,Номенклатура.Наименование,Свойство.Наименование УПОРЯДОЧИТЬ ПО Отдел,Товар,СвойствоТекст"); В=З.Выполнить().Выбрать(); М=Новый Массив;
 Пока В.Следующий() Цикл М.Добавить(Новый Структура("department,item,property,quantity,cost",В.Отдел,В.Товар,Строка(В.СвойствоТекст),В.Количество,В.Стоимость)); КонецЦикла; Возврат М;
КонецФункции
Функция ПроверкаПолитик()
 Ном=Товар("P_ITEM","Периферия"); Св=Справочники.@properties@.ПустаяСсылка(); Д=Документы.РасходнаяНакладная.СоздатьДокумент(); Д.Дата=Дата(2025,1,3,12,0,0); @bu_off@
 Методы=СтрРазделить("ФИФО,ЛИФО,@mean@",","); Счетчик=0;
 Для Каждого Метод Из Методы Цикл
  Счетчик=Счетчик+1; Отдел=Элемент("Подразделения","P_D"+Строка(Счетчик)); Политика(Отдел,Метод);
  Приход(Отдел,Ном,Св,2,10,Дата(2025,1,1,12,0,0)); Приход(Отдел,Ном,Св,3,20,Дата(2025,1,2,12,0,0));
  С=Д.@goods@.Добавить(); С.Подразделение=Отдел; С.Номенклатура=Ном; С.Свойство=Св; С.Количество=3; С.Цена=30; С.Сумма=90;
 КонецЦикла;
 До=Остатки(); Д.Записать(РежимЗаписиДокумента.Проведение); Возврат Новый Структура("before,movements,after",До,Движения(Д),Остатки());
КонецФункции
Процедура Спецификация(Блок,Деталь,Свойство,Количество,День)
 З=РегистрыСведений.@specs@.СоздатьМенеджерЗаписи(); @spec_date@=День; З.@spec_block@=Блок; З.Деталь=Деталь; З.Свойство=Свойство; З.Количество=Количество; З.Записать();
 З.Прочитать(); Если З.Количество<>Количество Тогда ВызватьИсключение "Observer specification fixture readback"; КонецЕсли;
КонецПроцедуры
Функция ПроверкаСборки()
 Источник=Элемент("Подразделения","S_SOURCE"); П=Элемент("Подразделения","S_DEST"); Ч=Элемент("Подразделения","S_OTHER"); Политика(Источник,"ФИФО");
 А=Товар("S_A","Деталь"); Б=Товар("S_B","Деталь"); Блок=Товар("S_BLOCK","СистемныйБлок");
 П1=Свойство("P1",А); П2=Свойство("P2",А); К1=Свойство("Q1",Б);
 Приход(Источник,А,П1,10,10,Дата(2025,1,1,12,0,0)); Приход(Источник,Б,К1,10,30,Дата(2025,1,1,13,0,0)); Приход(Источник,А,П2,9,100,Дата(2025,1,1,14,0,0)); Приход(Ч,А,П1,4,200,Дата(2025,1,1,15,0,0));
 Спецификация(Блок,А,П1,1,Дата(2025,1,6)); Спецификация(Блок,Б,К1,1,Дата(2025,1,6)); Спецификация(Блок,А,П1,2,Дата(2025,1,13)); Спецификация(Блок,Б,К1,1,Дата(2025,1,13));
 Д=Документы.Сборка.СоздатьДокумент(); Д.Дата=Дата(2025,1,13,12,0,0); Д.ПодразделениеИсточник=Источник; Д.ПодразделениеПолучатель=П;
 С=Д.@blocks@.Добавить(); С.Номенклатура=Блок; С.Количество=2;
 С=Д.ДополнительныеДетали.Добавить(); С.Номенклатура=А; С.Свойство=П1; С.Количество=1;
 До=Остатки(); Д.Записать(РежимЗаписиДокумента.Проведение); Возврат Новый Структура("before,movements,after",До,Движения(Д),Остатки());
КонецФункции
Функция Run() Экспорт
 Р=Новый Структура;
 Попытка Р.Вставить("policies",ПроверкаПолитик()); Исключение Р.Вставить("policies_error",ОписаниеОшибки()); КонецПопытки;
 Попытка Р.Вставить("assembly",ПроверкаСборки()); Исключение Р.Вставить("assembly_error",ОписаниеОшибки()); КонецПопытки;
 Возврат Р;
КонецФункции
