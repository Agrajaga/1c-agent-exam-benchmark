Функция Элемент(ИмяСправочника, Имя)
 Э = Справочники[ИмяСправочника].СоздатьЭлемент(); Э.Наименование = Имя;
 Если ИмяСправочника = "ФизическиеЛица" Тогда Э.@staff_date@ = Дата(2023,6,15); КонецЕсли;
 Э.Записать(); Возврат Э.Ссылка;
КонецФункции
Процедура График(Отдел, День, Часы)
 З = РегистрыСведений.@graph@.СоздатьМенеджерЗаписи(); З.Подразделение=Отдел; З.Дата=День; З.@resource@=Часы; З.Записать();
 З.Прочитать(); Если З.@resource@ <> Часы Тогда ВызватьИсключение "Observer graph fixture readback"; КонецЕсли;
КонецПроцедуры
Процедура Тариф(Сотрудник, Отдел, День, Значение)
 З = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); З.Период=День; З.Сотрудник=Сотрудник; З.Подразделение=Отдел; З.Ставка=Значение; З.Записать();
 З.Прочитать(); Если З.Ставка <> Значение Тогда ВызватьИсключение "Observer tariff fixture readback"; КонецЕсли;
КонецПроцедуры
Функция ДокументЗП(День)
 Д = Документы.НачислениеЗарплаты.СоздатьДокумент(); Д.Дата=День; Возврат Д;
КонецФункции
Процедура СтрокаЗП(Д, Сотрудник, Отдел, Вид, Начало, Конец)
 С=Д.@rows@.Добавить(); С.Сотрудник=Сотрудник; С.Подразделение=Отдел; С.ВидРасчета=ПланыВидовРасчета.@kinds@[Вид]; С.@start@=Начало; С.@end@=Конец;
КонецПроцедуры
Функция Данные(Д)
 З=Новый Запрос("ВЫБРАТЬ Подразделение.Наименование КАК Отдел, Сотрудник.Наименование КАК Сотрудник, ВидРасчета КАК Вид, ПериодРегистрации, Результат, Часы, Дни ИЗ РегистрРасчета.Начисления ГДЕ Регистратор=&Док УПОРЯДОЧИТЬ ПО ПериодРегистрации, Отдел, Сотрудник, Вид");
 З.УстановитьПараметр("Док",Д.Ссылка); В=З.Выполнить().Выбрать(); М=Новый Массив;
 Пока В.Следующий() Цикл М.Добавить(Новый Структура("department,employee,kind,month,amount,hours,days", В.Отдел,В.Сотрудник,?(В.Вид=ПланыВидовРасчета.@kinds@.Тариф,"Тариф",?(В.Вид=ПланыВидовРасчета.@kinds@.Премия,"Премия","Командировка")),Месяц(В.ПериодРегистрации),В.Результат,В.Часы,В.Дни)); КонецЦикла;
 Возврат М;
КонецФункции
Функция ПроверкаТарифа()
 Д1=Элемент("Подразделения","T_D1"); Д2=Элемент("Подразделения","T_D2"); Сотр=Элемент("ФизическиеЛица","T_E");
 Тариф(Сотр,Д1,Дата(2025,1,1),100); Тариф(Сотр,Д1,Дата(2025,1,15),200); Тариф(Сотр,Д2,Дата(2025,1,1),100); Тариф(Сотр,Д2,Дата(2025,1,15),200);
 График(Д1,Дата(2025,1,10),8); График(Д2,Дата(2025,1,10),16); График(Д1,Дата(2025,2,10),8);
 Д=ДокументЗП(Дата(2025,2,25,12,0,0));
 СтрокаЗП(Д,Сотр,Д1,"Тариф",Дата(2025,1,1),Дата(2025,1,31)); СтрокаЗП(Д,Сотр,Д2,"Тариф",Дата(2025,1,1),Дата(2025,1,31)); СтрокаЗП(Д,Сотр,Д1,"Тариф",Дата(2025,2,1),Дата(2025,2,28));
 Д.Записать(РежимЗаписиДокумента.Проведение); Возврат Данные(Д);
КонецФункции
Функция ПроверкаЗаднимЧислом()
 Отдел=Элемент("Подразделения","R_D"); Сотр=Элемент("ФизическиеЛица","R_E"); Тариф(Сотр,Отдел,Дата(2024,10,1),300); Тариф(Сотр,Отдел,Дата(2025,1,1),100);
 Для Мес=10 По 12 Цикл
  ЧислоДней=?(Мес=10,10,?(Мес=11,9,11));
  Для День=1 По ЧислоДней Цикл График(Отдел,Дата(2024,Мес,День),1); КонецЦикла;
  Д=ДокументЗП(Дата(2024,Мес,25,12,0,0)); СтрокаЗП(Д,Сотр,Отдел,"Тариф",Дата(2024,Мес,1),КонецМесяца(Дата(2024,Мес,1))); Д.Записать(РежимЗаписиДокумента.Проведение);
 КонецЦикла;
 График(Отдел,Дата(2025,1,10),8); График(Отдел,Дата(2025,1,12),8); График(Отдел,Дата(2025,1,13),8);
 Д=ДокументЗП(Дата(2025,1,25,12,0,0)); СтрокаЗП(Д,Сотр,Отдел,"Тариф",Дата(2025,1,1),Дата(2025,1,31)); Д.Записать(РежимЗаписиДокумента.Проведение);
 До=Данные(Д); К=ДокументЗП(Дата(2025,1,26,12,0,0)); СтрокаЗП(К,Сотр,Отдел,"Командировка",Дата(2025,1,10),Дата(2025,1,12)); К.Записать(РежимЗаписиДокумента.Проведение);
 Возврат Новый Структура("before,after,trip",До,Данные(Д),Данные(К));
КонецФункции
Функция ПроверкаПремии()
 Отдел=Элемент("Подразделения","B_D"); Чужой=Элемент("Подразделения","B_OTHER");
 С1=Элемент("ФизическиеЛица","B_E1"); С2=Элемент("ФизическиеЛица","B_E2"); Нач=Элемент("ФизическиеЛица","B_M"); С3=Элемент("ФизическиеЛица","B_OTHER");
 Тариф(С1,Отдел,Дата(2025,2,1),1000); Тариф(С2,Отдел,Дата(2025,2,1),2000); Тариф(Нач,Отдел,Дата(2025,2,1),500); Тариф(С3,Чужой,Дата(2025,2,1),9000);
 График(Отдел,Дата(2025,2,10),1); График(Чужой,Дата(2025,2,10),1); График(Отдел,Дата(2025,3,10),1);
 Д=ДокументЗП(Дата(2025,2,25,12,0,0)); СтрокаЗП(Д,С1,Отдел,"Тариф",Дата(2025,2,1),Дата(2025,2,28)); СтрокаЗП(Д,С2,Отдел,"Тариф",Дата(2025,2,1),Дата(2025,2,28)); СтрокаЗП(Д,Нач,Отдел,"Тариф",Дата(2025,2,1),Дата(2025,2,28)); СтрокаЗП(Д,С3,Чужой,"Тариф",Дата(2025,2,1),Дата(2025,2,28)); Д.Записать(РежимЗаписиДокумента.Проведение);
 Ш=РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Ш.СтажОт=1; Ш.Процент=10; Ш.Записать();
 П=ДокументЗП(Дата(2025,3,25,12,0,0)); СтрокаЗП(П,Нач,Отдел,"Премия",Дата(2025,3,1),Дата(2025,3,31)); П.Записать(РежимЗаписиДокумента.Проведение); Р10=Данные(П);
 Ш.Процент=12; Ш.Записать(); П=П.Ссылка.ПолучитьОбъект(); П.Записать(РежимЗаписиДокумента.Проведение); Р12=Данные(П);
 Ш.Процент=17; Ш.Записать(); П=П.Ссылка.ПолучитьОбъект(); П.Записать(РежимЗаписиДокумента.Проведение);
 Возврат Новый Структура("p10,p12,p17",Р10,Р12,Данные(П));
КонецФункции
Функция ПроверкаВсехНачислений()
 Отдел=Элемент("Подразделения","A_D"); Сотр=Элемент("ФизическиеЛица","A_E"); Другой=Элемент("ФизическиеЛица","A_E2");
 Тариф(Сотр,Отдел,Дата(2024,7,1),100); Тариф(Другой,Отдел,Дата(2024,10,1),1000);
 Для Мес=7 По 12 Цикл График(Отдел,Дата(2024,Мес,10),1); КонецЦикла; График(Отдел,Дата(2025,1,10),1);
 Для Мес=7 По 11 Цикл
  Д=ДокументЗП(Дата(2024,Мес,25,12,0,0)); СтрокаЗП(Д,Сотр,Отдел,"Тариф",Дата(2024,Мес,1),КонецМесяца(Дата(2024,Мес,1)));
  Если Мес=10 Тогда СтрокаЗП(Д,Другой,Отдел,"Тариф",Дата(2024,Мес,1),КонецМесяца(Дата(2024,Мес,1))); КонецЕсли;
  Д.Записать(РежимЗаписиДокумента.Проведение);
 КонецЦикла;
 Ш=РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Ш.СтажОт=1; Ш.Процент=10; Ш.Записать();
 П=ДокументЗП(Дата(2024,11,26,12,0,0)); СтрокаЗП(П,Сотр,Отдел,"Премия",Дата(2024,11,1),Дата(2024,11,30)); П.Записать(РежимЗаписиДокумента.Проведение);
 Д=ДокументЗП(Дата(2024,12,25,12,0,0)); СтрокаЗП(Д,Сотр,Отдел,"Тариф",Дата(2024,12,1),Дата(2024,12,31)); СтрокаЗП(Д,Сотр,Отдел,"Командировка",Дата(2024,12,1),Дата(2024,12,31)); Д.Записать(РежимЗаписиДокумента.Проведение);
 К=ДокументЗП(Дата(2025,1,25,12,0,0)); СтрокаЗП(К,Сотр,Отдел,"Командировка",Дата(2025,1,1),Дата(2025,1,31)); К.Записать(РежимЗаписиДокумента.Проведение);
 Возврат Новый Структура("bonus,december,january",Данные(П),Данные(Д),Данные(К));
КонецФункции
Функция Run() Экспорт
 Р=Новый Структура;
 Попытка Р.Вставить("tariff",ПроверкаТарифа()); Исключение Р.Вставить("tariff_error",ОписаниеОшибки()); КонецПопытки;
 Попытка Р.Вставить("retro_trip",ПроверкаЗаднимЧислом()); Исключение Р.Вставить("retro_trip_error",ОписаниеОшибки()); КонецПопытки;
 Попытка Р.Вставить("bonus",ПроверкаПремии()); Исключение Р.Вставить("bonus_error",ОписаниеОшибки()); КонецПопытки;
 Попытка Р.Вставить("all_accruals",ПроверкаВсехНачислений()); Исключение Р.Вставить("all_accruals_error",ОписаниеОшибки()); КонецПопытки;
 Возврат Р;
КонецФункции
