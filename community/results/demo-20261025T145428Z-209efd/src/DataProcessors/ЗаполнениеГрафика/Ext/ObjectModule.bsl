Процедура ЗаполнитьГрафик(ДатаНачала, ДатаОкончания, ВыходныеДни) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Подразделения.Ссылка КАК Подразделение
	|ИЗ
	|	Справочник.Подразделения КАК Подразделения
	|ГДЕ
	|	НЕ Подразделения.ПометкаУдаления
	|	И НЕ Подразделения.ЭтоГруппа";
	Подразделения = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Подразделение");
	Если Подразделения.Количество() = 0 Тогда
		Подразделения.Добавить(Справочники.Подразделения.ПустаяСсылка());
	КонецЕсли;

	Для Каждого Подразделение Из Подразделения Цикл
		Набор = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей();
		Набор.Отбор.Подразделение.Установить(Подразделение);
		Набор.Прочитать();
		Дат = НачалоДня(ДатаНачала);
		Пока Дат <= ДатаОкончания Цикл
			Найденные = Набор.НайтиСтроки(Новый Структура("Дата", Дат));
			Если Найденные.Количество() = 0 Тогда
				Запись = Набор.Добавить();
				Запись.Подразделение = Подразделение;
				Запись.Дата = Дат;
			Иначе
				Запись = Найденные[0];
			КонецЕсли;
			Если Найти(ВыходныеДни, Строка(ДеньНедели(Дат))) > 0 Тогда
				Запись.Часы = 0;
			Иначе
				Запись.Часы = 8;
			КонецЕсли;
			Дат = Дат + 86400;
		КонецЦикла;
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры
