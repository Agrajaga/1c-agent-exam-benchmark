&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПостроитьДополнительныеПоля();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ПостроитьДополнительныеПоля();
	ЗаполнитьДополнительныеПоля(ТекущийОбъект.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент) Экспорт

	ОбновитьДополнительныеПоля();

КонецПроцедуры

&НаСервере
Процедура ОбновитьДополнительныеПоля()

	ПостроитьДополнительныеПоля();
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьДополнительныеПоля(Объект.Ссылка);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Набор = РегистрыСведений.ЗначенияСведенийКонтрагентов.СоздатьНаборЗаписей();
	Набор.Отбор.Контрагент.Установить(ТекущийОбъект.Ссылка);
	Для Каждого Реквизит Из ПолучитьРеквизиты() Цикл
		Если НЕ СтрНачинаетсяС(Реквизит.Имя, "Доб_") Тогда
			Продолжить;
		КонецЕсли;
		Свойство = СвойствоПоИмени(Реквизит.Имя);
		Если НЕ ЗначениеЗаполнено(Свойство) Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЭтотОбъект[Реквизит.Имя];
		Запись = Набор.Добавить();
		Запись.Контрагент = ТекущийОбъект.Ссылка;
		Запись.Свойство = Свойство;
		Запись.Значение = Значение;
	КонецЦикла;
	Набор.Записать();

КонецПроцедуры

&НаСервере
Процедура ПостроитьДополнительныеПоля()

	Удаляемые = Новый Массив;
	Для Каждого Реквизит Из ПолучитьРеквизиты() Цикл
		Если СтрНачинаетсяС(Реквизит.Имя, "Доб_") Тогда
			Удаляемые.Добавить(Реквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из Удаляемые Цикл
		Элемент = Элементы.Найти(Имя);
		Если Элемент <> Неопределено Тогда
			Элементы.Удалить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Если Удаляемые.Количество() > 0 Тогда
		ИзменитьРеквизиты(, Удаляемые);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Менеджер) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Менеджер", Объект.Менеджер);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реквизиты.Свойство КАК Свойство,
	|	Реквизиты.Свойство.Наименование КАК Наименование,
	|	Реквизиты.Свойство.ТипЗначения КАК ТипЗначения
	|ИЗ
	|	Справочник.ФизическиеЛица.ДополнительныеРеквизиты КАК Реквизиты
	|ГДЕ
	|	Реквизиты.Ссылка = &Менеджер
	|	И Реквизиты.Свойство <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеСведения.ПустаяСсылка)";
	Добавляемые = Новый Массив;
	ОписаниеПолей = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = ИмяРеквизита(Выборка.Свойство);
		ТипЗначения = Выборка.ТипЗначения;
		Если ТипЗначения = Неопределено ИЛИ ТипЗначения.Типы().Количество() = 0 Тогда
			ТипЗначения = Метаданные.ПланыВидовХарактеристик.ДополнительныеСведения.Тип;
		КонецЕсли;
		Добавляемые.Добавить(Новый РеквизитФормы(Имя, ТипЗначения, "", Выборка.Наименование, Истина));
		ОписаниеПолей.Добавить(Новый Структура("Имя, Заголовок", Имя, Выборка.Наименование));
	КонецЦикла;
	Если Добавляемые.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ИзменитьРеквизиты(Добавляемые);
	Для Каждого Описание Из ОписаниеПолей Цикл
		Поле = Элементы.Добавить(Описание.Имя, Тип("ПолеФормы"), Элементы.ГруппаДоп);
		Поле.Вид = ВидПоляФормы.ПолеВвода;
		Поле.ПутьКДанным = Описание.Имя;
		Поле.Заголовок = Описание.Заголовок;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеПоля(Контрагент)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Значения.Свойство КАК Свойство,
	|	Значения.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСведенийКонтрагентов КАК Значения
	|ГДЕ
	|	Значения.Контрагент = &Контрагент";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = ИмяРеквизита(Выборка.Свойство);
		Если Элементы.Найти(Имя) <> Неопределено Тогда
			ЭтотОбъект[Имя] = Выборка.Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ИмяРеквизита(Свойство)

	Возврат "Доб_" + СтрЗаменить(Строка(Свойство.УникальныйИдентификатор()), "-", "");

КонецФункции

&НаСервере
Функция СвойствоПоИмени(Имя)

	Идентификатор = ВРег(Сред(Имя, 5));
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сведения.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеСведения КАК Сведения";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ВРег(СтрЗаменить(Строка(Выборка.Ссылка.УникальныйИдентификатор()), "-", "")) = Идентификатор Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат ПланыВидовХарактеристик.ДополнительныеСведения.ПустаяСсылка();

КонецФункции
