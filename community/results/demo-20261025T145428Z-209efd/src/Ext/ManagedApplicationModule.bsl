Процедура ПриНачалеРаботыСистемы()

	Если ПараметрЗапуска = "Demo" Тогда
		ЗаполнениеДемоДанных.ЗаполнитьИПроверить();
		ПроверитьФормуКонтрагента();
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьФормуКонтрагента()

	Текст = "";
	Попытка
		ПараметрыФормы = ЗаполнениеДемоДанных.ПараметрыПроверкиФормы();
		Форма = ПолучитьФорму("Справочник.Контрагенты.Форма.ФормаЭлемента");
		Форма.Объект.Наименование = "Проверка формы";
		Форма.Объект.Менеджер = ПараметрыФормы.Менеджер;
		Форма.МенеджерПриИзменении(Неопределено);
		НашлиВалюту = Ложь;
		НашлиСрок = Ложь;
		Для Каждого Элемент Из Форма.Элементы Цикл
			Заголовок = Строка(Элемент.Заголовок);
			Если СтрНайти(Заголовок, "Валюта кредита") > 0 Тогда
				НашлиВалюту = Истина;
				Форма[Элемент.Имя] = ПараметрыФормы.Валюта;
			ИначеЕсли СтрНайти(Заголовок, "Срок кредита") > 0 Тогда
				НашлиСрок = Истина;
				Форма[Элемент.Имя] = 45;
			КонецЕсли;
		КонецЦикла;
		Если НЕ НашлиВалюту ИЛИ НЕ НашлиСрок Тогда
			Текст = "FAIL форма поля валюта=" + НашлиВалюту + " срок=" + НашлиСрок;
		Иначе
			Форма.Записать();
			Текст = ЗаполнениеДемоДанных.ПроверитьСведенияФормы(Форма.Объект.Ссылка, ПараметрыФормы.Валюта, 45);
		КонецЕсли;
	Исключение
		Текст = "FAIL форма " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	ЗаполнениеДемоДанных.ДописатьЛог(Текст);

КонецПроцедуры
