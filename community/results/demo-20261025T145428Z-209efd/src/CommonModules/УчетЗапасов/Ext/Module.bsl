Процедура ПровестиПриход(Документ, Отказ) Экспорт

	Если НЕ ЗначениеЗаполнено(Документ.Подразделение) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Строка Из Документ.СписокНоменклатуры Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) ИЛИ Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Движение = Документ.Движения.ОстаткиДеталей.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Документ.Дата;
		Движение.Подразделение = Документ.Подразделение;
		Движение.Номенклатура = Строка.Номенклатура;
		Движение.Свойство = Строка.Свойство;
		Движение.Партия = Документ.Ссылка;
		Движение.Количество = Строка.Количество;
		Движение.Стоимость = СуммаСтроки(Строка);
	КонецЦикла;

КонецПроцедуры

Процедура ПровестиРасход(Документ, Отказ) Экспорт

	Ключи = НоваяТаблицаКлючей();
	Для Каждого Строка Из Документ.СписокНоменклатуры Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Подразделение) ИЛИ НЕ ЗначениеЗаполнено(Строка.Номенклатура) ИЛИ Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьКлюч(Ключи, Строка.Подразделение, Строка.Номенклатура, ПустоеСвойство());
	КонецЦикла;
	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Остатки = ОстаткиПоКлючам(Документ.МоментВремени(), Ключи);
	Политики = ПолитикиПодразделений(Документ.Дата, Ключи.ВыгрузитьКолонку("Подразделение"));
	Переоцененные = Новый Соответствие;

	Для Каждого Строка Из Документ.СписокНоменклатуры Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Подразделение) ИЛИ НЕ ЗначениеЗаполнено(Строка.Номенклатура) ИЛИ Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Метод = Политики.Получить(Строка.Подразделение);
		Если Метод = Неопределено Тогда
			Отказ = Истина;
			Сообщить("Не задана учетная политика подразделения " + Строка.Подразделение);
			Возврат;
		КонецЕсли;
		Себестоимость = Списать(Документ, Остатки, Переоцененные, Строка.Подразделение, Строка.Номенклатура, ПустоеСвойство(), Строка.Количество, Метод, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		Продажа = Документ.Движения.Продажи.Добавить();
		Продажа.Период = Документ.Дата;
		Продажа.Подразделение = Строка.Подразделение;
		Продажа.Номенклатура = Строка.Номенклатура;
		Продажа.Количество = Строка.Количество;
		Продажа.Себестоимость = Себестоимость;
		Продажа.Выручка = СуммаСтроки(Строка);
	КонецЦикла;

КонецПроцедуры

Процедура ПровестиСборку(Документ, Отказ) Экспорт

	Если НЕ ЗначениеЗаполнено(Документ.ПодразделениеИсточник) ИЛИ НЕ ЗначениеЗаполнено(Документ.ПодразделениеПолучатель) Тогда
		Отказ = Истина;
		Сообщить("В сборке нужно указать подразделение-источник и подразделение-получатель");
		Возврат;
	КонецЕсли;

	Потребность = НоваяПотребность();
	ИндексБлока = 0;
	Для Каждого Строка Из Документ.Состав Цикл
		Если НЕ ЗначениеЗаполнено(Строка.СистемныйБлок) ИЛИ Строка.Количество = 0 Тогда
			ИндексБлока = ИндексБлока + 1;
			Продолжить;
		КонецЕсли;
		Спецификация = СпецификацияБлока(Документ.МоментВремени(), Строка.СистемныйБлок);
		Для Каждого Деталь Из Спецификация Цикл
			ДобавитьПотребность(Потребность, Деталь.Номенклатура, Деталь.Свойство, Деталь.Количество * Строка.Количество, ИндексБлока, Ложь);
		КонецЦикла;
		ИндексБлока = ИндексБлока + 1;
	КонецЦикла;
	Для Каждого Строка Из Документ.ДополнительныеДетали Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) ИЛИ Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьПотребность(Потребность, Строка.Номенклатура, Строка.Свойство, Строка.Количество, -1, Истина);
	КонецЦикла;

	Ключи = НоваяТаблицаКлючей();
	Для Каждого Строка Из Потребность Цикл
		ДобавитьКлюч(Ключи, Документ.ПодразделениеИсточник, Строка.Номенклатура, Строка.Свойство);
	КонецЦикла;

	Метод = Перечисления.УчетнаяПолитика.ФИФО;
	Остатки = НоваяТаблицаОстатков();
	Переоцененные = Новый Соответствие;
	Если Ключи.Количество() > 0 Тогда
		Политики = ПолитикиПодразделений(Документ.Дата, Ключи.ВыгрузитьКолонку("Подразделение"));
		Метод = Политики.Получить(Документ.ПодразделениеИсточник);
		Если Метод = Неопределено Тогда
			Отказ = Истина;
			Сообщить("Не задана учетная политика подразделения " + Документ.ПодразделениеИсточник);
			Возврат;
		КонецЕсли;
		Остатки = ОстаткиПоКлючам(Документ.МоментВремени(), Ключи);
	КонецЕсли;

	СтоимостьБлоков = Новый Массив;
	Для Индекс = 0 По Документ.Состав.Количество() - 1 Цикл
		СтоимостьБлоков.Добавить(0);
	КонецЦикла;
	СтоимостьДополнительных = 0;

	Для Каждого Строка Из Потребность Цикл
		Себестоимость = Списать(Документ, Остатки, Переоцененные, Документ.ПодразделениеИсточник, Строка.Номенклатура, Строка.Свойство, Строка.Количество, Метод, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		РаспределитьСтоимость(Строка, Себестоимость, СтоимостьБлоков, СтоимостьДополнительных);
	КонецЦикла;

	ВсегоБлоков = 0;
	Для Каждого Строка Из Документ.Состав Цикл
		ВсегоБлоков = ВсегоБлоков + Строка.Количество;
	КонецЦикла;
	Если ВсегоБлоков > 0 И СтоимостьДополнительных <> 0 Тогда
		Распределено = 0;
		Последний = -1;
		Для Индекс = 0 По Документ.Состав.Количество() - 1 Цикл
			Если Документ.Состав[Индекс].Количество > 0 Тогда
				Последний = Индекс;
			КонецЕсли;
		КонецЦикла;
		Для Индекс = 0 По Документ.Состав.Количество() - 1 Цикл
			Если Документ.Состав[Индекс].Количество = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если Индекс = Последний Тогда
				Доля = СтоимостьДополнительных - Распределено;
			Иначе
				Доля = Окр(СтоимостьДополнительных * Документ.Состав[Индекс].Количество / ВсегоБлоков, 2);
				Распределено = Распределено + Доля;
			КонецЕсли;
			СтоимостьБлоков[Индекс] = СтоимостьБлоков[Индекс] + Доля;
		КонецЦикла;
	КонецЕсли;

	Для Индекс = 0 По Документ.Состав.Количество() - 1 Цикл
		Строка = Документ.Состав[Индекс];
		Если НЕ ЗначениеЗаполнено(Строка.СистемныйБлок) ИЛИ Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Движение = Документ.Движения.ОстаткиДеталей.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Документ.Дата;
		Движение.Подразделение = Документ.ПодразделениеПолучатель;
		Движение.Номенклатура = Строка.СистемныйБлок;
		Движение.Свойство = ПустоеСвойство();
		Движение.Партия = Документ.Ссылка;
		Движение.Количество = Строка.Количество;
		Движение.Стоимость = СтоимостьБлоков[Индекс];
	КонецЦикла;

КонецПроцедуры

Функция СуммаСтроки(Строка)

	Если Строка.Сумма <> 0 Тогда
		Возврат Строка.Сумма;
	КонецЕсли;
	Возврат Строка.Цена * Строка.Количество;

КонецФункции

Функция ПустоеСвойство()

	Возврат Справочники.СвойстваНоменклатуры.ПустаяСсылка();

КонецФункции

Функция НоваяТаблицаКлючей()

	Ключи = Новый ТаблицаЗначений;
	Ключи.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Ключи.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Ключи.Колонки.Добавить("Свойство", Новый ОписаниеТипов("СправочникСсылка.СвойстваНоменклатуры"));
	Возврат Ключи;

КонецФункции

Процедура ДобавитьКлюч(Ключи, Подразделение, Номенклатура, Свойство)

	Отбор = Новый Структура("Подразделение, Номенклатура, Свойство", Подразделение, Номенклатура, Свойство);
	Если Ключи.НайтиСтроки(Отбор).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	Строка = Ключи.Добавить();
	ЗаполнитьЗначенияСвойств(Строка, Отбор);

КонецПроцедуры

Функция НоваяТаблицаОстатков()

	Остатки = Новый ТаблицаЗначений;
	Остатки.Колонки.Добавить("Подразделение");
	Остатки.Колонки.Добавить("Номенклатура");
	Остатки.Колонки.Добавить("Свойство");
	Остатки.Колонки.Добавить("Партия");
	Остатки.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Остатки.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число"));
	Остатки.Колонки.Добавить("ДатаПартии", Новый ОписаниеТипов("Дата"));
	Возврат Остатки;

КонецФункции

Функция ОстаткиПоКлючам(Момент, Ключи)

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиДеталей");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.ИсточникДанных = Ключи;
	Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
	Элемент.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	Элемент.ИспользоватьИзИсточникаДанных("Свойство", "Свойство");
	Блокировка.Заблокировать();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("Подразделения", Ключи.ВыгрузитьКолонку("Подразделение"));
	Запрос.УстановитьПараметр("Номенклатура", Ключи.ВыгрузитьКолонку("Номенклатура"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Свойство КАК Свойство,
	|	Остатки.Партия КАК Партия,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	Остатки.СтоимостьОстаток КАК Стоимость,
	|	ЕСТЬNULL(Остатки.Партия.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПартии
	|ИЗ
	|	РегистрНакопления.ОстаткиДеталей.Остатки(
	|			&Момент,
	|			Подразделение В (&Подразделения)
	|				И Номенклатура В (&Номенклатура)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПолитикиПодразделений(Дата, Подразделения)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Подразделения", Подразделения);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Срез.Подразделение КАК Подразделение,
	|	Срез.Метод КАК Метод
	|ИЗ
	|	РегистрСведений.УчетныеПолитикиПодразделений.СрезПоследних(&Дата, Подразделение В (&Подразделения)) КАК Срез";
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Подразделение, Выборка.Метод);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Списать(Документ, Остатки, Переоцененные, Подразделение, Номенклатура, Свойство, Количество, Метод, Отказ)

	КлючПереоценки = Строка(Подразделение.УникальныйИдентификатор()) + "|" + Строка(Номенклатура.УникальныйИдентификатор()) + "|" + Строка(Свойство.УникальныйИдентификатор());
	Если Метод = Перечисления.УчетнаяПолитика.Средняя И Переоцененные.Получить(КлючПереоценки) = Неопределено Тогда
		ПереоценитьПоСредней(Документ, Остатки, Подразделение, Номенклатура, Свойство);
		Переоцененные.Вставить(КлючПереоценки, Истина);
	КонецЕсли;

	Порядок = ПартииКлюча(Остатки, Подразделение, Номенклатура, Свойство, Метод = Перечисления.УчетнаяПолитика.ЛИФО);
	Доступно = 0;
	Для Каждого Партия Из Порядок Цикл
		Доступно = Доступно + Партия.Значение.Количество;
	КонецЦикла;
	Если Доступно < Количество Тогда
		Отказ = Истина;
		Сообщить("Недостаточно остатка " + Номенклатура + " (" + Количество + " при остатке " + Доступно + ")");
		Возврат 0;
	КонецЕсли;

	Осталось = Количество;
	Себестоимость = 0;
	Для Каждого Партия Из Порядок Цикл
		Строка = Партия.Значение;
		Если Осталось <= 0 Тогда
			Прервать;
		КонецЕсли;
		Если Строка.Количество >= Осталось Тогда
			КоличествоПартии = Осталось;
			Если Строка.Количество = Осталось Тогда
				СуммаПартии = Строка.Стоимость;
			Иначе
				СуммаПартии = Окр(Строка.Стоимость * КоличествоПартии / Строка.Количество, 2);
			КонецЕсли;
		Иначе
			КоличествоПартии = Строка.Количество;
			СуммаПартии = Строка.Стоимость;
		КонецЕсли;
		Строка.Количество = Строка.Количество - КоличествоПартии;
		Строка.Стоимость = Строка.Стоимость - СуммаПартии;
		Осталось = Осталось - КоличествоПартии;
		Себестоимость = Себестоимость + СуммаПартии;
		Движение = Документ.Движения.ОстаткиДеталей.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Документ.Дата;
		Движение.Подразделение = Подразделение;
		Движение.Номенклатура = Номенклатура;
		Движение.Свойство = Свойство;
		Движение.Партия = Строка.Партия;
		Движение.Количество = КоличествоПартии;
		Движение.Стоимость = СуммаПартии;
	КонецЦикла;
	Возврат Себестоимость;

КонецФункции

Процедура ПереоценитьПоСредней(Документ, Остатки, Подразделение, Номенклатура, Свойство)

	Партии = ПартииКлюча(Остатки, Подразделение, Номенклатура, Свойство, Ложь);
	ВсегоКоличество = 0;
	ВсегоСтоимость = 0;
	Для Каждого Партия Из Партии Цикл
		ВсегоКоличество = ВсегоКоличество + Партия.Значение.Количество;
		ВсегоСтоимость = ВсегоСтоимость + Партия.Значение.Стоимость;
	КонецЦикла;
	Если ВсегоКоличество = 0 Тогда
		Возврат;
	КонецЕсли;
	Средняя = ВсегоСтоимость / ВсегоКоличество;
	Распределено = 0;
	Номер = 0;
	Для Каждого Партия Из Партии Цикл
		Строка = Партия.Значение;
		Номер = Номер + 1;
		Если Номер = Партии.Количество() Тогда
			НоваяСтоимость = ВсегоСтоимость - Распределено;
		Иначе
			НоваяСтоимость = Окр(Строка.Количество * Средняя, 2);
			Распределено = Распределено + НоваяСтоимость;
		КонецЕсли;
		Дельта = НоваяСтоимость - Строка.Стоимость;
		Строка.Стоимость = НоваяСтоимость;
		Если Дельта = 0 Тогда
			Продолжить;
		КонецЕсли;
		Движение = Документ.Движения.ОстаткиДеталей.Добавить();
		Движение.Период = Документ.Дата;
		Движение.Подразделение = Подразделение;
		Движение.Номенклатура = Номенклатура;
		Движение.Свойство = Свойство;
		Движение.Партия = Строка.Партия;
		Движение.Количество = 0;
		Если Дельта > 0 Тогда
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Стоимость = Дельта;
		Иначе
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Стоимость = -Дельта;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПартииКлюча(Остатки, Подразделение, Номенклатура, Свойство, Убывание)

	Список = Новый СписокЗначений;
	Для Каждого Строка Из Остатки Цикл
		Если Строка.Подразделение = Подразделение И Строка.Номенклатура = Номенклатура И Строка.Свойство = Свойство И Строка.Количество > 0 Тогда
			Список.Добавить(Строка, Формат(Строка.ДатаПартии, "ДФ=yyyyMMddHHmmss"));
		КонецЕсли;
	КонецЦикла;
	Если Убывание Тогда
		Список.СортироватьПоПредставлению(НаправлениеСортировки.Убыв);
	Иначе
		Список.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	КонецЕсли;
	Возврат Список;

КонецФункции

Функция НоваяПотребность()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Свойство");
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Распределение");
	Возврат Таблица;

КонецФункции

Процедура ДобавитьПотребность(Таблица, Номенклатура, Свойство, Количество, ИндексБлока, Дополнительная)

	Отбор = Новый Структура("Номенклатура, Свойство", Номенклатура, Свойство);
	Найденные = Таблица.НайтиСтроки(Отбор);
	Если Найденные.Количество() = 0 Тогда
		Строка = Таблица.Добавить();
		Строка.Номенклатура = Номенклатура;
		Строка.Свойство = Свойство;
		Строка.Количество = 0;
		Строка.Распределение = Новый ТаблицаЗначений;
		Строка.Распределение.Колонки.Добавить("ИндексБлока", Новый ОписаниеТипов("Число"));
		Строка.Распределение.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
		Строка.Распределение.Колонки.Добавить("Дополнительная", Новый ОписаниеТипов("Булево"));
	Иначе
		Строка = Найденные[0];
	КонецЕсли;
	Строка.Количество = Строка.Количество + Количество;
	Часть = Строка.Распределение.Добавить();
	Часть.ИндексБлока = ИндексБлока;
	Часть.Количество = Количество;
	Часть.Дополнительная = Дополнительная;

КонецПроцедуры

Процедура РаспределитьСтоимость(СтрокаПотребности, Себестоимость, СтоимостьБлоков, СтоимостьДополнительных)

	Если СтрокаПотребности.Количество = 0 Тогда
		Возврат;
	КонецЕсли;
	Распределено = 0;
	Последний = СтрокаПотребности.Распределение.Количество() - 1;
	Индекс = 0;
	Для Каждого Часть Из СтрокаПотребности.Распределение Цикл
		Если Индекс = Последний Тогда
			Доля = Себестоимость - Распределено;
		Иначе
			Доля = Окр(Себестоимость * Часть.Количество / СтрокаПотребности.Количество, 2);
			Распределено = Распределено + Доля;
		КонецЕсли;
		Если Часть.Дополнительная Тогда
			СтоимостьДополнительных = СтоимостьДополнительных + Доля;
		ИначеЕсли Часть.ИндексБлока >= 0 И Часть.ИндексБлока < СтоимостьБлоков.Количество() Тогда
			СтоимостьБлоков[Часть.ИндексБлока] = СтоимостьБлоков[Часть.ИндексБлока] + Доля;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

КонецПроцедуры

Функция СпецификацияБлока(Момент, СистемныйБлок)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("СистемныйБлок", СистемныйБлок);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Срез.Номенклатура КАК Номенклатура,
	|	Срез.Свойство КАК Свойство,
	|	Срез.Количество КАК Количество
	|ИЗ
	|	РегистрСведений.Спецификации.СрезПоследних(&Момент, СистемныйБлок = &СистемныйБлок) КАК Срез
	|ГДЕ
	|	Срез.Количество > 0";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции
