Функция ТекстПроверки()

	Строки = Новый Массив;
	Остаток("цех видео", "Основной цех", "Видеокарта", "Видеокарта ASUS", 1, 12000, Строки);
	Остаток("магазин блок", "Магазин", "Системный блок", "", 0, 0, Строки);
	Остаток("магазин принтер", "Магазин", "Принтер", "", 3, 6000, Строки);
	Остаток("лифо монитор", "Склад деталей", "Монитор", "", 3, 18000, Строки);
	Ведомость(Строки);
	ПродажиОУ(Строки);
	ПродажиБУ(Строки);
	Зарплата(Строки);
	Текст = СтрСоединить(Строки, Символы.ПС);
