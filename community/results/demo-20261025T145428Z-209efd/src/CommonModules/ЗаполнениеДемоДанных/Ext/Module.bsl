Функция ПараметрыПроверкиФормы() Экспорт

	Существующий = Справочники.Контрагенты.НайтиПоНаименованию("Проверка формы", Истина);
	Если ЗначениеЗаполнено(Существующий) Тогда
		Набор = РегистрыСведений.ЗначенияСведенийКонтрагентов.СоздатьНаборЗаписей();
		Набор.Отбор.Контрагент.Установить(Существующий);
		Набор.Записать();
		Существующий.ПолучитьОбъект().Удалить();
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Валюты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Валюты КАК Валюты
	|ГДЕ
	|	НЕ Валюты.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Валюта = Справочники.Валюты.ПустаяСсылка();
	Если Выборка.Следующий() Тогда
		Валюта = Выборка.Ссылка;
	КонецЕсли;
	Возврат Новый Структура("Менеджер, Валюта", Справочники.ФизическиеЛица.НайтиПоНаименованию("Иванов И.И.", Истина), Валюта);

