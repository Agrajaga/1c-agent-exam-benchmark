	СтрокаПринтер = Таблица.Найти(Принтер, "Номенклатура");
	СтрокаМонитор = Таблица.Найти(Монитор, "Номенклатура");
	Строки.Добавить(СверкаПродажи("оу блок", СтрокаБлок, 1, 32000, 50000));
	Строки.Добавить(СверкаПродажи("оу принтер", СтрокаПринтер, 1, 2000, 4000));
	Строки.Добавить(СверкаПродажи("оу монитор", СтрокаМонитор, 1, 8000, 9000));

