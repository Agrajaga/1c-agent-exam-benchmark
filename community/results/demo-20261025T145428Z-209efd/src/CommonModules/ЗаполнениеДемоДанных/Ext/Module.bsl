Функция ПроверитьСведенияФормы(Контрагент, Валюта, Срок) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Значения.Свойство.Наименование КАК Имя,
	|	Значения.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСведенийКонтрагентов КАК Значения
	|ГДЕ
	|	Значения.Контрагент = &Контрагент";
	ВалютаЗаписана = Ложь;
	СрокЗаписан = Ложь;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Имя = "Валюта кредита" И Выборка.Значение = Валюта Тогда
			ВалютаЗаписана = Истина;
		ИначеЕсли Выборка.Имя = "Срок кредита, дни" И Выборка.Значение = Срок Тогда
			СрокЗаписан = Истина;
		КонецЕсли;
	КонецЦикла;
	Если ВалютаЗаписана И СрокЗаписан Тогда
		Возврат "OK форма контрагента";
	КонецЕсли;
	Возврат "FAIL форма контрагента валюта=" + ВалютаЗаписана + " срок=" + СрокЗаписан;

