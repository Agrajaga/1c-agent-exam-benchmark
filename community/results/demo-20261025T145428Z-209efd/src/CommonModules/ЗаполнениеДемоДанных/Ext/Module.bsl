Процедура ЗаполнитьГрафик(Подразделение, Начало, Конец)

	Набор = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей();
	Набор.Отбор.Подразделение.Установить(Подразделение);
	Дат = НачалоДня(Начало);
	Пока Дат <= Конец Цикл
		Запись = Набор.Добавить();
		Запись.Подразделение = Подразделение;
		Запись.Дата = Дат;
		Если ДеньНедели(Дат) >= 6 Тогда
			Запись.Часы = 0;
			Запись.Дней = 0;
		Иначе
			Запись.Часы = 8;
			Запись.Дней = 1;
		КонецЕсли;
		Дат = Дат + 86400;
	КонецЦикла;
	Набор.Записать();

