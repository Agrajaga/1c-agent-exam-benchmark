КонецПроцедуры

Процедура Зарплата(Строки)

	Петров = Справочники.ФизическиеЛица.НайтиПоНаименованию("Петров П.П.", Истина);
	Иванов = Справочники.ФизическиеЛица.НайтиПоНаименованию("Иванов И.И.", Истина);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Тариф", ПланыВидовРасчета.ОсновныеНачисления.Тариф);
	Запрос.УстановитьПараметр("Премия", ПланыВидовРасчета.ОсновныеНачисления.Премия);
	Запрос.УстановитьПараметр("Командировка", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.Сотрудник.Наименование КАК Сотрудник,
	|	Начисления.ВидРасчета.Наименование КАК Вид,
	|	Начисления.Сторно КАК Сторно,
	|	СУММА(Начисления.Результат) КАК Результат
	|ИЗ
	|	РегистрРасчета.Начисления КАК Начисления
	|СГРУППИРОВАТЬ ПО
	|	Начисления.Сотрудник.Наименование,
	|	Начисления.ВидРасчета.Наименование,
	|	Начисления.Сторно";
	Выборка = Запрос.Выполнить().Выбрать();
	Факт = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Факт.Вставить(Выборка.Сотрудник + "|" + Выборка.Вид + "|" + Строка(Выборка.Сторно), Выборка.Результат);
		Строки.Добавить(Выборка.Сотрудник + " " + Выборка.Вид + " сторно=" + Строка(Выборка.Сторно) + " " + Выборка.Результат);
	КонецЦикла;
	Строки.Добавить(СверкаСуммы("тариф петров", 18400, Факт.Получить("Петров П.П.|Тариф|Нет")));
	Строки.Добавить(СверкаСуммы("сторно петров", -1600, Факт.Получить("Петров П.П.|Тариф|Да")));
	Строки.Добавить(СверкаСуммы("тариф иванов", 36800, Факт.Получить("Иванов И.И.|Тариф|Нет")));
	Строки.Добавить(СверкаСуммы("премия иванов", 2520, Факт.Получить("Иванов И.И.|Премия|Нет")));
	Строки.Добавить(СверкаСуммы("командировка иванов", 8547.83, Факт.Получить("Иванов И.И.|Командировка|Нет")));
	Премии = Отчеты.ПремииСотрудников.Сформировать(Дата(2014, 2, 1), Дата(2014, 2, 28));
	Найденная = Премии.Найти(Иванов, "Сотрудник");
	Если Найденная = Неопределено Тогда
		Строки.Добавить("FAIL премия отчет нет строки");
	Иначе
		Строки.Добавить(СверкаСуммы("отчет премия", 2520, Найденная.Сумма));
		Строки.Добавить(СверкаСуммы("отчет процент", 15, Найденная.Процент));
	КонецЕсли;
	Петров = Петров;

КонецПроцедуры

Функция Сверка(Имя, КоличествоПлан, КоличествоФакт, СуммаПлан, СуммаФакт)

	Если КоличествоПлан = КоличествоФакт И Модуль(СуммаПлан - СуммаФакт) < 0.02 Тогда
		Возврат "OK " + Имя + " " + КоличествоФакт + " / " + СуммаФакт;
	КонецЕсли;
	Возврат "FAIL " + Имя + " qty " + КоличествоФакт + " expected " + КоличествоПлан + " cost " + СуммаФакт + " expected " + СуммаПлан;

КонецФункции

Функция СверкаПродажи(Имя, Строка, Количество, Себестоимость, Продажа)

	Если Строка = Неопределено Тогда
		Возврат "FAIL " + Имя + " нет строки";
	КонецЕсли;
	Если Строка.Количество = Количество И Модуль(Строка.Себестоимость - Себестоимость) < 0.02 И Модуль(Строка.Продажа - Продажа) < 0.02 Тогда
		Возврат "OK " + Имя;
	КонецЕсли;
	Возврат "FAIL " + Имя + " " + Строка.Количество + " " + Строка.Себестоимость + " " + Строка.Продажа;

КонецФункции

Функция СверкаБУ(Имя, Таблица, Номенклатура, Продано, Количество, Себестоимость, Продажа)

	Найденные = Таблица.НайтиСтроки(Новый Структура("Номенклатура, Продано", Номенклатура, Продано));
	Если Найденные.Количество() = 0 Тогда
		Возврат "FAIL " + Имя + " нет строки";
	КонецЕсли;
	Строка = Найденные[0];
	Если Строка.Количество = Количество И Модуль(Строка.Себестоимость - Себестоимость) < 0.02 И Модуль(Строка.Продажа - Продажа) < 0.02 Тогда
		Возврат "OK " + Имя;
	КонецЕсли;
	Возврат "FAIL " + Имя + " " + Строка.Количество + " " + Строка.Себестоимость + " " + Строка.Продажа;

КонецФункции

Функция СверкаСуммы(Имя, План, Факт)

	Если Факт = Неопределено Тогда
		Возврат "FAIL " + Имя + " нет значения, expected " + План;
	КонецЕсли;
	Если Модуль(План - Факт) < 0.02 Тогда
		Возврат "OK " + Имя + " " + Факт;
	КонецЕсли;
	Возврат "FAIL " + Имя + " " + Факт + " expected " + План;

КонецФункции

Функция Модуль(Число)

	Возврат ?(Число < 0, -Число, Число);

КонецФункции
