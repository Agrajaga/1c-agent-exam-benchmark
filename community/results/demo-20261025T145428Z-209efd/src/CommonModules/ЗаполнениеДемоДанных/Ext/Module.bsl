Процедура Остаток(Имя, ПодразделениеИмя, НоменклатураИмя, СвойствоИмя, Количество, Стоимость, Строки)

	Подразделение = Справочники.Подразделения.НайтиПоНаименованию(ПодразделениеИмя, Истина);
	Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(НоменклатураИмя, Истина);
	Если ЗначениеЗаполнено(СвойствоИмя) Тогда
		Свойство = Справочники.СвойстваНоменклатуры.НайтиПоНаименованию(СвойствоИмя, Истина);
	Иначе
		Свойство = Справочники.СвойстваНоменклатуры.ПустаяСсылка();
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК Количество,
	|	ЕСТЬNULL(СУММА(Остатки.СтоимостьОстаток), 0) КАК Стоимость
	|ИЗ
	|	РегистрНакопления.ОстаткиДеталей.Остатки(
	|			,
	|			Подразделение = &Подразделение
	|				И Номенклатура = &Номенклатура
	|				И Свойство = &Свойство) КАК Остатки";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Строки.Добавить(Сверка(Имя, Количество, Выборка.Количество, Стоимость, Выборка.Стоимость));

КонецПроцедуры

Процедура Ведомость(Строки)

	Цех = Справочники.Подразделения.НайтиПоНаименованию("Основной цех", Истина);
	Таблица = Отчеты.ВедомостьПоПодразделению.Сформировать(Дата(2014, 1, 1), Дата(2014, 3, 31), Цех);
	Видео = Справочники.Номенклатура.НайтиПоНаименованию("Видеокарта", Истина);
	Найденная = Неопределено;
	Для Каждого Строка Из Таблица Цикл
		Если Строка.Номенклатура = Видео Тогда
			Найденная = Строка;
		КонецЕсли;
	КонецЦикла;
	Если Найденная = Неопределено Тогда
		Строки.Добавить("FAIL ведомость нет видео");
		Возврат;
	КонецЕсли;
	Строки.Добавить(Сверка("ведомость видео", 1, Найденная.КонечныйОстатокКоличество, 12000, Найденная.КонечныйОстаток));
	Строки.Добавить(Сверка("ведомость приход", 4, Найденная.ПриходКоличество, 44000, Найденная.Приход));
	Строки.Добавить(Сверка("ведомость расход", 3, Найденная.РасходКоличество, 32000, Найденная.Расход));
	Если Найденная.Характеристика = "ASUS" Тогда
		Строки.Добавить("OK характеристика");
	Иначе
		Строки.Добавить("FAIL характеристика " + Найденная.Характеристика);
	КонецЕсли;

	Магазин = Справочники.Подразделения.НайтиПоНаименованию("Магазин", Истина);
	ТаблицаМагазина = Отчеты.ВедомостьПоПодразделению.Сформировать(Дата(2014, 1, 1), Дата(2014, 3, 31), Магазин);
	Принтер = Справочники.Номенклатура.НайтиПоНаименованию("Принтер", Истина);
	СтрокаПринтера = Неопределено;
	Для Каждого Строка Из ТаблицаМагазина Цикл
		Если Строка.Номенклатура = Принтер Тогда
			СтрокаПринтера = Строка;
		КонецЕсли;
	КонецЦикла;
	Если СтрокаПринтера = Неопределено Тогда
		Строки.Добавить("FAIL ведомость нет принтера");
	Иначе
		Строки.Добавить(Сверка("ведомость средняя", 3, СтрокаПринтера.КонечныйОстатокКоличество, 6000, СтрокаПринтера.КонечныйОстаток));
		Строки.Добавить(Сверка("ведомость средняя приход", 4, СтрокаПринтера.ПриходКоличество, 8000, СтрокаПринтера.Приход));
		Строки.Добавить(Сверка("ведомость средняя расход", 1, СтрокаПринтера.РасходКоличество, 2000, СтрокаПринтера.Расход));
	КонецЕсли;

КонецПроцедуры

Процедура ПродажиОУ(Строки)

	Таблица = Отчеты.ПродажиОперативные.Сформировать(Дата(2014, 1, 1), Дата(2014, 3, 31));
	Блок = Справочники.Номенклатура.НайтиПоНаименованию("Системный блок", Истина);
	Принтер = Справочники.Номенклатура.НайтиПоНаименованию("Принтер", Истина);
