Функция ДиагностикаРегистра()

	Текст = "";
	Для Каждого Ресурс Из Метаданные.РегистрыБухгалтерии.Управленческий.Ресурсы Цикл
		Текст = Текст + "resource " + Ресурс.Имя + " balance=" + Строка(Ресурс.Балансовый);
		Если Ресурс.ПризнакУчета <> Неопределено Тогда
			Текст = Текст + " flag=" + Ресурс.ПризнакУчета.Имя;
		КонецЕсли;
		Текст = Текст + Символы.ПС;
	КонецЦикла;
	Для Каждого Признак Из Метаданные.ПланыСчетов.Управленческий.ПризнакиУчета Цикл
		Текст = Текст + "account flag " + Признак.Имя + Символы.ПС;
	КонецЦикла;
	Счет = ПланыСчетов.Управленческий.Товары;
	Текст = Текст + "goods quantitative=" + Строка(Счет.Количественный) + Символы.ПС;
	Запись = РегистрыБухгалтерии.Управленческий.СоздатьНаборЗаписей().Добавить();
	Для Каждого ИмяПоля Из СтрРазделить("КоличествоДт,КоличествоКт,Количество,Сумма,СуммаДт,СуммаКт", ",") Цикл
		Попытка
			Запись[ИмяПоля] = 1;
			Текст = Текст + ИмяПоля + " = ok" + Символы.ПС;
		Исключение
			Текст = Текст + ИмяПоля + " = no" + Символы.ПС;
		КонецПопытки;
	КонецЦикла;
	Возврат Текст;

