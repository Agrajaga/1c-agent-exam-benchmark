Процедура ПровестиПриход(Документ, Отказ) Экспорт

	Если НЕ ЗначениеЗаполнено(Документ.Склад) Тогда
		Возврат;
	КонецЕсли;

	ЗаблокироватьТовары();
	Товары = ПланыСчетов.Управленческий.Товары;
	Поставщики = ПланыСчетов.Управленческий.Поставщики;
	Для Каждого Строка Из Документ.СписокНоменклатуры Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) ИЛИ Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Движение = Документ.Движения.Управленческий.Добавить();
		Движение.Период = Документ.Дата;
		Движение.СчетДт = Товары;
		Движение.СчетКт = Поставщики;
		Движение.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Строка.Номенклатура;
		Движение.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Документ.Склад;
		Если ЗначениеЗаполнено(Документ.Контрагент) Тогда
			Движение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Контрагенты] = Документ.Контрагент;
		КонецЕсли;
		Движение.Количество = Строка.Количество;
		Движение.Сумма = СуммаСтроки(Строка);
	КонецЦикла;

КонецПроцедуры

Процедура ПровестиРасход(Документ, Отказ) Экспорт

	Если НЕ ЗначениеЗаполнено(Документ.Склад) Тогда
		Возврат;
	КонецЕсли;

	ЗаблокироватьТовары();
	Граф = ПарыАналогов();
	Кандидаты = КандидатыСписания(Документ, Граф);
	Остатки = ОстаткиТоваров(Документ.МоментВремени(), Документ.Склад, Кандидаты);
	Товары = ПланыСчетов.Управленческий.Товары;
	Прибыль = ПланыСчетов.Управленческий.ПрибылиУбытки;
	Покупатели = ПланыСчетов.Управленческий.Покупатели;

	Для Каждого Строка Из Документ.СписокНоменклатуры Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) ИЛИ Строка.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Порции = Новый Массив;
		Осталось = Строка.Количество;
		Для Каждого Кандидат Из АналогиПоПорядку(Строка.Номенклатура, Граф) Цикл
			Если Осталось <= 0 Тогда
				Прервать;
			КонецЕсли;
			Найденные = Остатки.НайтиСтроки(Новый Структура("Номенклатура", Кандидат));
			Если Найденные.Количество() = 0 ИЛИ Найденные[0].Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Остаток = Найденные[0];
			КоличествоПорции = Мин(Осталось, Остаток.Количество);
			Если КоличествоПорции = Остаток.Количество Тогда
				СуммаПорции = Остаток.Сумма;
			Иначе
				СуммаПорции = Окр(Остаток.Сумма * КоличествоПорции / Остаток.Количество, 2);
			КонецЕсли;
			Остаток.Количество = Остаток.Количество - КоличествоПорции;
			Остаток.Сумма = Остаток.Сумма - СуммаПорции;
			Осталось = Осталось - КоличествоПорции;
			Порции.Добавить(Новый Структура("Номенклатура, Количество, Сумма", Кандидат, КоличествоПорции, СуммаПорции));
		КонецЦикла;
		Если Осталось > 0 Тогда
			Отказ = Истина;
			Сообщить("Недостаточно товара и аналогов: " + Строка.Номенклатура);
			Возврат;
		КонецЕсли;

		СуммаПродажи = СуммаСтроки(Строка);
		Распределено = 0;
		Для Индекс = 0 По Порции.Количество() - 1 Цикл
			Порция = Порции[Индекс];
			Если Индекс = Порции.Количество() - 1 Тогда
				Выручка = СуммаПродажи - Распределено;
			Иначе
				Выручка = Окр(СуммаПродажи * Порция.Количество / Строка.Количество, 2);
				Распределено = Распределено + Выручка;
			КонецЕсли;

			Себестоимость = Документ.Движения.Управленческий.Добавить();
			Себестоимость.Период = Документ.Дата;
			Себестоимость.СчетДт = Прибыль;
			Себестоимость.СчетКт = Товары;
			Себестоимость.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Строка.Номенклатура;
			Себестоимость.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Продано] = Порция.Номенклатура;
			Себестоимость.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Порция.Номенклатура;
			Себестоимость.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Документ.Склад;
			Себестоимость.Количество = Порция.Количество;
			Себестоимость.Сумма = Порция.Сумма;

			ВыручкаДвижение = Документ.Движения.Управленческий.Добавить();
			ВыручкаДвижение.Период = Документ.Дата;
			ВыручкаДвижение.СчетДт = Покупатели;
			ВыручкаДвижение.СчетКт = Прибыль;
			Если ЗначениеЗаполнено(Документ.Контрагент) Тогда
				ВыручкаДвижение.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Контрагенты] = Документ.Контрагент;
			КонецЕсли;
			ВыручкаДвижение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Строка.Номенклатура;
			ВыручкаДвижение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Продано] = Порция.Номенклатура;
			ВыручкаДвижение.Сумма = Выручка;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ПровестиОперацию(Документ, Отказ) Экспорт

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрБухгалтерии.Управленческий");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

	Для Каждого Строка Из Документ.Проводки Цикл
		Если НЕ ЗначениеЗаполнено(Строка.СчетДт) ИЛИ НЕ ЗначениеЗаполнено(Строка.СчетКт) Тогда
			Продолжить;
		КонецЕсли;
		Движение = Документ.Движения.Управленческий.Добавить();
		Движение.Период = Документ.Дата;
		Движение.СчетДт = Строка.СчетДт;
		Движение.СчетКт = Строка.СчетКт;
		ЗаполнитьСубконто(Движение, "Дт", Строка.СчетДт, Строка.СубконтоДт1, Строка.СубконтоДт2, Строка.СубконтоДт3);
		ЗаполнитьСубконто(Движение, "Кт", Строка.СчетКт, Строка.СубконтоКт1, Строка.СубконтоКт2, Строка.СубконтоКт3);
		Если Строка.Количество <> 0 И (Строка.СчетДт.Количественный ИЛИ Строка.СчетКт.Количественный) Тогда
			Движение.Количество = Строка.Количество;
		КонецЕсли;
		Движение.Сумма = Строка.Сумма;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаблокироватьТовары()

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрБухгалтерии.Управленческий");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Счет", ПланыСчетов.Управленческий.Товары);
	Блокировка.Заблокировать();

КонецПроцедуры

Функция СуммаСтроки(Строка)

	Если Строка.Сумма <> 0 Тогда
		Возврат Строка.Сумма;
	КонецЕсли;
	Возврат Строка.Цена * Строка.Количество;

КонецФункции

Функция КандидатыСписания(Документ, Граф)

	Список = Новый Массив;
	Для Каждого Строка Из Документ.СписокНоменклатуры Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Кандидат Из АналогиПоПорядку(Строка.Номенклатура, Граф) Цикл
			Если Список.Найти(Кандидат) = Неопределено Тогда
				Список.Добавить(Кандидат);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Список;

КонецФункции

Функция АналогиПоПорядку(Номенклатура, Граф)

	Компонента = КомпонентаАналогов(Номенклатура, Граф);
	Прочие = Новый СписокЗначений;
	Для Каждого Элемент Из Компонента Цикл
		Если Элемент <> Номенклатура Тогда
			Прочие.Добавить(Элемент, Элемент.Артикул);
		КонецЕсли;
	КонецЦикла;
	Прочие.СортироватьПоПредставлению(НаправлениеСортировки.Возр);
	Результат = Новый Массив;
	Результат.Добавить(Номенклатура);
	Для Каждого Элемент Из Прочие Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КомпонентаАналогов(Номенклатура, Граф)

	Посещенные = Новый Соответствие;
	Очередь = Новый Массив;
	Очередь.Добавить(Номенклатура);
	Посещенные.Вставить(Номенклатура, Истина);
	Индекс = 0;
	Пока Индекс < Очередь.Количество() Цикл
		Текущий = Очередь[Индекс];
		Индекс = Индекс + 1;
		Соседи = Граф.Получить(Текущий);
		Если Соседи = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Сосед Из Соседи Цикл
			Если Посещенные.Получить(Сосед) = Неопределено Тогда
				Посещенные.Вставить(Сосед, Истина);
				Очередь.Добавить(Сосед);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Очередь;

КонецФункции

Функция ПарыАналогов()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Аналоги.Номенклатура КАК Номенклатура,
	|	Аналоги.Аналог КАК Аналог
	|ИЗ
	|	РегистрСведений.АналогиНоменклатуры КАК Аналоги";
	Граф = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьРебро(Граф, Выборка.Номенклатура, Выборка.Аналог);
		ДобавитьРебро(Граф, Выборка.Аналог, Выборка.Номенклатура);
	КонецЦикла;
	Возврат Граф;

КонецФункции

Процедура ДобавитьРебро(Граф, Левый, Правый)

	Соседи = Граф.Получить(Левый);
	Если Соседи = Неопределено Тогда
		Соседи = Новый Массив;
		Граф.Вставить(Левый, Соседи);
	КонецЕсли;
	Если Соседи.Найти(Правый) = Неопределено Тогда
		Соседи.Добавить(Правый);
	КонецЕсли;

КонецПроцедуры

Функция ОстаткиТоваров(Момент, Склад, Номенклатура)

	Виды = Новый Массив;
	Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склады);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары);
	Запрос.УстановитьПараметр("Виды", Виды);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Субконто1 КАК Номенклатура,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	Остатки.СуммаОстаток КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.Управленческий.Остатки(
	|			&Момент,
	|			Счет = &Счет,
	|			&Виды,
	|			Субконто1 В (&Номенклатура)
	|				И Субконто2 = &Склад) КАК Остатки";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ЗаполнитьСубконто(Движение, Сторона, Счет, Значение1, Значение2, Значение3)

	Значения = Новый Массив;
	Значения.Добавить(Значение1);
	Значения.Добавить(Значение2);
	Значения.Добавить(Значение3);
	Индекс = 0;
	Для Каждого Вид Из Счет.ВидыСубконто Цикл
		Если Индекс > 2 Тогда
			Прервать;
		КонецЕсли;
		Значение = Значения[Индекс];
		Индекс = Индекс + 1;
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Если Сторона = "Дт" Тогда
			Движение.СубконтоДт[Вид.ВидСубконто] = Значение;
		Иначе
			Движение.СубконтоКт[Вид.ВидСубконто] = Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
