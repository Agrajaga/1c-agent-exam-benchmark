Процедура Рассчитать(Документ, Отказ) Экспорт

	ОбеспечитьЗависимости();
	Набор = Документ.Движения.Начисления;
	Набор.Записывать = Истина;
	Набор.Очистить();
	ЗаполнитьДвижения(Документ, Набор);
	Если Набор.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрРасчета.Начисления");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

	Набор.Записать();
	Набор.Записать();
	ДобавитьСторно(Набор);
	Набор.Записать();
	Набор.Прочитать();

	График = ГрафикРегистратора(Документ.Ссылка);
	Ставки = ВсеСтавки();
	Сотрудники = ДанныеСотрудников();
	Шкала = ШкалаПремий();

	РассчитатьТариф(Набор, График, Ставки);
	Набор.Записать();
	РассчитатьСторно(Набор, График, ПланыВидовРасчета.ОсновныеНачисления.Тариф, "Часы");
	Набор.Записать();
	РассчитатьПремии(Набор, График, Сотрудники, Шкала);
	Набор.Записать();
	РассчитатьСторно(Набор, График, ПланыВидовРасчета.ОсновныеНачисления.Премия, "Часы");
	Набор.Записать();
	РассчитатьКомандировки(Набор, График);
	Набор.Записать();
	РассчитатьСторно(Набор, График, ПланыВидовРасчета.ОсновныеНачисления.Командировка, "Дни");
	Набор.Записать();

КонецПроцедуры

Процедура ОбеспечитьЗависимости()

	ТарифСсылка = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
	ПремияСсылка = ПланыВидовРасчета.ОсновныеНачисления.Премия;
	КомандировкаСсылка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;

	Командировка = КомандировкаСсылка.ПолучитьОбъект();
	Командировка.ВытесняющиеВидыРасчета.Очистить();
	Командировка.БазовыеВидыРасчета.Очистить();
	Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = ТарифСсылка;
	Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = ПремияСсылка;
	Командировка.Записать();

	Тариф = ТарифСсылка.ПолучитьОбъект();
	Тариф.ВытесняющиеВидыРасчета.Очистить();
	Тариф.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = КомандировкаСсылка;
	Тариф.БазовыеВидыРасчета.Очистить();
	Тариф.Записать();

	Премия = ПремияСсылка.ПолучитьОбъект();
	Премия.ВытесняющиеВидыРасчета.Очистить();
	Премия.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = КомандировкаСсылка;
	Премия.БазовыеВидыРасчета.Очистить();
	Премия.БазовыеВидыРасчета.Добавить().ВидРасчета = ТарифСсылка;
	Премия.Записать();

КонецПроцедуры

Процедура ЗаполнитьДвижения(Документ, Набор)

	Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
	Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия;
	Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
	Для Каждого Строка Из Документ.ОсновныеНачисления Цикл
		Если ТипЗнч(Строка.ВидРасчета) <> Тип("ПланВидовРасчетаСсылка.ОсновныеНачисления") Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Строка.Сотрудник) ИЛИ НЕ ЗначениеЗаполнено(Строка.Подразделение) Тогда
			Продолжить;
		КонецЕсли;
		Если Строка.ВидРасчета = Командировка Тогда
			Фрагменты = РазбитьПоМесяцам(Строка.ДатаНачала, Строка.ДатаОкончания);
		Иначе
			Фрагменты = Новый Массив;
			Фрагменты.Добавить(Новый Структура("Начало, Конец, Регистрация", Строка.ДатаНачала, Строка.ДатаОкончания, НачалоМесяца(Строка.ДатаНачала)));
		КонецЕсли;
		Для Каждого Фрагмент Из Фрагменты Цикл
			Движение = Набор.Добавить();
			Регистрация = Фрагмент.Регистрация;
			Если Строка.ВидРасчета = Командировка И НачалоМесяца(Документ.Дата) > Регистрация Тогда
				Регистрация = НачалоМесяца(Документ.Дата);
			КонецЕсли;
			Движение.ПериодРегистрации = Регистрация;
			Движение.ПериодДействияНачало = НачалоДня(Фрагмент.Начало);
			Движение.ПериодДействияКонец = КонецДня(Фрагмент.Конец);
			Движение.ВидРасчета = Строка.ВидРасчета;
			Движение.Сотрудник = Строка.Сотрудник;
			Движение.Подразделение = Строка.Подразделение;
			Движение.Сторно = Ложь;
			Если Строка.ВидРасчета = Премия Тогда
				Движение.БазовыйПериодНачало = НачалоМесяца(ДобавитьМесяц(Фрагмент.Регистрация, -1));
				Движение.БазовыйПериодКонец = КонецМесяца(Движение.БазовыйПериодНачало);
			ИначеЕсли Строка.ВидРасчета = Командировка Тогда
				МесяцНачала = НачалоМесяца(Строка.ДатаНачала);
				Движение.БазовыйПериодНачало = ДобавитьМесяц(МесяцНачала, -3);
				Движение.БазовыйПериодКонец = КонецМесяца(ДобавитьМесяц(МесяцНачала, -1));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция РазбитьПоМесяцам(Начало, Конец)

	Результат = Новый Массив;
	Месяц = НачалоМесяца(Начало);
	Пока Месяц <= Конец Цикл
		Фрагмент = Новый Структура("Начало, Конец, Регистрация");
		Фрагмент.Начало = Макс(Начало, Месяц);
		Фрагмент.Конец = Мин(Конец, НачалоДня(КонецМесяца(Месяц)));
		Фрагмент.Регистрация = Месяц;
		Результат.Добавить(Фрагмент);
		Месяц = ДобавитьМесяц(Месяц, 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьСторно(Набор)

	Таблица = Набор.ПолучитьДополнение();
	Для Каждого Строка Из Таблица Цикл
		Движение = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, Строка);
		Движение.ПериодРегистрации = Строка.ПериодРегистрацииСторно;
		Движение.ПериодДействияНачало = Строка.ПериодДействияНачалоСторно;
		Движение.ПериодДействияКонец = Строка.ПериодДействияКонецСторно;
		Движение.Сторно = Истина;
	КонецЦикла;

КонецПроцедуры

Функция ГрафикРегистратора(Регистратор)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеГрафика.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(ДанныеГрафика.ЧасыФактическийПериодДействия, 0) КАК Часы,
	|	ЕСТЬNULL(ДанныеГрафика.ЧасыПериодДействия, 0) КАК ЧасыПлан,
	|	ЕСТЬNULL(ДанныеГрафика.ДнейФактическийПериодДействия, 0) КАК Дней
	|ИЗ
	|	РегистрРасчета.Начисления.ДанныеГрафика(Регистратор = &Регистратор) КАК ДанныеГрафика";
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.НомерСтроки, Новый Структура("Часы, ЧасыПлан, Дней", Выборка.Часы, Выборка.ЧасыПлан, Выборка.Дней));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПоказателиСтроки(График, НомерСтроки)

	Значение = График.Получить(НомерСтроки);
	Если Значение = Неопределено Тогда
		Возврат Новый Структура("Часы, ЧасыПлан, Дней", 0, 0, 0);
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ВсеСтавки()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ставки.Сотрудник КАК Сотрудник,
	|	Ставки.Период КАК Период,
	|	Ставки.Ставка КАК Ставка
	|ИЗ
	|	РегистрСведений.ТарифныеСтавки КАК Ставки
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция СтавкаНаДату(Ставки, Сотрудник, Дата)

	Результат = 0;
	Для Каждого Строка Из Ставки Цикл
		Если Строка.Сотрудник = Сотрудник И Строка.Период <= Дата И Строка.Ставка <> 0 Тогда
			Результат = Строка.Ставка;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДанныеСотрудников()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.ДатаПриема КАК ДатаПриема,
	|	Сотрудники.НачальныйСтаж КАК НачальныйСтаж
	|ИЗ
	|	Справочник.ФизическиеЛица КАК Сотрудники";
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Сотрудник, Новый Структура("ДатаПриема, НачальныйСтаж", Выборка.ДатаПриема, Выборка.НачальныйСтаж));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ШкалаПремий()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Шкала.Порог КАК Порог,
	|	Шкала.Процент КАК Процент
	|ИЗ
	|	РегистрСведений.ШкалаПремий КАК Шкала
	|УПОРЯДОЧИТЬ ПО
	|	Порог";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция СтажЛет(Сотрудники, Сотрудник, НаДату)

	Данные = Сотрудники.Получить(Сотрудник);
	Начальный = 0;
	Месяцев = 0;
	Если Данные <> Неопределено Тогда
		Начальный = Данные.НачальныйСтаж;
		Если ЗначениеЗаполнено(Данные.ДатаПриема) И Данные.ДатаПриема < НаДату Тогда
			Месяцев = (Год(НаДату) - Год(Данные.ДатаПриема)) * 12 + Месяц(НаДату) - Месяц(Данные.ДатаПриема);
			Если День(НаДату) < День(Данные.ДатаПриема) Тогда
				Месяцев = Месяцев - 1;
			КонецЕсли;
			Если Месяцев < 0 Тогда
				Месяцев = 0;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Начальный + Месяцев / 12;

КонецФункции

Функция ПроцентПоСтажу(Шкала, Стаж)

	Процент = 0;
	Для Каждого Строка Из Шкала Цикл
		Если Строка.Порог <= Стаж Тогда
			Процент = Строка.Процент;
		КонецЕсли;
	КонецЦикла;
	Возврат Процент;

КонецФункции

Процедура РассчитатьТариф(Набор, График, Ставки)

	Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
	Для Каждого Движение Из Набор Цикл
		Если Движение.Сторно ИЛИ Движение.ВидРасчета <> Тариф Тогда
			Продолжить;
		КонецЕсли;
		Показатели = ПоказателиСтроки(График, Движение.НомерСтроки);
		Ставка = СтавкаНаДату(Ставки, Движение.Сотрудник, Движение.ПериодРегистрации);
		Движение.Ставка = Ставка;
		Движение.ОтработаноЧасов = Показатели.Часы;
		Движение.ОтработаноДней = Показатели.Дней;
		Движение.Результат = Окр(Ставка * Показатели.Часы, 2);
	КонецЦикла;

КонецПроцедуры

Процедура РассчитатьПремии(Набор, График, Сотрудники, Шкала)

	Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия;
	ЕстьПремия = Ложь;
	Для Каждого Движение Из Набор Цикл
		Если НЕ Движение.Сторно И Движение.ВидРасчета = Премия Тогда
			ЕстьПремия = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЕстьПремия Тогда
		Возврат;
	КонецЕсли;

	База = БазаПремий(Набор.Отбор.Регистратор.Значение);
	Для Каждого Движение Из Набор Цикл
		Если Движение.Сторно ИЛИ Движение.ВидРасчета <> Премия Тогда
			Продолжить;
		КонецЕсли;
		Показатели = ПоказателиСтроки(График, Движение.НомерСтроки);
		Коэффициент = 0;
		Если Показатели.ЧасыПлан > 0 Тогда
			Коэффициент = Показатели.Часы / Показатели.ЧасыПлан;
		ИначеЕсли Показатели.Часы = 0 И Показатели.ЧасыПлан = 0 Тогда
			Коэффициент = 1;
		КонецЕсли;
		Стаж = СтажЛет(Сотрудники, Движение.Сотрудник, Движение.ПериодРегистрации);
		Процент = ПроцентПоСтажу(Шкала, Стаж);
		СтрокаБазы = База.Найти(Движение.НомерСтроки, "НомерСтроки");
		БазаПодразделения = 0;
		БазаСвоя = 0;
		Если СтрокаБазы <> Неопределено Тогда
			БазаПодразделения = СтрокаБазы.БазаПодразделения;
			БазаСвоя = СтрокаБазы.БазаСвоя;
		КонецЕсли;
		Движение.Стаж = Стаж;
		Движение.ПроцентПремии = Процент;
		Движение.ОтработаноЧасов = Показатели.Часы;
		Движение.ОтработаноДней = Показатели.Дней;
		Движение.Результат = Окр((БазаПодразделения - БазаСвоя) * Процент / 100 * Коэффициент, 2);
	КонецЦикла;

КонецПроцедуры

Функция БазаПремий(Регистратор)

	ИзмерениеПодразделение = Новый Массив;
	ИзмерениеПодразделение.Добавить("Подразделение");
	Оба = Новый Массив;
	Оба.Добавить("Сотрудник");
	Оба.Добавить("Подразделение");
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("Премия", ПланыВидовРасчета.ОсновныеНачисления.Премия);
	Запрос.УстановитьПараметр("ИзмПодр", ИзмерениеПодразделение);
	Запрос.УстановитьПараметр("ИзмОба", Оба);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(БазаПодразделения.РезультатБаза, 0) КАК БазаПодразделения,
	|	ЕСТЬNULL(БазаСвоя.РезультатБаза, 0) КАК БазаСвоя
	|ИЗ
	|	РегистрРасчета.Начисления КАК Начисления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.Начисления.БазаНачисления(
	|				&ИзмПодр,
	|				&ИзмПодр,
	|				,
	|				Регистратор = &Регистратор
	|					И ВидРасчета = &Премия
	|					И НЕ Сторно) КАК БазаПодразделения
	|		ПО Начисления.НомерСтроки = БазаПодразделения.НомерСтроки
	|			И Начисления.Регистратор = БазаПодразделения.Регистратор
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.Начисления.БазаНачисления(
	|				&ИзмОба,
	|				&ИзмОба,
	|				,
	|				Регистратор = &Регистратор
	|					И ВидРасчета = &Премия
	|					И НЕ Сторно) КАК БазаСвоя
	|		ПО Начисления.НомерСтроки = БазаСвоя.НомерСтроки
	|			И Начисления.Регистратор = БазаСвоя.Регистратор
	|ГДЕ
	|	Начисления.Регистратор = &Регистратор
	|	И Начисления.ВидРасчета = &Премия
	|	И НЕ Начисления.Сторно";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура РассчитатьКомандировки(Набор, График)

	Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
	Есть = Ложь;
	Для Каждого Движение Из Набор Цикл
		Если НЕ Движение.Сторно И Движение.ВидРасчета = Командировка Тогда
			Есть = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ Есть Тогда
		Возврат;
	КонецЕсли;

	База = БазаКомандировок(Набор.Отбор.Регистратор.Значение);
	Отработано = ОтработанныеДниТарифа();
	Для Каждого Движение Из Набор Цикл
		Если Движение.Сторно ИЛИ Движение.ВидРасчета <> Командировка Тогда
			Продолжить;
		КонецЕсли;
		Показатели = ПоказателиСтроки(График, Движение.НомерСтроки);
		СтрокаБазы = База.Найти(Движение.НомерСтроки, "НомерСтроки");
		СуммаБазы = 0;
		Если СтрокаБазы <> Неопределено Тогда
			СуммаБазы = СтрокаБазы.База;
		КонецЕсли;
		Дней = ОтработанныеДниСотрудника(Отработано, Движение.Сотрудник, Движение.БазовыйПериодНачало, Движение.БазовыйПериодКонец);
		Движение.ОтработаноДней = Показатели.Дней;
		Если Дней = 0 Тогда
			Движение.Результат = 0;
		Иначе
			Движение.Результат = Окр(СуммаБазы / Дней * Показатели.Дней, 2);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция БазаКомандировок(Регистратор)

	Измерение = Новый Массив;
	Измерение.Добавить("Сотрудник");
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("Командировка", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
	Запрос.УстановитьПараметр("Изм", Измерение);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(База.РезультатБаза, 0) КАК База
	|ИЗ
	|	РегистрРасчета.Начисления КАК Начисления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.Начисления.БазаНачисления(
	|				&Изм,
	|				&Изм,
	|				,
	|				Регистратор = &Регистратор
	|					И ВидРасчета = &Командировка
	|					И НЕ Сторно) КАК База
	|		ПО Начисления.НомерСтроки = База.НомерСтроки
	|			И Начисления.Регистратор = База.Регистратор
	|ГДЕ
	|	Начисления.Регистратор = &Регистратор
	|	И Начисления.ВидРасчета = &Командировка
	|	И НЕ Начисления.Сторно";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ОтработанныеДниТарифа()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Тариф", ПланыВидовРасчета.ОсновныеНачисления.Тариф);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеГрафика.Сотрудник КАК Сотрудник,
	|	ДанныеГрафика.ПериодДействияНачало КАК ПериодДействияНачало,
	|	ДанныеГрафика.ПериодДействияКонец КАК ПериодДействияКонец,
	|	ЕСТЬNULL(ДанныеГрафика.ДнейФактическийПериодДействия, 0) КАК Дней
	|ИЗ
	|	РегистрРасчета.Начисления.ДанныеГрафика(ВидРасчета = &Тариф И НЕ Сторно) КАК ДанныеГрафика";
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ОтработанныеДниСотрудника(Таблица, Сотрудник, Начало, Конец)

	Дней = 0;
	Для Каждого Строка Из Таблица Цикл
		Если Строка.Сотрудник <> Сотрудник Тогда
			Продолжить;
		КонецЕсли;
		Если Строка.ПериодДействияНачало <= Конец И Строка.ПериодДействияКонец >= Начало Тогда
			Дней = Дней + Строка.Дней;
		КонецЕсли;
	КонецЦикла;
	Возврат Дней;

КонецФункции

Процедура РассчитатьСторно(Набор, График, ВидРасчета, Мера)

	Есть = Ложь;
	Для Каждого Движение Из Набор Цикл
		Если Движение.Сторно И Движение.ВидРасчета = ВидРасчета Тогда
			Есть = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ Есть Тогда
		Возврат;
	КонецЕсли;

	Исходные = ИсходныеНачисления(ВидРасчета, Набор.Отбор.Регистратор.Значение);
	Для Каждого Движение Из Набор Цикл
		Если НЕ Движение.Сторно ИЛИ Движение.ВидРасчета <> ВидРасчета Тогда
			Продолжить;
		КонецЕсли;
		Показатели = ПоказателиСтроки(График, Движение.НомерСтроки);
		Если Мера = "Часы" Тогда
			Факт = Показатели.Часы;
		Иначе
			Факт = Показатели.Дней;
		КонецЕсли;
		Исходный = НайтиИсходный(Исходные, Движение);
		Если Исходный = Неопределено ИЛИ Исходный.Мера = 0 Тогда
			Движение.Результат = 0;
		ИначеЕсли Факт >= Исходный.Мера Тогда
			Движение.Результат = -Исходный.Результат;
		Иначе
			Движение.Результат = -Окр(Исходный.Результат * Факт / Исходный.Мера, 2);
		КонецЕсли;
		Движение.Ставка = Исходный.Ставка;
		Движение.Стаж = Исходный.Стаж;
		Движение.ПроцентПремии = Исходный.ПроцентПремии;
		Если Мера = "Часы" Тогда
			Движение.ОтработаноЧасов = Факт;
		Иначе
			Движение.ОтработаноДней = Факт;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ИсходныеНачисления(ВидРасчета, Регистратор)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидРасчета", ВидРасчета);
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.Сотрудник КАК Сотрудник,
	|	Начисления.Подразделение КАК Подразделение,
	|	Начисления.ПериодДействияНачало КАК ПериодДействияНачало,
	|	Начисления.ПериодДействияКонец КАК ПериодДействияКонец,
	|	Начисления.Результат КАК Результат,
	|	Начисления.ОтработаноЧасов КАК ОтработаноЧасов,
	|	Начисления.ОтработаноДней КАК ОтработаноДней,
	|	Начисления.Ставка КАК Ставка,
	|	Начисления.Стаж КАК Стаж,
	|	Начисления.ПроцентПремии КАК ПроцентПремии
	|ИЗ
	|	РегистрРасчета.Начисления КАК Начисления
	|ГДЕ
	|	Начисления.ВидРасчета = &ВидРасчета
	|	И НЕ Начисления.Сторно
	|	И Начисления.Регистратор <> &Регистратор";
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("Мера", Новый ОписаниеТипов("Число"));
	Для Каждого Строка Из Таблица Цикл
		Если ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
			Строка.Мера = Строка.ОтработаноЧасов;
		Иначе
			Строка.Мера = Строка.ОтработаноДней;
		КонецЕсли;
		Если Строка.Ставка = Null Тогда
			Строка.Ставка = 0;
		КонецЕсли;
		Если Строка.Стаж = Null Тогда
			Строка.Стаж = 0;
		КонецЕсли;
		Если Строка.ПроцентПремии = Null Тогда
			Строка.ПроцентПремии = 0;
		КонецЕсли;
	КонецЦикла;
	Возврат Таблица;

КонецФункции

Функция НайтиИсходный(Таблица, Движение)

	Для Каждого Строка Из Таблица Цикл
		Если Строка.Сотрудник = Движение.Сотрудник
			И Строка.Подразделение = Движение.Подразделение
			И Строка.ПериодДействияНачало <= Движение.ПериодДействияНачало
			И Строка.ПериодДействияКонец >= Движение.ПериодДействияКонец Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Результат, Мера, Ставка, Стаж, ПроцентПремии", 0, 0, 0, 0, 0);

КонецФункции

Функция КалендарныхДней(Начало, Конец)

	Если НЕ ЗначениеЗаполнено(Начало) ИЛИ НЕ ЗначениеЗаполнено(Конец) ИЛИ Конец < Начало Тогда
		Возврат 0;
	КонецЕсли;
	Возврат (НачалоДня(Конец) - НачалоДня(Начало)) / 86400 + 1;

КонецФункции
