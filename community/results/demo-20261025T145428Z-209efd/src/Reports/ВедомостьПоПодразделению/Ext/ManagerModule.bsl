Функция Сформировать(ДатаНачала, ДатаОкончания, Подразделение) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("Конец", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Свойство КАК Свойство,
	|	СУММА(Остатки.СтоимостьНачальныйОстаток) КАК НачальныйОстаток,
	|	СУММА(Остатки.СтоимостьКонечныйОстаток) КАК КонечныйОстаток,
	|	СУММА(Остатки.КоличествоНачальныйОстаток) КАК НачальныйОстатокКоличество,
	|	СУММА(Остатки.КоличествоПриход) КАК ПриходКоличество,
	|	СУММА(Остатки.КоличествоРасход) КАК РасходКоличество,
	|	СУММА(Остатки.КоличествоКонечныйОстаток) КАК КонечныйОстатокКоличество
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрНакопления.ОстаткиДеталей.ОстаткиИОбороты(
	|			&Начало,
	|			&Конец,
	|			,
	|			,
	|			Подразделение = &Подразделение) КАК Остатки
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура,
	|	Остатки.Свойство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Обороты.Номенклатура КАК Номенклатура,
	|	Обороты.Свойство КАК Свойство,
	|	СУММА(Обороты.СтоимостьПриход) КАК Приход,
	|	СУММА(Обороты.СтоимостьРасход) КАК Расход
	|ПОМЕСТИТЬ СтоимостьДвижений
	|ИЗ
	|	РегистрНакопления.ОстаткиДеталей.Обороты(
	|			&Начало,
	|			&Конец,
	|			Запись,
	|			Подразделение = &Подразделение) КАК Обороты
	|ГДЕ
	|	Обороты.КоличествоПриход <> 0
	|	ИЛИ Обороты.КоличествоРасход <> 0
	|СГРУППИРОВАТЬ ПО
	|	Обороты.Номенклатура,
	|	Обороты.Свойство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Свойство КАК Свойство,
	|	Остатки.НачальныйОстаток КАК НачальныйОстаток,
	|	ЕСТЬNULL(СтоимостьДвижений.Приход, 0) КАК Приход,
	|	ЕСТЬNULL(СтоимостьДвижений.Расход, 0) КАК Расход,
	|	Остатки.КонечныйОстаток КАК КонечныйОстаток,
	|	Остатки.НачальныйОстатокКоличество КАК НачальныйОстатокКоличество,
	|	Остатки.ПриходКоличество КАК ПриходКоличество,
	|	Остатки.РасходКоличество КАК РасходКоличество,
	|	Остатки.КонечныйОстатокКоличество КАК КонечныйОстатокКоличество
	|ИЗ
	|	Остатки КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтоимостьДвижений КАК СтоимостьДвижений
	|		ПО Остатки.Номенклатура = СтоимостьДвижений.Номенклатура
	|			И Остатки.Свойство = СтоимостьДвижений.Свойство";
	Обороты = Запрос.Выполнить().Выгрузить();
	Характеристики = ХарактеристикиСвойств(Обороты.ВыгрузитьКолонку("Свойство"));

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("Характеристика");
	Результат.Колонки.Добавить("НачальныйОстаток", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Приход", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Расход", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("КонечныйОстаток", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("НачальныйОстатокКоличество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("ПриходКоличество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("РасходКоличество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("КонечныйОстатокКоличество", Новый ОписаниеТипов("Число"));

	Для Каждого Строка Из Обороты Цикл
		Если Строка.НачальныйОстаток = 0 И Строка.Приход = 0 И Строка.Расход = 0 И Строка.КонечныйОстаток = 0
			И Строка.НачальныйОстатокКоличество = 0 И Строка.ПриходКоличество = 0 И Строка.РасходКоличество = 0 И Строка.КонечныйОстатокКоличество = 0 Тогда
			Продолжить;
		КонецЕсли;
		Новая = Результат.Добавить();
		Новая.Номенклатура = Строка.Номенклатура;
		Новая.Характеристика = Характеристики.Получить(Строка.Свойство);
		Если Новая.Характеристика = Неопределено Тогда
			Новая.Характеристика = "";
		КонецЕсли;
		Новая.НачальныйОстаток = Строка.НачальныйОстаток;
		Новая.Приход = Строка.Приход;
		Новая.Расход = Строка.Расход;
		Новая.КонечныйОстаток = Строка.КонечныйОстаток;
		Новая.НачальныйОстатокКоличество = Строка.НачальныйОстатокКоличество;
		Новая.ПриходКоличество = Строка.ПриходКоличество;
		Новая.РасходКоличество = Строка.РасходКоличество;
		Новая.КонечныйОстатокКоличество = Строка.КонечныйОстатокКоличество;
	КонецЦикла;
	Результат.Сортировать("Характеристика, Номенклатура");
	Возврат Результат;

КонецФункции

Функция ХарактеристикиСвойств(Свойства)

	Результат = Новый Соответствие;
	Если Свойства.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Свойства", Свойства);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Значения.Свойство КАК Свойство,
	|	Значения.Характеристика.Наименование КАК Характеристика,
	|	Значения.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойств КАК Значения
	|ГДЕ
	|	Значения.Свойство В (&Свойства)
	|УПОРЯДОЧИТЬ ПО
	|	Характеристика";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Текст = Результат.Получить(Выборка.Свойство);
		Представление = Строка(Выборка.Значение);
		Если Текст = Неопределено ИЛИ Текст = "" Тогда
			Текст = Представление;
		Иначе
			Текст = Текст + ", " + Представление;
		КонецЕсли;
		Результат.Вставить(Выборка.Свойство, Текст);
	КонецЦикла;
	Возврат Результат;

КонецФункции
