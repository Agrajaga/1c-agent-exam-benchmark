&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент) Экспорт
    МенеджерИзмененНаСервере();
КонецПроцедуры

&НаСервере
Процедура МенеджерИзмененНаСервере()
    СохранитьДополнительныеПоля(Объект, ПредыдущийМенеджер);
    ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Функция СписокСведений(Менеджер)
    Запрос = Новый Запрос("ВЫБРАТЬ Список.ВидСведения, Список.ВидСведения.Наименование КАК Наименование, Список.ВидСведения.ТипЗначения КАК ТипЗначения
    |ИЗ (ВЫБРАТЬ РАЗЛИЧНЫЕ ВидСведения ИЗ Справочник.ФизическиеЛица.ДополнительныеСведения ГДЕ Ссылка = &Менеджер) КАК Список");
    Запрос.УстановитьПараметр("Менеджер", Менеджер);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

&НаСервереБезКонтекста
Функция ИмяПоляСведения(ВидСведения)
    Возврат "ДопПоле_" + СтрЗаменить(Строка(ВидСведения.УникальныйИдентификатор()), "-", "_");
КонецФункции

&НаСервере
Процедура СохранитьДополнительныеПоля(Получатель, Менеджер)
    Сведения = СписокСведений(Менеджер);
    Для Каждого Сведение Из Сведения Цикл
        ИмяПоля = ИмяПоляСведения(Сведение.ВидСведения);
        Если Элементы.Найти(ИмяПоля) = Неопределено Тогда Продолжить; КонецЕсли;
        СтрокиЗначений = Получатель.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведения", Сведение.ВидСведения));
        СтрокаЗначения = ?(СтрокиЗначений.Количество() = 0, Неопределено, СтрокиЗначений[0]);
        Если СтрокаЗначения = Неопределено Тогда СтрокаЗначения = Получатель.ДополнительныеСведения.Добавить(); СтрокаЗначения.ВидСведения = Сведение.ВидСведения; КонецЕсли;
        СтрокаЗначения.Значение = ЭтотОбъект[ИмяПоля];
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПостроитьДополнительныеПоля()
    Удаляемые = Новый Массив;
    Для Каждого Реквизит Из ПолучитьРеквизиты() Цикл
        Если Лев(Реквизит.Имя,8) = "ДопПоле_" Тогда Удаляемые.Добавить(Реквизит.Имя); КонецЕсли;
    КонецЦикла;
    Для Каждого ИмяПоля Из Удаляемые Цикл
        Элемент = Элементы.Найти(ИмяПоля);
        Если Элемент <> Неопределено Тогда Элементы.Удалить(Элемент); КонецЕсли;
    КонецЦикла;
    Добавляемые = Новый Массив; Сведения = СписокСведений(Объект.Менеджер);
    Для Каждого Сведение Из Сведения Цикл
        Добавляемые.Добавить(Новый РеквизитФормы(ИмяПоляСведения(Сведение.ВидСведения), Сведение.ТипЗначения));
    КонецЦикла;
    ИзменитьРеквизиты(Добавляемые, Удаляемые);
    Для Каждого Сведение Из Сведения Цикл
        ИмяПоля = ИмяПоляСведения(Сведение.ВидСведения);
        Поле = Элементы.Добавить(ИмяПоля, Тип("ПолеФормы"), Элементы.ДополнительныеПоля);
        Поле.Вид = ВидПоляФормы.ПолеВвода; Поле.УстановитьДействие("ПриИзменении","ДопПолеПриИзменении"); Поле.ПутьКДанным = ИмяПоля; Поле.Заголовок = Сведение.Наименование;
        СтрокиЗначений = Объект.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведения", Сведение.ВидСведения));
        СтрокаЗначения = ?(СтрокиЗначений.Количество() = 0, Неопределено, СтрокиЗначений[0]);
        Если СтрокаЗначения <> Неопределено Тогда ЭтотОбъект[ИмяПоля] = Сведение.ТипЗначения.ПривестиЗначение(СтрокаЗначения.Значение); КонецЕсли;
    КонецЦикла;
    ПредыдущийМенеджер = Объект.Менеджер;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    СохранитьДополнительныеПоля(ТекущийОбъект, Объект.Менеджер);
КонецПроцедуры


&НаКлиенте
Процедура ДопПолеПриИзменении(Элемент)
    Модифицированность = Истина;
КонецПроцедуры
