Процедура ЗаполнитьГрафик(ДатаНачала, ДатаОкончания, ВыходныеДни, Подразделение, ЧасовВДень = 8) Экспорт
    Если Не ЗначениеЗаполнено(Подразделение) Тогда ВызватьИсключение "Укажите подразделение"; КонецЕсли;
    Если ДатаНачала > ДатаОкончания Или ЧасовВДень < 0 Или ЧасовВДень > 24 Тогда ВызватьИсключение "Проверьте период и число часов в дне"; КонецЕсли;
    НачатьТранзакцию();
    Попытка
        УчетСервер.Заблокировать("РегистрСведений.ГрафикиРаботы");
        Набор = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей(); Набор.Отбор.Подразделение.Установить(Подразделение); Набор.Прочитать();
        Индекс = Набор.Количество() - 1;
        Пока Индекс >= 0 Цикл
            Если Набор[Индекс].Дата >= НачалоДня(ДатаНачала) И Набор[Индекс].Дата <= КонецДня(ДатаОкончания) Тогда Набор.Удалить(Индекс); КонецЕсли;
            Индекс = Индекс - 1;
        КонецЦикла;
        День = НачалоДня(ДатаНачала);
        Пока День <= ДатаОкончания Цикл
            Строка = Набор.Добавить(); Строка.Подразделение = Подразделение; Строка.Дата = День;
            Строка.Значение = ?(СтрНайти(ВыходныеДни,Строка(ДеньНедели(День))) > 0,0,ЧасовВДень);
            День = День + 86400;
        КонецЦикла;
        Набор.Записать(); ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
