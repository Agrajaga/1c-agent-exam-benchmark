Процедура ПриНачалеРаботыСистемы()
    Если Лев(ПараметрЗапуска, 8) = "DEMOLOG=" Тогда
        Сообщить(Демонстрация.ПроверитьПример(Сред(ПараметрЗапуска, 9)));
        ЗавершитьРаботуСистемы(Ложь);
    ИначеЕсли Лев(ПараметрЗапуска,8) = "SAMPLES=" Тогда
        Попытка Демонстрация.СформироватьОбразцы(Сред(ПараметрЗапуска,9)); Текст = "OK: четыре образца PDF";
        Исключение Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); КонецПопытки;
        Сообщить(Текст); ЗавершитьРаботуСистемы(Ложь);
    ИначеЕсли Лев(ПараметрЗапуска,8) = "TESTLOG=" Тогда
        Сообщить(Испытания.Запустить(Сред(ПараметрЗапуска,9))); ЗавершитьРаботуСистемы(Ложь);
    ИначеЕсли Лев(ПараметрЗапуска,9) = "FORMSLOG=" Тогда
        Попытка
            Данные = Демонстрация.ПодготовитьФорму();
            Форма = ПолучитьФорму("Справочник.Контрагенты.Форма.ФормаЭлемента", Новый Структура("Ключ", Данные.Контрагент));
            Форма[Данные.ИмяПоля] = 10;
            Форма.Записать();
            Демонстрация.ПроверитьЗаписьФормы(Данные.Контрагент, Данные.Вид);
            Форма.Открыть(); Форма.Закрыть();
            Форма = ПолучитьФорму("Справочник.Контрагенты.Форма.ФормаЭлемента", Новый Структура("Ключ", Данные.Контрагент));
            Если Форма[Данные.ИмяПоля] <> 10 Тогда ВызватьИсключение "Значение не восстановилось при открытии формы"; КонецЕсли;
            Форма.Объект.Менеджер = Данные.ДругойМенеджер; Форма.МенеджерПриИзменении(Неопределено);
            Если Форма.Элементы.Найти(Данные.ИмяПоля) <> Неопределено Тогда ВызватьИсключение "Старое поле не удалилось после смены менеджера"; КонецЕсли;
            Форма[Данные.НовоеИмяПоля] = 20; Форма.Записать();
            Форма.Объект.Менеджер = Данные.Менеджер; Форма.МенеджерПриИзменении(Неопределено);
            Если Форма[Данные.ИмяПоля] <> 10 Тогда ВызватьИсключение "Прежнее значение потерялось после возврата менеджера"; КонецЕсли;
            Форма.Записать();
            Форма.Открыть(); Форма.Закрыть();
            Форма = ПолучитьФорму("Отчет.ПродажиБУ.Форма.Форма"); Форма.Начало = Дата(2024,1,1); Форма.Конец = Дата(2024,3,31); Форма.Сформировать(Неопределено); Форма.Открыть(); Форма.Закрыть();
            Форма = ПолучитьФорму("Отчет.ПродажиОУ.Форма.Форма"); Форма.Начало = Дата(2024,1,1); Форма.Конец = Дата(2024,3,31); Форма.Сформировать(Неопределено); Форма.Открыть(); Форма.Закрыть();
            Форма = ПолучитьФорму("Отчет.Премии.Форма.Форма"); Форма.Начало = Дата(2024,2,1); Форма.Конец = Дата(2024,2,29); Форма.Сформировать(Неопределено); Форма.Открыть(); Форма.Закрыть();
            Форма = ПолучитьФорму("Отчет.ВедомостьОУ.Форма.Форма"); Форма.Начало = Дата(2024,1,1); Форма.Конец = Дата(2024,3,31); Форма.Сформировать(Неопределено); Форма.Открыть(); Форма.Закрыть();
            Текст = "OK: дополнительные поля, повторное открытие и четыре формы отчетов";
        Исключение
            Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        КонецПопытки;
        Демонстрация.ЗаписатьЖурнал(Сред(ПараметрЗапуска,10),Текст);
        ЗавершитьРаботуСистемы(Ложь);
    КонецЕсли;
КонецПроцедуры

