// Инициализация штатных зависимостей видов расчета, без механизма перерасчетов.
Процедура НастроитьВидыРасчета() Экспорт
    Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф.ПолучитьОбъект();
    Если Тариф.ВытесняющиеВидыРасчета.Количество() = 0 Тогда
        Тариф.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка; Тариф.Записать();
    КонецЕсли;
    Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия.ПолучитьОбъект();
    Если Премия.БазовыеВидыРасчета.Количество() = 0 Тогда
        Премия.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
        Премия.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка; Премия.Записать();
    КонецЕсли;
    Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка.ПолучитьОбъект();
    Если Командировка.БазовыеВидыРасчета.Количество() = 0 Тогда
        Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
        Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия;
        Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка; Командировка.Записать();
    КонецЕсли;
КонецПроцедуры

Процедура Провести(ДокументОбъект) Экспорт
    НастроитьВидыРасчета();
    УчетСервер.Заблокировать("РегистрРасчета.Начисления");
    ПрежниеДанные = ПрежниеЗаписи(ДокументОбъект.Ссылка);
    Сотрудники = ПрежниеДанные.ВыгрузитьКолонку("Сотрудник"); Начало = Дата(3999,1,1); Окончание = Дата(1,1,1);
    Для Каждого ПрежняяСтрока Из ПрежниеДанные Цикл
        Начало = Мин(Начало, ПрежняяСтрока.ПериодДействияНачало); Окончание = Макс(Окончание, ПрежняяСтрока.ПериодДействияКонец);
    КонецЦикла;
    Набор = ДокументОбъект.Движения.Начисления; Набор.Очистить(); Набор.Записать();
    Если ДокументОбъект.ОсновныеНачисления.Количество() = 0 Тогда ВызватьИсключение "Документ не содержит начислений"; КонецЕсли;
    ТаблицаВвода = ДокументОбъект.ОсновныеНачисления.Выгрузить();
    ТаблицаВвода.Свернуть("Сотрудник,Подразделение,ВидРасчета,ДатаНачала,ДатаОкончания,ПериодРегистрации","");
    Для Каждого Строка Из ТаблицаВвода Цикл
        Если Не ЗначениеЗаполнено(Строка.Сотрудник) Или Не ЗначениеЗаполнено(Строка.Подразделение) Или Не ЗначениеЗаполнено(Строка.ВидРасчета)
            Или Не ЗначениеЗаполнено(Строка.ДатаНачала) Или Строка.ДатаОкончания < Строка.ДатаНачала Тогда
            ВызватьИсключение "Не заполнены сотрудник, подразделение, вид расчета или период начисления";
        КонецЕсли;
        Если Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Тариф И Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия
            И Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда ВызватьИсключение "Неизвестный вид расчета"; КонецЕсли;
        ЭтоКомандировка = Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
        Если Не ЭтоКомандировка И НачалоМесяца(Строка.ДатаНачала) <> НачалоМесяца(Строка.ДатаОкончания) Тогда
            ВызватьИсключение "Тариф и премия вводятся в пределах одного календарного месяца";
        КонецЕсли;
        Сотрудники.Добавить(Строка.Сотрудник);
        ТекущаяДата = НачалоДня(Строка.ДатаНачала);
        Пока ТекущаяДата <= Строка.ДатаОкончания Цикл
            Д = Набор.Добавить(); Д.КлючРасчета = Строка(Новый УникальныйИдентификатор); Д.ВидРасчета = Строка.ВидРасчета;
            Д.Сотрудник = Строка.Сотрудник; Д.Подразделение = Строка.Подразделение;
            Д.ПериодДействияНачало = ТекущаяДата; Д.ПериодДействияКонец = Мин(КонецМесяца(ТекущаяДата), КонецДня(Строка.ДатаОкончания));
            Д.ПериодРегистрации = ?(ЗначениеЗаполнено(Строка.ПериодРегистрации), НачалоМесяца(Строка.ПериодРегистрации),
                ?(ЭтоКомандировка, Макс(НачалоМесяца(ДокументОбъект.Дата), НачалоМесяца(ТекущаяДата)), НачалоМесяца(ТекущаяДата)));
            Если Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
                Д.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(ТекущаяДата), -1); Д.БазовыйПериодКонец = НачалоМесяца(ТекущаяДата) - 1;
            ИначеЕсли ЭтоКомандировка Тогда
                Д.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Строка.ДатаНачала), -3); Д.БазовыйПериодКонец = НачалоМесяца(Строка.ДатаНачала) - 1;
            КонецЕсли;
            Начало = Мин(Начало, Д.ПериодДействияНачало); Окончание = Макс(Окончание, Д.ПериодДействияКонец);
            ТекущаяДата = НачалоМесяца(ДобавитьМесяц(ТекущаяДата,1));
        КонецЦикла;
    КонецЦикла;
    Для Индекс1 = 0 По Набор.Количество()-1 Цикл
        Первая = Набор[Индекс1];
        Для Индекс2 = Индекс1+1 По Набор.Количество()-1 Цикл
            Вторая = Набор[Индекс2];
            Если Первая.Сотрудник = Вторая.Сотрудник И Первая.Подразделение = Вторая.Подразделение И Первая.ВидРасчета = Вторая.ВидРасчета
                И Первая.ПериодДействияНачало <= Вторая.ПериодДействияКонец И Первая.ПериодДействияКонец >= Вторая.ПериодДействияНачало Тогда
                ВызватьИсключение "Пересекаются периоды одного вида начисления по сотруднику и подразделению. Объедините интервалы в одну строку.";
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    // Дополнение штатно рассчитывается по ранее записанным начислениям других документов.
    // Если более ранний тариф впервые вводится вместе с поздней командировкой,
    // предварительно записываем исходные строки и рассчитываем дополнение для
    // отдельного НЕЗАПИСЫВАЕМОГО предварительного набора. Его техническая ссылка
    // исключает из отбора только этот предварительный набор, сохраняя в базе
    // исходные строки текущего документа. Документ с этой ссылкой не создается.
    ВнутреннееСторно = Ложь;
    Для Каждого Командировка Из Набор Цикл
        Если Командировка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда Продолжить; КонецЕсли;
        Для Каждого Основа Из Набор Цикл
            Если (Основа.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Или Основа.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия)
                И Основа.Сотрудник = Командировка.Сотрудник И Основа.Подразделение = Командировка.Подразделение
                И Основа.ПериодРегистрации < Командировка.ПериодРегистрации
                И Основа.ПериодДействияНачало <= Командировка.ПериодДействияКонец И Основа.ПериодДействияКонец >= Командировка.ПериодДействияНачало Тогда
                ВнутреннееСторно = Истина; Прервать;
            КонецЕсли;
        КонецЦикла;
        Если ВнутреннееСторно Тогда Прервать; КонецЕсли;
    КонецЦикла;
    Если ВнутреннееСторно Тогда
        Набор.Записать(Истина, Ложь, Истина, Ложь);
        ПредварительныйНабор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей();
        ПредварительныйНабор.Отбор.Регистратор.Установить(Документы.НачислениеЗарплаты.ПолучитьСсылку(Новый УникальныйИдентификатор));
        Для Каждого Запись Из Набор Цикл
            Если Запись.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда Продолжить; КонецЕсли;
            ПредварительнаяЗапись = ПредварительныйНабор.Добавить();
            ЗаполнитьЗначенияСвойств(ПредварительнаяЗапись,Запись,,"Регистратор,НомерСтроки");
        КонецЦикла;
        Дополнение = ПредварительныйНабор.ПолучитьДополнение();
    Иначе
        Дополнение = Набор.ПолучитьДополнение();
    КонецЕсли;
    Для Каждого Строка Из Дополнение Цикл
        Д = Набор.Добавить(); ЗаполнитьЗначенияСвойств(Д, Строка);
        Д.ПериодРегистрации = Строка.ПериодРегистрацииСторно;
        Д.ПериодДействияНачало = Строка.ПериодДействияНачалоСторно;
        Д.ПериодДействияКонец = Строка.ПериодДействияКонецСторно;
        Д.Сторно = Истина; Д.Результат = 0; Д.Дни = 0;
        Д.КлючИсходнойЗаписи = Строка.КлючРасчета; Д.КлючРасчета = Строка(Новый УникальныйИдентификатор);
    КонецЦикла;
    Набор.Записать(Истина, Ложь, Истина, Ложь);
    // Пересчет результатов затронутых записей текущих периодов выполняется явно.
    // Объекты «Перерасчет» не создаются по прямому указанию билета.
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Регистратор ИЗ РегистрРасчета.Начисления
    |ГДЕ Сотрудник В (&Сотрудники) И ПериодДействияНачало <= &Конец И ПериодДействияКонец >= &Начало");
    Запрос.УстановитьПараметр("Сотрудники", Сотрудники); Запрос.УстановитьПараметр("Начало", Начало); Запрос.УстановитьПараметр("Конец", Окончание);
    Регистраторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
    Рассчитать(Регистраторы);
    Набор.Записывать = Ложь;
КонецПроцедуры

Процедура ЗаписатьРезультаты(Таблица, Регистраторы)
    Для Каждого Регистратор Из Регистраторы Цикл
        Строки = Таблица.НайтиСтроки(Новый Структура("Регистратор", Регистратор));
        Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей(); Набор.Отбор.Регистратор.Установить(Регистратор);
        Набор.Загрузить(Таблица.Скопировать(Строки)); Набор.Записать(Истина, Ложь, Ложь, Ложь);
    КонецЦикла;
КонецПроцедуры

Процедура Рассчитать(Регистраторы) Экспорт
    Если Регистраторы.Количество() = 0 Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ РегистрРасчета.Начисления ГДЕ Регистратор В (&Регистраторы)");
    Запрос.УстановитьПараметр("Регистраторы", Регистраторы); Таблица = Запрос.Выполнить().Выгрузить();
    Запрос.Текст = "ВЫБРАТЬ Регистратор, НомерСтроки, ЕСТЬNULL(ЗначениеФактическийПериодДействия,0) КАК Часы,
    |ЕСТЬNULL(ДнейФактическийПериодДействия,0) КАК Дни, ЕСТЬNULL(ДнейПериодРегистрации,0) КАК Норма,
    |Сотрудник.НачалоСтажа КАК НачалоСтажа
    |ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор В (&Регистраторы))";
    График = Запрос.Выполнить().Выгрузить();
    Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ Сотрудник, НАЧАЛОПЕРИОДА(ПериодДействияНачало, МЕСЯЦ) КАК Месяц
    |ПОМЕСТИТЬ Потребность ИЗ РегистрРасчета.Начисления ГДЕ Регистратор В (&Регистраторы);
    |ВЫБРАТЬ П.Сотрудник, П.Месяц, МАКСИМУМ(Т.Период) КАК Период ПОМЕСТИТЬ ПериодыСтавок
    |ИЗ Потребность КАК П ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК Т
    |ПО П.Сотрудник = Т.Сотрудник И Т.Период <= П.Месяц СГРУППИРОВАТЬ ПО П.Сотрудник, П.Месяц;
    |ВЫБРАТЬ П.Сотрудник, П.Месяц, ЕСТЬNULL(Т.Ставка,0) КАК Ставка, ВЫБОР КОГДА Т.Период ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК Найдена
    |ИЗ ПериодыСтавок КАК П ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК Т
    |ПО П.Сотрудник = Т.Сотрудник И П.Период = Т.Период";
    Ставки = Запрос.Выполнить().Выгрузить();
    Запрос.Текст = "ВЫБРАТЬ СтажОт, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО СтажОт УБЫВ";
    Шкала = Запрос.Выполнить().Выгрузить();
    Для Каждого Строка Из Таблица Цикл
        Данные = График.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Строка.Регистратор, Строка.НомерСтроки));
        Если Данные.Количество() = 0 Тогда
            ВызватьИсключение "Не заполнен график подразделения " + Строка.Подразделение + " за период начисления";
        КонецЕсли;
        Данные = Данные[0];
        Если Не ЗначениеЗаполнено(Строка.КлючРасчета) Тогда Строка.КлючРасчета = Строка(Новый УникальныйИдентификатор); КонецЕсли;
        Строка.ОплаченоДней = ?(Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Или Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка, Данные.Дни * ?(Строка.Сторно,-1,1), 0);
        Если Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
            Ставка = Ставки.НайтиСтроки(Новый Структура("Сотрудник,Месяц", Строка.Сотрудник, НачалоМесяца(Строка.ПериодДействияНачало)));
            Если Не Строка.Сторно Или Строка.Ставка = 0 Тогда
                Если Не Ставка[0].Найдена Тогда ВызватьИсключение "Не задана тарифная ставка на начало месяца сотруднику " + Строка.Сотрудник; КонецЕсли;
                Строка.Ставка = Ставка[0].Ставка;
            КонецЕсли;
            Строка.Результат = Окр(Строка.Ставка * Данные.Часы, 2) * ?(Строка.Сторно,-1,1);
            Строка.Дни = Данные.Дни * ?(Строка.Сторно,-1,1);
        Иначе
            Строка.Дни = 0;
            Если Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия И Не Строка.Сторно Тогда
                Если Не ЗначениеЗаполнено(Данные.НачалоСтажа) Тогда ВызватьИсключение "Не указана дата начала стажа сотрудника " + Строка.Сотрудник; КонецЕсли;
                Строка.НормаДней = Данные.Норма;
                Месяц = НачалоМесяца(Строка.ПериодДействияНачало);
                Лет = Год(Месяц) - Год(Данные.НачалоСтажа);
                Если ДобавитьМесяц(Данные.НачалоСтажа, Лет * 12) > Месяц Тогда Лет = Лет - 1; КонецЕсли;
                Строка.Стаж = Макс(0, Лет); Строка.Процент = 0;
                Для Каждого Порог Из Шкала Цикл
                    Если Строка.Стаж >= Порог.СтажОт Тогда Строка.Процент = Порог.Процент; Прервать; КонецЕсли;
                КонецЦикла;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Для Каждого Строка Из Таблица Цикл
        Если Строка.Сторно И ЗначениеЗаполнено(Строка.КлючИсходнойЗаписи) Тогда
            Исходная = Таблица.Найти(Строка.КлючИсходнойЗаписи,"КлючРасчета");
            Если Исходная <> Неопределено Тогда Строка.НормаДней = Исходная.НормаДней; Строка.Процент = Исходная.Процент; Строка.Стаж = Исходная.Стаж; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    ЗаписатьРезультаты(Таблица, Регистраторы);
    // База премии: все сотрудники подразделения с отдельным разрезом сотрудника для исключения руководителя.
    Измерения = Новый Массив; Измерения.Добавить("Подразделение"); Разрезы = Новый Массив; Разрезы.Добавить("Сотрудник");
    Запрос.УстановитьПараметр("Измерения", Измерения); Запрос.УстановитьПараметр("Разрезы", Разрезы);
    Запрос.УстановитьПараметр("Премия", ПланыВидовРасчета.ОсновныеНачисления.Премия);
    Запрос.Текст = "ВЫБРАТЬ Регистратор, НомерСтроки, СУММА(ВЫБОР КОГДА СотрудникРазрез <> Сотрудник ТОГДА РезультатБаза ИНАЧЕ 0 КОНЕЦ) КАК База
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, &Разрезы,
    |Регистратор В (&Регистраторы) И ВидРасчета = &Премия) СГРУППИРОВАТЬ ПО Регистратор, НомерСтроки";
    БазаПремий = Запрос.Выполнить().Выгрузить();
    Для Каждого Строка Из Таблица Цикл
        Если Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда Продолжить; КонецЕсли;
        Данные = График.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Строка.Регистратор, Строка.НомерСтроки))[0];
        База = БазаПремий.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Строка.Регистратор, Строка.НомерСтроки));
        СуммаБазы = ?(База.Количество() = 0, 0, База[0].База);
        Строка.Результат = ?(Строка.НормаДней = 0, 0, Окр(СуммаБазы * Строка.Процент / 100 * Данные.Дни / Строка.НормаДней, 2)) * ?(Строка.Сторно,-1,1);
    КонецЦикла;
    ЗаписатьРезультаты(Таблица, Регистраторы);
    // Средний заработок командировки: начисления сотрудника по всем подразделениям.
    // Разрез по ключу базовой записи и ресурс оплаченных дней позволяют рассчитать
    // зависимые командировки разных месяцев в одном документе без запросов в цикле.
    Измерения = Новый Массив; Измерения.Добавить("Сотрудник"); Разрезы = Новый Массив; Разрезы.Добавить("КлючРасчета");
    Запрос.УстановитьПараметр("Измерения", Измерения); Запрос.УстановитьПараметр("Разрезы",Разрезы);
    Запрос.УстановитьПараметр("Командировка", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
    Запрос.Текст = "ВЫБРАТЬ Регистратор, НомерСтроки, КлючРасчетаРазрез КАК КлючБазы,
    |РезультатБаза КАК База, ДниБаза КАК Дни, ОплаченоДнейБаза КАК ОплаченоДней
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, &Разрезы,
    |Регистратор В (&Регистраторы) И ВидРасчета = &Командировка)";
    БазаКомандировок = Запрос.Выполнить().Выгрузить();
    Порядок = Новый ТаблицаЗначений; Порядок.Колонки.Добавить("Дата"); Порядок.Колонки.Добавить("Запись");
    Для Каждого Строка Из Таблица Цикл
        Если Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
            С = Порядок.Добавить(); С.Дата = Строка.ПериодДействияНачало; С.Запись = Строка;
        КонецЕсли;
    КонецЦикла;
    Порядок.Сортировать("Дата"); Изменения = Новый Соответствие;
    Для Каждого С Из Порядок Цикл
        Строка = С.Запись;
        База = БазаКомандировок.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Строка.Регистратор, Строка.НомерСтроки));
        СуммаБазы = 0; ДниБазы = 0;
        Для Каждого Б Из База Цикл
            СуммаБазы = СуммаБазы + Б.База; ДниБазы = ДниБазы + Б.Дни;
            Изменение = Изменения.Получить(Б.КлючБазы);
            Если Изменение <> Неопределено И Изменение.Дни <> 0 Тогда
                СуммаБазы = СуммаБазы + Изменение.Разница * Б.ОплаченоДней / Изменение.Дни;
            КонецЕсли;
        КонецЦикла;
        ПрежнийРезультат = Строка.Результат;
        Строка.Результат = ?(ДниБазы = 0,0,Окр(СуммаБазы / ДниБазы * Строка.ОплаченоДней,2));
        Изменения.Вставить(Строка.КлючРасчета, Новый Структура("Разница,Дни",Строка.Результат-ПрежнийРезультат,Строка.ОплаченоДней));
    КонецЦикла;
    ЗаписатьРезультаты(Таблица, Регистраторы);
КонецПроцедуры



Функция ПрежниеЗаписи(Ссылка)
    Запрос = Новый Запрос("ВЫБРАТЬ Сотрудник, ПериодДействияНачало, ПериодДействияКонец ИЗ РегистрРасчета.Начисления ГДЕ Регистратор = &Ссылка");
    Запрос.УстановитьПараметр("Ссылка", Ссылка); Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура Отменить(ДокументОбъект) Экспорт
    УчетСервер.Заблокировать("РегистрРасчета.Начисления");
    ПрежниеДанные = ПрежниеЗаписи(ДокументОбъект.Ссылка); Если ПрежниеДанные.Количество() = 0 Тогда Возврат; КонецЕсли;
    Начало = Дата(3999,1,1); Окончание = Дата(1,1,1); Сотрудники = ПрежниеДанные.ВыгрузитьКолонку("Сотрудник");
    Для Каждого Строка Из ПрежниеДанные Цикл Начало = Мин(Начало, Строка.ПериодДействияНачало); Окончание = Макс(Окончание, Строка.ПериодДействияКонец); КонецЦикла;
    Набор = ДокументОбъект.Движения.Начисления; Набор.Очистить(); Набор.Записать(Истина, Ложь, Истина, Ложь); Набор.Записывать = Ложь;
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Регистратор ИЗ РегистрРасчета.Начисления
    |ГДЕ Сотрудник В (&Сотрудники) И ПериодДействияНачало <= &Конец И ПериодДействияКонец >= &Начало");
    Запрос.УстановитьПараметр("Сотрудники", Сотрудники); Запрос.УстановитьПараметр("Начало", Начало); Запрос.УстановитьПараметр("Конец", Окончание);
    Рассчитать(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор"));
КонецПроцедуры

