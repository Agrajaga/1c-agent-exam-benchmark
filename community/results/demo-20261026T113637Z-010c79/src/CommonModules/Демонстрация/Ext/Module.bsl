Процедура Заполнить() Экспорт
    НачатьТранзакцию();
    Попытка
    УчетСервер.НастроитьУчет();
    Подразделение = Справочники.Подразделения.СоздатьЭлемент(); Подразделение.Наименование = "Демо: основной цех"; Подразделение.Записать();
    Склад = Справочники.Склады.СоздатьЭлемент(); Склад.Наименование = "Демо: склад"; Склад.Записать();
    Деталь = Справочники.Номенклатура.СоздатьЭлемент(); Деталь.Наименование = "Демо: материнская плата"; Деталь.Артикул = "DEMO-01"; Деталь.Производитель = "ASUS"; Деталь.Записать();
    Блок = Справочники.Номенклатура.СоздатьЭлемент(); Блок.Наименование = "Демо: системный блок"; Блок.Артикул = "DEMO-02"; Блок.Записать();
    Свойство = Справочники.СвойстваНоменклатуры.СоздатьЭлемент(); Свойство.Наименование = "Демо: ASUS"; Свойство.Номенклатура = Деталь.Ссылка; Свойство.Записать();
    Характеристика = ПланыВидовХарактеристик.ХарактеристикиДеталей.СоздатьЭлемент(); Характеристика.Наименование = "Производитель"; Характеристика.ТипЗначения = Новый ОписаниеТипов("Строка"); Характеристика.Записать();
    ЗначениеСвойства = РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи(); ЗначениеСвойства.Свойство = Свойство.Ссылка; ЗначениеСвойства.Характеристика = Характеристика.Ссылка; ЗначениеСвойства.Значение = "ASUS"; ЗначениеСвойства.Записать();
    Политика = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи(); Политика.Период = Дата(2024,1,1); Политика.Подразделение = Подразделение.Ссылка; Политика.Метод = Перечисления.УчетнаяПолитика.ФИФО; Политика.Записать();
    Состав = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи(); Состав.Период = Дата(2024,1,1); Состав.СистемныйБлок = Блок.Ссылка; Состав.Деталь = Деталь.Ссылка; Состав.Свойство = Свойство.Ссылка; Состав.Количество = 1; Состав.Записать();
    Приход = Документы.ПриходнаяНакладная.СоздатьДокумент(); Приход.Дата = Дата(2024,1,2,9,0,0); Приход.Подразделение = Подразделение.Ссылка; Приход.Склад = Склад.Ссылка;
    С = Приход.СписокНоменклатуры.Добавить(); С.Номенклатура = Деталь.Ссылка; С.Свойство = Свойство.Ссылка; С.Количество = 10; С.Цена = 5000; С.Сумма = 50000;
    Приход.Записать(РежимЗаписиДокумента.Проведение);
    Сборка = Документы.Сборка.СоздатьДокумент(); Сборка.Дата = Дата(2024,1,3,9,0,0); Сборка.ПодразделениеИсточник = Подразделение.Ссылка; Сборка.ПодразделениеПолучатель = Подразделение.Ссылка;
    С = Сборка.СистемныеБлоки.Добавить(); С.Номенклатура = Блок.Ссылка; С.Количество = 2; Сборка.Записать(РежимЗаписиДокумента.Проведение);
    Продажа = Документы.РасходнаяНакладная.СоздатьДокумент(); Продажа.Дата = Дата(2024,1,4,9,0,0); Продажа.Подразделение = Подразделение.Ссылка;
    С = Продажа.СписокНоменклатуры.Добавить(); С.Номенклатура = Блок.Ссылка; С.Количество = 1; С.Цена = 7500; С.Сумма = 7500; Продажа.Записать(РежимЗаписиДокумента.Проведение);
    Продажа = Документы.РасходнаяНакладная.СоздатьДокумент(); Продажа.Дата = Дата(2024,1,4,10,0,0); Продажа.Склад = Склад.Ссылка;
    С = Продажа.СписокНоменклатуры.Добавить(); С.Номенклатура = Деталь.Ссылка; С.Количество = 2; С.Цена = 7000; С.Сумма = 14000; Продажа.Записать(РежимЗаписиДокумента.Проведение);
    Операция = Документы.Операция.СоздатьДокумент(); Операция.Дата = Дата(2024,1,5,9,0,0);
    С = Операция.Проводки.Добавить(); С.СчетДт = ПланыСчетов.Управленческий.Товары; С.СчетКт = ПланыСчетов.Управленческий.Поставщики; С.НоменклатураДт = Деталь.Ссылка; С.СкладДт = Склад.Ссылка; С.КоличествоДт = 1; С.Сумма = 5000; Операция.Записать(РежимЗаписиДокумента.Проведение);
    ЗаполнитьЗарплату(Подразделение.Ссылка);
    ПодготовитьФорму();
    Отчеты.ВедомостьОУ.Создать().Данные(Дата(2024,1,1), Дата(2024,3,31), Подразделение.Ссылка);
    Отчеты.ПродажиОУ.Создать().Данные(Дата(2024,1,1), Дата(2024,3,31));
    Отчеты.ПродажиБУ.Создать().Данные(Дата(2024,1,1), Дата(2024,3,31));
    Отчеты.Премии.Создать().Данные(Дата(2024,2,1), Дата(2024,2,29));

        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Функция ПроверитьПример(ПутьЖурнала) Экспорт
    Попытка
        Заполнить();
        Текст = "OK: демонстрационные документы проведены";
    Исключение
        Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;
    Файл = Новый ЗаписьТекста(ПутьЖурнала, КодировкаТекста.UTF8); Файл.ЗаписатьСтроку(Текст); Файл.Закрыть();
    Возврат Текст;
КонецФункции


Процедура ЗаполнитьЗарплату(Подразделение)
    Сотрудник = Справочники.ФизическиеЛица.СоздатьЭлемент(); Сотрудник.Наименование = "Демо: сотрудник"; Сотрудник.НачалоСтажа = Дата(2022,1,1); Сотрудник.Записать();
    Руководитель = Справочники.ФизическиеЛица.СоздатьЭлемент(); Руководитель.Наименование = "Демо: руководитель"; Руководитель.НачалоСтажа = Дата(2022,1,1); Руководитель.Записать();
    Т = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); Т.Период = Дата(2024,1,1); Т.Сотрудник = Сотрудник.Ссылка; Т.Ставка = 100; Т.Записать();
    Т = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); Т.Период = Дата(2024,1,1); Т.Сотрудник = Руководитель.Ссылка; Т.Ставка = 200; Т.Записать();
    Т = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Т.СтажОт = 0; Т.Процент = 5; Т.Записать(); Т = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Т.СтажОт = 1; Т.Процент = 10; Т.Записать(); Т = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Т.СтажОт = 3; Т.Процент = 15; Т.Записать();
    График = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей(); График.Отбор.Подразделение.Установить(Подразделение);
    День = Дата(2023,10,1);
    Пока День <= Дата(2024,4,30) Цикл
        С = График.Добавить(); С.Подразделение = Подразделение; С.Дата = День; С.Значение = ?(ДеньНедели(День) <= 5,8,0); День = День + 86400;
    КонецЦикла;
    График.Записать();
    Январь = Документы.НачислениеЗарплаты.СоздатьДокумент(); Январь.Дата = Дата(2024,1,31);
    С = Январь.ОсновныеНачисления.Добавить(); С.Сотрудник = Сотрудник.Ссылка; С.Подразделение = Подразделение; С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф; С.ДатаНачала = Дата(2024,1,1); С.ДатаОкончания = Дата(2024,1,31);
    С = Январь.ОсновныеНачисления.Добавить(); С.Сотрудник = Руководитель.Ссылка; С.Подразделение = Подразделение; С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф; С.ДатаНачала = Дата(2024,1,1); С.ДатаОкончания = Дата(2024,1,31);
    Январь.Записать(РежимЗаписиДокумента.Проведение);
    Февраль = Документы.НачислениеЗарплаты.СоздатьДокумент(); Февраль.Дата = Дата(2024,2,29);
    С = Февраль.ОсновныеНачисления.Добавить(); С.Сотрудник = Сотрудник.Ссылка; С.Подразделение = Подразделение; С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф; С.ДатаНачала = Дата(2024,2,1); С.ДатаОкончания = Дата(2024,2,29);
    С = Февраль.ОсновныеНачисления.Добавить(); С.Сотрудник = Руководитель.Ссылка; С.Подразделение = Подразделение; С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия; С.ДатаНачала = Дата(2024,2,1); С.ДатаОкончания = Дата(2024,2,29);
    Февраль.Записать(РежимЗаписиДокумента.Проведение);
    Командировка = Документы.НачислениеЗарплаты.СоздатьДокумент(); Командировка.Дата = Дата(2024,2,29);
    С = Командировка.ОсновныеНачисления.Добавить(); С.Сотрудник = Сотрудник.Ссылка; С.Подразделение = Подразделение; С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка; С.ДатаНачала = Дата(2024,2,5); С.ДатаОкончания = Дата(2024,2,9);
    Командировка.Записать(РежимЗаписиДокумента.Проведение);
    Командировка.Записать(РежимЗаписиДокумента.ОтменаПроведения);
    ПроверитьТарифФевраля(Подразделение,Сотрудник.Ссылка,16800);
    Командировка.ОсновныеНачисления[0].ДатаНачала = Дата(2024,2,12); Командировка.ОсновныеНачисления[0].ДатаОкончания = Дата(2024,2,23);
    Командировка.Записать(РежимЗаписиДокумента.Проведение); ПроверитьТарифФевраля(Подразделение,Сотрудник.Ссылка,8800);
    Командировка.ОсновныеНачисления[0].ДатаНачала = Дата(2024,2,5); Командировка.ОсновныеНачисления[0].ДатаОкончания = Дата(2024,2,9);
    Командировка.Записать(РежимЗаписиДокумента.Проведение); ПроверитьТарифФевраля(Подразделение,Сотрудник.Ссылка,12800);
    Командировка.Записать(РежимЗаписиДокумента.Проведение); ПроверитьТарифФевраля(Подразделение,Сотрудник.Ссылка,12800);
    Командировка = Документы.НачислениеЗарплаты.СоздатьДокумент(); Командировка.Дата = Дата(2024,3,15);
    С = Командировка.ОсновныеНачисления.Добавить(); С.Сотрудник = Руководитель.Ссылка; С.Подразделение = Подразделение; С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка; С.ДатаНачала = Дата(2024,1,8); С.ДатаОкончания = Дата(2024,1,12);
    Командировка.Записать(РежимЗаписиДокумента.Проведение);
    Запрос = Новый Запрос("ВЫБРАТЬ Сотрудник, ВидРасчета, ПериодДействия, Сторно, СУММА(Результат) КАК Результат
    |ИЗ РегистрРасчета.Начисления ГДЕ Подразделение = &Подразделение
    |СГРУППИРОВАТЬ ПО Сотрудник, ВидРасчета, ПериодДействия, Сторно");
    Запрос.УстановитьПараметр("Подразделение", Подразделение); Результаты = Запрос.Выполнить().Выгрузить();
    ПроверитьНачисление(Результаты, Сотрудник.Ссылка, ПланыВидовРасчета.ОсновныеНачисления.Тариф, Дата(2024,1,1), Ложь, 18400);
    ПроверитьНачисление(Результаты, Сотрудник.Ссылка, ПланыВидовРасчета.ОсновныеНачисления.Тариф, Дата(2024,2,1), Ложь, 12800);
    ПроверитьНачисление(Результаты, Руководитель.Ссылка, ПланыВидовРасчета.ОсновныеНачисления.Премия, Дата(2024,2,1), Ложь, 1840);
    ПроверитьНачисление(Результаты, Сотрудник.Ссылка, ПланыВидовРасчета.ОсновныеНачисления.Командировка, Дата(2024,2,1), Ложь, 4000);
    ПроверитьНачисление(Результаты, Руководитель.Ссылка, ПланыВидовРасчета.ОсновныеНачисления.Тариф, Дата(2024,1,1), Истина, -8000);
КонецПроцедуры

Процедура ПроверитьНачисление(Результаты, Сотрудник, ВидРасчета, Период, Сторно, Ожидается)
    Строки = Результаты.НайтиСтроки(Новый Структура("Сотрудник,ВидРасчета,ПериодДействия,Сторно", Сотрудник, ВидРасчета, Период, Сторно));
    Если Строки.Количество() = 0 Тогда ВызватьИсключение "Нет результата контрольного начисления " + ВидРасчета; КонецЕсли;
    Если Строки[0].Результат <> Ожидается Тогда ВызватьИсключение "Контроль " + ВидРасчета + " за " + Период + ": ожидалось " + Ожидается + ", получено " + Строки[0].Результат; КонецЕсли;
КонецПроцедуры

Функция ПодготовитьФорму() Экспорт
    Вид = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); Вид.Наименование = "Срок кредита, дни"; Вид.ТипЗначения = Новый ОписаниеТипов("Число"); Вид.Записать();
    ВалютаКредита = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); ВалютаКредита.Наименование = "Валюта кредита"; ВалютаКредита.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Валюты"); ВалютаКредита.Записать();
    Регион = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); Регион.Наименование = "Регион"; Регион.ТипЗначения = Новый ОписаниеТипов("Строка"); Регион.Записать();
    Лимит = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); Лимит.Наименование = "Лимит кредита"; Лимит.ТипЗначения = Новый ОписаниеТипов("Число"); Лимит.Записать();
    Менеджер = Справочники.ФизическиеЛица.СоздатьЭлемент(); Менеджер.Наименование = "Демо: менеджер";
    С = Менеджер.ДополнительныеСведения.Добавить(); С.ВидСведения = ВалютаКредита.Ссылка;
    С = Менеджер.ДополнительныеСведения.Добавить(); С.ВидСведения = Вид.Ссылка;
    С = Менеджер.ДополнительныеСведения.Добавить(); С.ВидСведения = Регион.Ссылка; Менеджер.Записать();
    ДругойМенеджер = Справочники.ФизическиеЛица.СоздатьЭлемент(); ДругойМенеджер.Наименование = "Демо: другой менеджер";
    С = ДругойМенеджер.ДополнительныеСведения.Добавить(); С.ВидСведения = Лимит.Ссылка; ДругойМенеджер.Записать();
    Контрагент = Справочники.Контрагенты.СоздатьЭлемент(); Контрагент.Наименование = "Демо: контрагент"; Контрагент.Менеджер = Менеджер.Ссылка;
    С = Контрагент.ДополнительныеСведения.Добавить(); С.ВидСведения = Вид.Ссылка; С.Значение = 10;
    С = Контрагент.ДополнительныеСведения.Добавить(); С.ВидСведения = ВалютаКредита.Ссылка; С.Значение = Справочники.Валюты.РоссийскийРубль;
    С = Контрагент.ДополнительныеСведения.Добавить(); С.ВидСведения = Регион.Ссылка; С.Значение = "Москва"; Контрагент.Записать();
    Возврат Новый Структура("Контрагент,Вид,ИмяПоля,Менеджер,ДругойМенеджер,НовыйВид,НовоеИмяПоля", Контрагент.Ссылка, Вид.Ссылка,
        "ДопПоле_" + СтрЗаменить(Строка(Вид.Ссылка.УникальныйИдентификатор()), "-", "_"), Менеджер.Ссылка, ДругойМенеджер.Ссылка, Лимит.Ссылка,
        "ДопПоле_" + СтрЗаменить(Строка(Лимит.Ссылка.УникальныйИдентификатор()), "-", "_"));
КонецФункции

Процедура ПроверитьЗаписьФормы(Контрагент, Вид) Экспорт
    Объект = Контрагент.ПолучитьОбъект();
    СтрокаЗначения = Объект.ДополнительныеСведения.Найти(Вид,"ВидСведения");
    Если СтрокаЗначения = Неопределено Тогда ВызватьИсключение "Дополнительное поле не сохранилось"; КонецЕсли;
    Если СтрокаЗначения.Значение <> 10 Тогда ВызватьИсключение "Значение дополнительного поля не совпало"; КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьЖурнал(Путь, Текст) Экспорт
    Файл = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8); Файл.ЗаписатьСтроку(Текст); Файл.Закрыть();
КонецПроцедуры


Процедура ПроверитьТарифФевраля(Подразделение, Сотрудник, Ожидается)
    Запрос = Новый Запрос("ВЫБРАТЬ СУММА(Результат) КАК Результат ИЗ РегистрРасчета.Начисления
    |ГДЕ Подразделение = &Подразделение И Сотрудник = &Сотрудник И ВидРасчета = ЗНАЧЕНИЕ(ПланВидовРасчета.ОсновныеНачисления.Тариф) И ПериодДействия = ДАТАВРЕМЯ(2024,2,1)");
    Запрос.УстановитьПараметр("Подразделение", Подразделение); Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
    Результат = Запрос.Выполнить().Выгрузить()[0].Результат;
    Если Результат <> Ожидается Тогда ВызватьИсключение "Ошибка отмены/перепроведения зарплаты: ожидалось " + Ожидается + ", получено " + Результат; КонецЕсли;
КонецПроцедуры

Процедура СформироватьОбразцы(Папка) Экспорт
    З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Подразделения ГДЕ Наименование = &Имя УПОРЯДОЧИТЬ ПО Код УБЫВ");
    З.УстановитьПараметр("Имя","Демо: основной цех"); Т = З.Выполнить().Выгрузить();
    Если Т.Количество() = 0 Тогда ВызватьИсключение "Сначала заполните демонстрационные данные"; КонецЕсли;
    Подразделение = Т[0].Ссылка; Начало = Дата(2024,1,1); Конец = Дата(2024,3,31);
    Данные = Отчеты.ВедомостьОУ.Создать().Данные(Начало,Конец,Подразделение); ТабДок = Новый ТабличныйДокумент;
    УчетСервер.НарисоватьОтчет(ТабДок,Данные,"ВедомостьОУ",Начало,Конец,Подразделение); ТабДок.Записать(Папка+"/ou-statement.pdf",ТипФайлаТабличногоДокумента.PDF);
    Данные = Отчеты.ПродажиОУ.Создать().Данные(Начало,Конец); ТабДок = Новый ТабличныйДокумент;
    УчетСервер.НарисоватьОтчет(ТабДок,Данные,"ПродажиОУ",Начало,Конец); ТабДок.Записать(Папка+"/ou-sales.pdf",ТипФайлаТабличногоДокумента.PDF);
    Данные = Отчеты.ПродажиБУ.Создать().Данные(Начало,Конец); ТабДок = Новый ТабличныйДокумент;
    УчетСервер.НарисоватьОтчет(ТабДок,Данные,"ПродажиБУ",Начало,Конец); ТабДок.Записать(Папка+"/bu-sales.pdf",ТипФайлаТабличногоДокумента.PDF);
    Начало = Дата(2024,2,1); Конец = Дата(2024,2,29); Данные = Отчеты.Премии.Создать().Данные(Начало,Конец); ТабДок = Новый ТабличныйДокумент;
    УчетСервер.НарисоватьОтчет(ТабДок,Данные,"Премии",Начало,Конец); ТабДок.Записать(Папка+"/pr-bonus.pdf",ТипФайлаТабличногоДокумента.PDF);
КонецПроцедуры
