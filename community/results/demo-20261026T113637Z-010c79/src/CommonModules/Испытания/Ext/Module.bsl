Функция НовыйСправочник(Менеджер, Имя)
    Объект = Менеджер.СоздатьЭлемент(); Объект.Наименование = Имя; Объект.Записать(); Возврат Объект.Ссылка;
КонецФункции

Процедура Равно(Значение, Ожидание, Контекст)
    Если Значение <> Ожидание Тогда ВызватьИсключение Контекст + ": ожидалось " + Ожидание + ", получено " + Значение; КонецЕсли;
КонецПроцедуры

Процедура Политика(Подразделение, Метод)
    Запись = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи(); Запись.Период = Дата(2024,1,1); Запись.Подразделение = Подразделение; Запись.Метод = Метод; Запись.Записать();
КонецПроцедуры

Функция Приход(Товар, Свойство, Подразделение, Склад, Количество, Сумма, День)
    Д = Документы.ПриходнаяНакладная.СоздатьДокумент(); Д.Дата = Дата(2024,4,День,9,0,0); Д.Подразделение = Подразделение; Д.Склад = Склад;
    С = Д.СписокНоменклатуры.Добавить(); С.Номенклатура = Товар; С.Свойство = Свойство; С.Количество = Количество; С.Сумма = Сумма;
    Д.Записать(РежимЗаписиДокумента.Проведение); Возврат Д;
КонецФункции

Функция Продажа(Товар, Свойство, Подразделение, Склад, Количество, Сумма, Дубль = 0)
    Д = Документы.РасходнаяНакладная.СоздатьДокумент(); Д.Дата = Дата(2024,4,20,9,0,0);
    Д.Склад = Склад; С = Д.СписокНоменклатуры.Добавить(); С.Номенклатура = Товар; С.Свойство = Свойство; С.Подразделение = Подразделение; С.Количество = Количество; С.Сумма = Сумма;
    Если Дубль <> 0 Тогда С = Д.СписокНоменклатуры.Добавить(); С.Номенклатура = Товар; С.Свойство = Свойство; С.Подразделение = Подразделение; С.Количество = Дубль; С.Сумма = Дубль*1000; КонецЕсли;
    Возврат Д;
КонецФункции

Процедура ПроверитьОстатокОУ(Подразделение, Товар, Количество, Сумма)
    З = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(СУММА(КоличествоОстаток),0) КАК Количество, ЕСТЬNULL(СУММА(СтоимостьОстаток),0) КАК Стоимость
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(, Подразделение = &Подразделение И Номенклатура = &Товар)");
    З.УстановитьПараметр("Подразделение",Подразделение); З.УстановитьПараметр("Товар",Товар); С = З.Выполнить().Выгрузить()[0];
    Равно(С.Количество,Количество,"ОУ количество"); Равно(С.Стоимость,Сумма,"ОУ стоимость");
КонецПроцедуры

Процедура ПроверитьМетод(Метод, СтоимостьШести, СтоимостьСеми)
    Подразделение = НовыйСправочник(Справочники.Подразделения,"Тест: " + Метод); Политика(Подразделение,Метод);
    Товар = НовыйСправочник(Справочники.Номенклатура,"Тест партий " + Метод);
    Свойство = НовыйСправочник(Справочники.СвойстваНоменклатуры,"Тест свойства"); ПустойСклад = Справочники.Склады.ПустаяСсылка();
    П1 = Приход(Товар,Свойство,Подразделение,ПустойСклад,10,1000,1); П2 = Приход(Товар,Свойство,Подразделение,ПустойСклад,10,3000,2);
    П1.Записать(РежимЗаписиДокумента.Проведение); ПроверитьОстатокОУ(Подразделение,Товар,20,4000);
    Д = Продажа(Товар,Свойство,Подразделение,ПустойСклад,3,3000,3); Д.Записать(РежимЗаписиДокумента.Проведение);
