    Д.СписокНоменклатуры[0].Количество = 4; Д.Записать(РежимЗаписиДокумента.Проведение); ПроверитьОстатокОУ(Подразделение,Товар,13,4000-СтоимостьСеми);
    Д.Записать(РежимЗаписиДокумента.ОтменаПроведения); ПроверитьОстатокОУ(Подразделение,Товар,20,4000);
    Д.СписокНоменклатуры.Очистить(); С = Д.СписокНоменклатуры.Добавить(); С.Номенклатура = Товар; С.Свойство = Свойство; С.Подразделение = Подразделение; С.Количество = 20; С.Сумма = 20000;
    Д.Записать(РежимЗаписиДокумента.Проведение); ПроверитьОстатокОУ(Подразделение,Товар,0,0);
