Функция Запустить(ПутьЖурнала) Экспорт
    Текст = "";
    Попытка
        ПроверитьМетод(Перечисления.УчетнаяПолитика.ФИФО,600,700); Текст = Текст + "FIFO, дубли, перепроведение, закрытие партий: OK" + Символы.ПС;
        ПроверитьМетод(Перечисления.УчетнаяПолитика.ЛИФО,1800,2100); Текст = Текст + "LIFO, дубли, перепроведение, закрытие партий: OK" + Символы.ПС;
        ПроверитьМетод(Перечисления.УчетнаяПолитика.Средняя,1200,1400); Текст = Текст + "Средняя, дубли, перепроведение, закрытие партий: OK" + Символы.ПС;
        ПроверитьОкругление(); Текст = Текст + "Средняя: округление копеек без отрицательной стоимости партий: OK" + Символы.ПС;
        ПроверитьСборку(); Текст = Текст + "Сборка, дополнительные детали, недельная спецификация, отмена: OK" + Символы.ПС;
        ПроверитьНесколькоПериодов(); Текст = Текст + "Зарплата нескольких периодов в одном документе: OK" + Символы.ПС;
        ПроверитьСовместительство(); Текст = Текст + "Совместительство, разные графики, история ставок, стаж, вытеснение премии: OK" + Символы.ПС;
        ПроверитьБухгалтерию(); Текст = Текст + "БУ: средняя между складами, ручная операция, транзитивные аналоги, дубли, дефицит, отчет, закрытие: OK" + Символы.ПС;
    Исключение
        Текст = Текст + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;
    Демонстрация.ЗаписатьЖурнал(ПутьЖурнала,Текст); Возврат Текст;
КонецФункции

