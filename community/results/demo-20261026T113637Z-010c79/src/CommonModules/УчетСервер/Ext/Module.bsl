// Общие правила проведения. Чтение регистров выполняется пакетами вне циклов строк.
Процедура НастроитьУчет() Экспорт
    Товары = ПланыСчетов.Управленческий.Товары.ПолучитьОбъект();
    Если Не Товары.КоличественныйУчет Тогда Товары.КоличественныйУчет = Истина; Товары.Записать(); КонецЕсли;
    Если Товары.ВидыСубконто.Количество() = 0 Тогда
        С = Товары.ВидыСубконто.Добавить();
        С.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура;
        С.Суммовой = Истина; С.Количественный = Истина;
        С = Товары.ВидыСубконто.Добавить();
        С.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Склады;
        С.Суммовой = Ложь; С.Количественный = Истина;
        Товары.Записать();
    КонецЕсли;
    Прибыль = ПланыСчетов.Управленческий.ПрибылиУбытки.ПолучитьОбъект();
    Если Прибыль.ВидыСубконто.Количество() = 0 Тогда
        С = Прибыль.ВидыСубконто.Добавить(); С.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Заказано; С.ТолькоОбороты = Истина; С.Суммовой = Истина; С.Количественный = Истина;
        С = Прибыль.ВидыСубконто.Добавить(); С.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Продано; С.ТолькоОбороты = Истина; С.Суммовой = Истина; С.Количественный = Истина;
        Прибыль.Записать();
    КонецЕсли;
КонецПроцедуры

Процедура Заблокировать(ИмяРегистра) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить(ИмяРегистра);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПроверитьСтроки(Строки) Экспорт
    Для Каждого Строка Из Строки Цикл
        Если Не ЗначениеЗаполнено(Строка.Номенклатура) Или Строка.Количество <= 0 Тогда
            ВызватьИсключение "Необходимо указать номенклатуру и положительное количество (строка " + Строка.НомерСтроки + ").";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция СуммаСтроки(Строка) Экспорт
    Если Строка.Сумма <> 0 Тогда Возврат Строка.Сумма; КонецЕсли;
    Возврат Окр(Строка.Количество * Строка.Цена, 2);
КонецФункции

Функция ОстаткиОУ(Момент, Подразделения, Номенклатура) Экспорт
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия,
    |КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент,
    |Подразделение В (&Подразделения) И Номенклатура В (&Номенклатура))
    |УПОРЯДОЧИТЬ ПО Партия.МоментВремени");
    Запрос.УстановитьПараметр("Момент", Момент);
    Запрос.УстановитьПараметр("Подразделения", Подразделения);
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    // Таблица нужна как изменяемый общий резерв по всем строкам, включая дубли.
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция Политики(ДатаДокумента, Подразделения) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ Подразделение, Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение В (&Подразделения))");
    Запрос.УстановитьПараметр("Дата", ДатаДокумента);
    Запрос.УстановитьПараметр("Подразделения", Подразделения);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция МетодПодразделения(ТаблицаПолитик, Подразделение) Экспорт
    Строка = ТаблицаПолитик.Найти(Подразделение, "Подразделение");
    Если Строка = Неопределено Тогда
        ВызватьИсключение "Не задана учетная политика подразделения " + Подразделение;
    КонецЕсли;
    Возврат Строка.Метод;
КонецФункции

Функция СписатьОУ(Набор, Остатки, Подразделение, Номенклатура, Свойство, Количество, Метод, ДатаДвижения) Экспорт
    Отбор = Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Номенклатура, Свойство);
    ВсеПартии = Остатки.НайтиСтроки(Отбор); Партии = Новый Массив;
    Для Каждого Партия Из ВсеПартии Цикл Если Партия.Количество > 0 Тогда Партии.Добавить(Партия); КонецЕсли; КонецЦикла;
    ВсегоКоличество = 0; ВсегоСтоимость = 0;
    Для Каждого Партия Из Партии Цикл
        ВсегоКоличество = ВсегоКоличество + Партия.Количество;
        ВсегоСтоимость = ВсегоСтоимость + Партия.Стоимость;
    КонецЦикла;
    Если ВсегоКоличество < Количество Тогда
        ВызватьИсключение "Недостаточно " + Номенклатура + " (" + Свойство + ") в подразделении " + Подразделение
        + ". Требуется " + Количество + ", остаток " + ВсегоКоличество;
    КонецЕсли;
    КСписанию = Количество; Стоимость = 0; Корректировки = Новый Массив;
    Средняя = Метод = Перечисления.УчетнаяПолитика.Средняя;
    ПлановаяСтоимость = Окр(ВсегоСтоимость * Количество / ВсегоКоличество, 2);
    Для Индекс = 0 По Партии.Количество() - 1 Цикл
        Номер = ?(Метод = Перечисления.УчетнаяПолитика.ЛИФО, Партии.Количество() - 1 - Индекс, Индекс);
        Партия = Партии[Номер];
        Если Партия.Количество <= 0 Тогда Продолжить; КонецЕсли;
        Если Средняя И Индекс < Партии.Количество() - 1 Тогда
            КоличествоПартии = Мин(КСписанию, Партия.Количество, Окр(Количество * Партия.Количество / ВсегоКоличество, 3));
        Иначе
            КоличествоПартии = Мин(КСписанию, Партия.Количество);
        КонецЕсли;
        Если КоличествоПартии = 0 Тогда Продолжить; КонецЕсли;
        Если КоличествоПартии = Партия.Количество Тогда
            Сумма = Партия.Стоимость;
        Иначе
            Сумма = Окр(Партия.Стоимость * КоличествоПартии / Партия.Количество, 2);
        КонецЕсли;
        Движение = Набор.Добавить(); Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
        Движение.Период = ДатаДвижения; Движение.Подразделение = Подразделение;
        Движение.Номенклатура = Номенклатура; Движение.Свойство = Свойство; Движение.Партия = Партия.Партия;
        Движение.Количество = КоличествоПартии; Движение.Стоимость = Сумма;
        Партия.Количество = Партия.Количество - КоличествоПартии; Партия.Стоимость = Партия.Стоимость - Сумма;
        Стоимость = Стоимость + Сумма; КСписанию = КСписанию - КоличествоПартии;
        Если Партия.Количество > 0 Тогда Корректировки.Добавить(Новый Структура("Партия,Движение",Партия,Движение)); КонецЕсли;
        Если КСписанию = 0 Тогда Прервать; КонецЕсли;
    КонецЦикла;
    Если КСписанию <> 0 Тогда ВызватьИсключение "Ошибка распределения партий"; КонецЕсли;
    Если Средняя Тогда
        Разница = ПлановаяСтоимость - Стоимость;
        Для Каждого Корректировка Из Корректировки Цикл
            Если Разница = 0 Тогда Прервать; КонецЕсли;
            Поправка = ?(Разница > 0, Мин(Разница,Корректировка.Партия.Стоимость), Макс(Разница,-Корректировка.Движение.Стоимость));
            Корректировка.Партия.Стоимость = Корректировка.Партия.Стоимость - Поправка;
            Корректировка.Движение.Стоимость = Корректировка.Движение.Стоимость + Поправка;
            Стоимость = Стоимость + Поправка; Разница = Разница - Поправка;
        КонецЦикла;
    КонецЕсли;
    Возврат Стоимость;
КонецФункции

Процедура Приход(ДокументОбъект) Экспорт
    НастроитьУчет();
    Если ДокументОбъект.СписокНоменклатуры.Количество() = 0 Тогда ВызватьИсключение "Накладная не содержит товаров"; КонецЕсли;
    ПроверитьСтроки(ДокументОбъект.СписокНоменклатуры);
    Движения = ДокументОбъект.Движения;
    Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Движения.Хозрасчетный.Записывать = Истина; Движения.Хозрасчетный.Очистить(); Движения.ОстаткиНоменклатуры.Очистить();
    Для Каждого Строка Из ДокументОбъект.СписокНоменклатуры Цикл
        Сумма = СуммаСтроки(Строка);
        Если Сумма < 0 Тогда ВызватьИсключение "Сумма прихода не может быть отрицательной"; КонецЕсли;
        Подразделение = ?(ЗначениеЗаполнено(Строка.Подразделение), Строка.Подразделение, ДокументОбъект.Подразделение);
        Если ЗначениеЗаполнено(Подразделение) Тогда
            Д = Движения.ОстаткиНоменклатуры.Добавить(); Д.Период = ДокументОбъект.Дата;
            Д.ВидДвижения = ВидДвиженияНакопления.Приход; Д.Подразделение = Подразделение;
            Д.Номенклатура = Строка.Номенклатура; Д.Свойство = Строка.Свойство;
            Д.Партия = ДокументОбъект.Ссылка; Д.Количество = Строка.Количество; Д.Стоимость = Сумма;
        КонецЕсли;
        Если ЗначениеЗаполнено(ДокументОбъект.Склад) Тогда
            Д = Движения.Хозрасчетный.Добавить(); Д.Период = ДокументОбъект.Дата;
            Д.СчетДт = ПланыСчетов.Управленческий.Товары; Д.СчетКт = ПланыСчетов.Управленческий.Поставщики;
            Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Строка.Номенклатура;
            Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = ДокументОбъект.Склад;
            Д.КоличествоДт = Строка.Количество; Д.Сумма = Сумма;
        КонецЕсли;
        Если Не ЗначениеЗаполнено(Подразделение) И Не ЗначениеЗаполнено(ДокументОбъект.Склад) Тогда
            ВызватьИсключение "Укажите подразделение для оперативного или склад для бухгалтерского учета";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция СвязиАналогов()
    Запрос = Новый Запрос("ВЫБРАТЬ Номенклатура, Аналог ИЗ РегистрСведений.Аналоги");
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ГруппаАналогов(Товар, Связи, СправочникТоваров)
    Группа = Новый Массив; Группа.Добавить(Товар);
    Позиция = 0;
    Пока Позиция < Группа.Количество() Цикл
        Текущий = Группа[Позиция];
        Для Каждого Связь Из Связи Цикл
            Другой = Неопределено;
            Если Связь.Номенклатура = Текущий Тогда Другой = Связь.Аналог;
            ИначеЕсли Связь.Аналог = Текущий Тогда Другой = Связь.Номенклатура; КонецЕсли;
            Если Другой <> Неопределено И Группа.Найти(Другой) = Неопределено Тогда Группа.Добавить(Другой); КонецЕсли;
        КонецЦикла;
        Позиция = Позиция + 1;
    КонецЦикла;
    Упорядочено = Новый Массив; Упорядочено.Добавить(Товар);
    Для Каждого С Из СправочникТоваров Цикл
        Если С.Ссылка <> Товар И Группа.Найти(С.Ссылка) <> Неопределено Тогда Упорядочено.Добавить(С.Ссылка); КонецЕсли;
    КонецЦикла;
    Возврат Упорядочено;
КонецФункции

Процедура Продажа(ДокументОбъект) Экспорт
    НастроитьУчет();
    Если ДокументОбъект.СписокНоменклатуры.Количество() = 0 Тогда ВызватьИсключение "Накладная не содержит товаров"; КонецЕсли;
    ПроверитьСтроки(ДокументОбъект.СписокНоменклатуры);
    Движения = ДокументОбъект.Движения;
    Движения.ОстаткиНоменклатуры.Записывать = Истина; Движения.ОстаткиНоменклатуры.Очистить();
    Движения.ПродажиОУ.Записывать = Истина; Движения.ПродажиОУ.Очистить();
    Движения.Хозрасчетный.Записывать = Истина; Движения.Хозрасчетный.Очистить();
    Заблокировать("РегистрНакопления.ОстаткиНоменклатуры");
    Заблокировать("РегистрБухгалтерии.Хозрасчетный");
    Движения.Записать();
    Движения.ОстаткиНоменклатуры.Записывать = Истина; Движения.ПродажиОУ.Записывать = Истина; Движения.Хозрасчетный.Записывать = Истина; // Старые движения исключаются из остатков при перепроведении.
    Подразделения = ДокументОбъект.СписокНоменклатуры.ВыгрузитьКолонку("Подразделение"); Подразделения.Добавить(ДокументОбъект.Подразделение);
    Товары = ДокументОбъект.СписокНоменклатуры.ВыгрузитьКолонку("Номенклатура");
    ГраницаДокумента = Новый Граница(ДокументОбъект.МоментВремени(), ВидГраницы.Исключая);
    Остатки = ОстаткиОУ(ГраницаДокумента, Подразделения, Товары);
    ТаблицаПолитик = Политики(ДокументОбъект.Дата, Подразделения);
    Если ЗначениеЗаполнено(ДокументОбъект.Склад) Тогда
        Связи = СвязиАналогов();
        Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Артикул ИЗ Справочник.Номенклатура ГДЕ НЕ ЭтоГруппа УПОРЯДОЧИТЬ ПО Артикул, Ссылка");
        СправочникТоваров = Запрос.Выполнить().Выгрузить();
        ВидыСубконто = Новый Массив; ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
        Запрос = Новый Запрос("ВЫБРАТЬ Субконто1 КАК Номенклатура, СуммаОстаток КАК Стоимость, КоличествоОстаток КАК Количество
        |ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Момент, Счет = &Счет, &Виды, )");
        Запрос.УстановитьПараметр("Момент", ГраницаДокумента); Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары);
        Запрос.УстановитьПараметр("Виды", ВидыСубконто); ОбщиеОстатки = Запрос.Выполнить().Выгрузить();
        ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склады);
        Запрос.Текст = "ВЫБРАТЬ Субконто1 КАК Номенклатура, КоличествоОстаток КАК Количество
        |ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Момент, Счет = &Счет, &Виды, Субконто2 = &Склад)";
        Запрос.УстановитьПараметр("Виды", ВидыСубконто); Запрос.УстановитьПараметр("Склад", ДокументОбъект.Склад);
        СкладскиеОстатки = Запрос.Выполнить().Выгрузить();
    КонецЕсли;
    Для Каждого Строка Из ДокументОбъект.СписокНоменклатуры Цикл
        Выручка = СуммаСтроки(Строка);
        Подразделение = ?(ЗначениеЗаполнено(Строка.Подразделение), Строка.Подразделение, ДокументОбъект.Подразделение);
        Если ЗначениеЗаполнено(Подразделение) Тогда
            Метод = МетодПодразделения(ТаблицаПолитик, Подразделение);
            Стоимость = СписатьОУ(Движения.ОстаткиНоменклатуры, Остатки, Подразделение, Строка.Номенклатура,
                Строка.Свойство, Строка.Количество, Метод, ДокументОбъект.Дата);
            Д = Движения.ПродажиОУ.Добавить(); Д.Период = ДокументОбъект.Дата;
            Д.Номенклатура = Строка.Номенклатура; Д.Подразделение = Подразделение;
            Д.Количество = Строка.Количество; Д.Себестоимость = Стоимость; Д.Выручка = Выручка;
        КонецЕсли;
        Если ЗначениеЗаполнено(ДокументОбъект.Склад) Тогда
            Аналоги = ГруппаАналогов(Строка.Номенклатура, Связи, СправочникТоваров);
            Осталось = Строка.Количество; ОсталосьВыручки = Выручка;
            Для Каждого Товар Из Аналоги Цикл
                Складской = СкладскиеОстатки.Найти(Товар, "Номенклатура");
                Общий = ОбщиеОстатки.Найти(Товар, "Номенклатура");
                Если Складской = Неопределено Или Общий = Неопределено Тогда Продолжить; КонецЕсли;
                Если Складской.Количество <= 0 Или Общий.Количество <= 0 Тогда Продолжить; КонецЕсли;
                Количество = Мин(Осталось, Складской.Количество);
                Сумма = ?(Количество = Общий.Количество, Общий.Стоимость, Окр(Общий.Стоимость * Количество / Общий.Количество, 2));
                ЧастьВыручки = ?(Количество = Осталось, ОсталосьВыручки, Окр(Выручка * Количество / Строка.Количество, 2));
                Д = Движения.Хозрасчетный.Добавить(); Д.Период = ДокументОбъект.Дата;
                Д.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки; Д.СчетКт = ПланыСчетов.Управленческий.Товары;
                Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Товар;
                Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = ДокументОбъект.Склад;
                Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Заказано] = Строка.Номенклатура;
                Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Продано] = Товар;
                Д.КоличествоКт = Количество; Д.Сумма = Сумма;
                Д = Движения.Хозрасчетный.Добавить(); Д.Период = ДокументОбъект.Дата;
                Д.СчетДт = ПланыСчетов.Управленческий.Покупатели; Д.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
                Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Заказано] = Строка.Номенклатура;
                Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Продано] = Товар; Д.Сумма = ЧастьВыручки;
                Общий.Количество = Общий.Количество - Количество; Общий.Стоимость = Общий.Стоимость - Сумма;
                Складской.Количество = Складской.Количество - Количество;
                Осталось = Осталось - Количество; ОсталосьВыручки = ОсталосьВыручки - ЧастьВыручки;
                Если Осталось = 0 Тогда Прервать; КонецЕсли;
            КонецЦикла;
            Если Осталось <> 0 Тогда ВызватьИсключение "Недостаточно товара " + Строка.Номенклатура + " и его аналогов на складе " + ДокументОбъект.Склад; КонецЕсли;
        КонецЕсли;
        Если Не ЗначениеЗаполнено(Подразделение) И Не ЗначениеЗаполнено(ДокументОбъект.Склад) Тогда ВызватьИсключение "Не задан склад или подразделение"; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура Сборка(ДокументОбъект) Экспорт
    ПроверитьСтроки(ДокументОбъект.СистемныеБлоки); ПроверитьСтроки(ДокументОбъект.ДополнительныеДетали);
    Если Не ЗначениеЗаполнено(ДокументОбъект.ПодразделениеИсточник) Или Не ЗначениеЗаполнено(ДокументОбъект.ПодразделениеПолучатель) Тогда
        ВызватьИсключение "Укажите подразделения списания деталей и поступления блоков";
    КонецЕсли;
    Подразделения = Новый Массив; Подразделения.Добавить(ДокументОбъект.ПодразделениеИсточник);
    ТаблицаПолитик = Политики(ДокументОбъект.Дата, Подразделения);
    Метод = МетодПодразделения(ТаблицаПолитик, ДокументОбъект.ПодразделениеИсточник);
    Блоки = ДокументОбъект.СистемныеБлоки.ВыгрузитьКолонку("Номенклатура");
    Запрос = Новый Запрос("ВЫБРАТЬ С.СистемныйБлок, С.Деталь, С.Свойство, С.Количество
    |ИЗ РегистрСведений.Спецификации КАК С
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ СистемныйБлок, МАКСИМУМ(Период) КАК Период
    |ИЗ РегистрСведений.Спецификации ГДЕ Период <= &Дата И СистемныйБлок В (&Блоки)
    |СГРУППИРОВАТЬ ПО СистемныйБлок) КАК Актуальные
    |ПО С.СистемныйБлок = Актуальные.СистемныйБлок И С.Период = Актуальные.Период
    |ГДЕ С.Количество > 0");
    Запрос.УстановитьПараметр("Дата", ДокументОбъект.Дата); Запрос.УстановитьПараметр("Блоки", Блоки);
    Спецификации = Запрос.Выполнить().Выгрузить();
    Товары = Спецификации.ВыгрузитьКолонку("Деталь");
    Для Каждого Строка Из ДокументОбъект.ДополнительныеДетали Цикл Товары.Добавить(Строка.Номенклатура); КонецЦикла;
    Движения = ДокументОбъект.Движения; Движения.ОстаткиНоменклатуры.Записывать = Истина; Движения.ОстаткиНоменклатуры.Очистить();
    Заблокировать("РегистрНакопления.ОстаткиНоменклатуры"); Движения.Записать();
    Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Остатки = ОстаткиОУ(Новый Граница(ДокументОбъект.МоментВремени(), ВидГраницы.Исключая), Подразделения, Товары);
    ДопСтоимость = 0; КоличествоБлоков = ДокументОбъект.СистемныеБлоки.Итог("Количество");
    Если КоличествоБлоков = 0 Тогда ВызватьИсключение "Не указаны собираемые блоки"; КонецЕсли;
    Для Каждого Строка Из ДокументОбъект.ДополнительныеДетали Цикл
        ДопСтоимость = ДопСтоимость + СписатьОУ(Движения.ОстаткиНоменклатуры, Остатки, ДокументОбъект.ПодразделениеИсточник,
        Строка.Номенклатура, Строка.Свойство, Строка.Количество, Метод, ДокументОбъект.Дата);
    КонецЦикла;
    РаспределеноДоп = 0; НомерСтроки = 0;
    Для Каждого Строка Из ДокументОбъект.СистемныеБлоки Цикл
        НомерСтроки = НомерСтроки + 1; Стоимость = 0;
        Состав = Спецификации.НайтиСтроки(Новый Структура("СистемныйБлок", Строка.Номенклатура));
        Если Состав.Количество() = 0 Тогда ВызватьИсключение "Нет актуальной спецификации для " + Строка.Номенклатура; КонецЕсли;
        Для Каждого Деталь Из Состав Цикл
            Если Деталь.Деталь = Строка.Номенклатура Тогда ВызватьИсключение "Системный блок не может входить в собственную спецификацию"; КонецЕсли;
            Стоимость = Стоимость + СписатьОУ(Движения.ОстаткиНоменклатуры, Остатки, ДокументОбъект.ПодразделениеИсточник,
            Деталь.Деталь, Деталь.Свойство, Деталь.Количество * Строка.Количество, Метод, ДокументОбъект.Дата);
        КонецЦикла;
        ЧастьДоп = ?(НомерСтроки = ДокументОбъект.СистемныеБлоки.Количество(), ДопСтоимость - РаспределеноДоп, Окр(ДопСтоимость * Строка.Количество / КоличествоБлоков, 2));
        РаспределеноДоп = РаспределеноДоп + ЧастьДоп;
        Д = Движения.ОстаткиНоменклатуры.Добавить(); Д.Период = ДокументОбъект.Дата; Д.ВидДвижения = ВидДвиженияНакопления.Приход;
        Д.Подразделение = ДокументОбъект.ПодразделениеПолучатель; Д.Номенклатура = Строка.Номенклатура;
        Д.Партия = ДокументОбъект.Ссылка; Д.Количество = Строка.Количество; Д.Стоимость = Стоимость + ЧастьДоп;
    КонецЦикла;
КонецПроцедуры

Процедура Операция(ДокументОбъект) Экспорт
    НастроитьУчет(); ДокументОбъект.Движения.Хозрасчетный.Записывать = Истина; ДокументОбъект.Движения.Хозрасчетный.Очистить();
    Если ДокументОбъект.Проводки.Количество() = 0 Тогда ВызватьИсключение "Не введены проводки"; КонецЕсли;
    Счета = ДокументОбъект.Проводки.ВыгрузитьКолонку("СчетДт");
    Для Каждого Строка Из ДокументОбъект.Проводки Цикл Счета.Добавить(Строка.СчетКт); КонецЦикла;
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка КАК Счет, НомерСтроки, ВидСубконто ИЗ ПланСчетов.Управленческий.ВидыСубконто ГДЕ Ссылка В (&Счета)");
    Запрос.УстановитьПараметр("Счета",Счета); АналитикаСчетов = Запрос.Выполнить().Выгрузить();
    Для Каждого Строка Из ДокументОбъект.Проводки Цикл
        Если Не ЗначениеЗаполнено(Строка.СчетДт) Или Не ЗначениеЗаполнено(Строка.СчетКт) Тогда ВызватьИсключение "Укажите оба счета проводки"; КонецЕсли;
        Д = ДокументОбъект.Движения.Хозрасчетный.Добавить(); Д.Период = ДокументОбъект.Дата;
        Д.СчетДт = Строка.СчетДт; Д.СчетКт = Строка.СчетКт; Д.Сумма = Строка.Сумма;
        Д.КоличествоДт = Строка.КоличествоДт; Д.КоличествоКт = Строка.КоличествоКт;
        ВидыДт = АналитикаСчетов.НайтиСтроки(Новый Структура("Счет",Д.СчетДт));
        Для Каждого Вид Из ВидыДт Цикл
            ЗначениеСубконто = Строка["СубконтоДт"+Строка(Вид.НомерСтроки)];
            Если ЗначениеЗаполнено(ЗначениеСубконто) Тогда Д.СубконтоДт[Вид.ВидСубконто] = ЗначениеСубконто; КонецЕсли;
        КонецЦикла;
        ВидыКт = АналитикаСчетов.НайтиСтроки(Новый Структура("Счет",Д.СчетКт));
        Для Каждого Вид Из ВидыКт Цикл
            ЗначениеСубконто = Строка["СубконтоКт"+Строка(Вид.НомерСтроки)];
            Если ЗначениеЗаполнено(ЗначениеСубконто) Тогда Д.СубконтоКт[Вид.ВидСубконто] = ЗначениеСубконто; КонецЕсли;
        КонецЦикла;
        Если Д.СчетДт = ПланыСчетов.Управленческий.Товары И ЗначениеЗаполнено(Строка.НоменклатураДт) Тогда
            Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Строка.НоменклатураДт;
            Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Строка.СкладДт;
        КонецЕсли;
        Если Д.СчетКт = ПланыСчетов.Управленческий.Товары И ЗначениеЗаполнено(Строка.НоменклатураКт) Тогда
            Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Строка.НоменклатураКт;
            Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Строка.СкладКт;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ЯчейкаОтчета(ТабДок, Строка, Колонка, Значение, Жирный = Ложь)
    Область = ТабДок.Область(Строка, Колонка);
    Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
    Если ТипЗнч(Значение) = Тип("Число") Тогда
        Область.СодержитЗначение = Истина; Область.Значение = Значение; Область.Формат = "ЧДЦ=2;ЧН=;ЧГ=0";
    Иначе Область.Текст = Строка(Значение); КонецЕсли;
    Если Жирный Тогда Область.Шрифт = Новый Шрифт(, , Истина); КонецЕсли;
КонецПроцедуры

Процедура НарисоватьОтчет(ТабДок, Данные, ВидОтчета, Начало, Конец, Подразделение = Неопределено) Экспорт
    Если ВидОтчета = "ВедомостьОУ" Тогда Заголовки = СтрРазделить("Производитель,Товар,Нач. остаток,Приход,Расход,Кон. остаток",",");
    ИначеЕсли ВидОтчета = "ПродажиБУ" Тогда Заголовки = СтрРазделить("Номенклатура,Продано,Кол-во,Себестоимость,Продажа,Прибыль",",");
    ИначеЕсли ВидОтчета = "Премии" Тогда Заголовки = СтрРазделить("Сотрудник,Трудовой стаж,% премии,Сумма премии",",");
    Иначе Заголовки = СтрРазделить("Номенклатура,Кол-во,Себестоимость,Продажа,Прибыль",","); КонецЕсли;
    Название = ?(ВидОтчета = "ВедомостьОУ", "Ведомость по подразделению", ?(ВидОтчета = "Премии", "Премии", "Продажи"));
    Если ВидОтчета = "ВедомостьОУ" И ЗначениеЗаполнено(Подразделение) Тогда Название = Название + " «" + Подразделение + "»"; КонецЕсли;
    Суммы = СтрРазделить("НачальныйОстаток,Приход,Расход,КонечныйОстаток",",");
    ТабДок.Область(1,1,1,Заголовки.Количество()).Объединить();
    ЯчейкаОтчета(ТабДок,1,1,Название,Истина);
    ТабДок.Область(2,1,2,Заголовки.Количество()).Объединить();
    ЯчейкаОтчета(ТабДок,2,1,?(ВидОтчета = "Премии", "Месяц: " + Формат(Начало,"ДФ=MMMM") + " " + Формат(Начало,"ДФ=yyyy") + " г.", "С " + Формат(Начало,"ДФ=dd.MM.yyyy") + " по " + Формат(Конец,"ДФ=dd.MM.yyyy")));
    Для Индекс = 0 По Заголовки.Количество()-1 Цикл
        ЯчейкаОтчета(ТабДок,4,Индекс+1,Заголовки[Индекс],Истина);
        ТабДок.Область(,Индекс+1,,Индекс+1).ШиринаКолонки = ?(Индекс = 0 Или (ВидОтчета = "ВедомостьОУ" И Индекс = 1) Или (ВидОтчета = "ПродажиБУ" И Индекс = 1),30,16);
    КонецЦикла;
    Стр = 5; ПредыдущаяГруппа = Неопределено;
    Для Каждого ДанныеСтроки Из Данные Цикл
        Если ВидОтчета = "ВедомостьОУ" Тогда
            Если ПредыдущаяГруппа <> ДанныеСтроки.Производитель Тогда
                ЯчейкаОтчета(ТабДок,Стр,1,?(ЗначениеЗаполнено(ДанныеСтроки.Производитель),ДанныеСтроки.Производитель,"Не указан"),Истина); ПредыдущаяГруппа = ДанныеСтроки.Производитель; Стр = Стр+1;
            КонецЕсли;
            ЯчейкаОтчета(ТабДок,Стр,2,Строка(ДанныеСтроки.Номенклатура) + ?(ЗначениеЗаполнено(ДанныеСтроки.Характеристика), " (" + ДанныеСтроки.Характеристика + ")", ""));
            Имена = СтрРазделить("НачальноеКоличество,ПриходКоличество,РасходКоличество,КонечноеКоличество",",");
            Суммы = СтрРазделить("НачальныйОстаток,Приход,Расход,КонечныйОстаток",",");
            Для Индекс = 0 По 3 Цикл
                ЯчейкаОтчета(ТабДок,Стр,Индекс+3,ДанныеСтроки[Имена[Индекс]]);
                ЯчейкаОтчета(ТабДок,Стр+1,Индекс+3,ДанныеСтроки[Суммы[Индекс]]);
            КонецЦикла;
            Стр = Стр+2;
        ИначеЕсли ВидОтчета = "ПродажиБУ" Тогда
            Если ПредыдущаяГруппа <> ДанныеСтроки.Номенклатура Тогда
                ПредыдущаяГруппа = ДанныеСтроки.Номенклатура;
                ЯчейкаОтчета(ТабДок,Стр,1,ПредыдущаяГруппа,Истина);
                Группа = Данные.НайтиСтроки(Новый Структура("Номенклатура",ПредыдущаяГруппа));
                Имена = СтрРазделить("Количество,Себестоимость,Продажа,Прибыль",",");
                Для Индекс = 0 По 3 Цикл
                    Итог = 0; Для Каждого С Из Группа Цикл Итог = Итог+С[Имена[Индекс]]; КонецЦикла;
                    ЯчейкаОтчета(ТабДок,Стр,Индекс+3,Итог,Истина);
                КонецЦикла;
                Стр = Стр+1;
            КонецЕсли;
            ЯчейкаОтчета(ТабДок,Стр,2,ДанныеСтроки.Продано);
            Для Индекс = 0 По 3 Цикл ЯчейкаОтчета(ТабДок,Стр,Индекс+3,ДанныеСтроки[Имена[Индекс]]); КонецЦикла;
            Стр = Стр+1;
        Иначе
            Имена = ?(ВидОтчета = "Премии", СтрРазделить("Сотрудник,ТрудовойСтаж,ПроцентПремии,СуммаПремии",","), СтрРазделить("Номенклатура,Количество,Себестоимость,Продажа,Прибыль",","));
            Для Индекс = 0 По Имена.Количество()-1 Цикл ЯчейкаОтчета(ТабДок,Стр,Индекс+1,ДанныеСтроки[Имена[Индекс]]); КонецЦикла;
            Стр = Стр+1;
        КонецЕсли;
    КонецЦикла;
    ЯчейкаОтчета(ТабДок,Стр,1,"ИТОГО",Истина);
    Если ВидОтчета = "Премии" Тогда ЯчейкаОтчета(ТабДок,Стр,4,Данные.Итог("СуммаПремии"),Истина);
    ИначеЕсли ВидОтчета = "ВедомостьОУ" Тогда
        Для Индекс = 0 По 3 Цикл ЯчейкаОтчета(ТабДок,Стр,Индекс+3,Данные.Итог(Суммы[Индекс]),Истина); КонецЦикла;
    Иначе
        Имена = СтрРазделить("Количество,Себестоимость,Продажа,Прибыль",","); Сдвиг = ?(ВидОтчета = "ПродажиБУ",3,2);
        Для Индекс = 0 По 3 Цикл ЯчейкаОтчета(ТабДок,Стр,Индекс+Сдвиг,Данные.Итог(Имена[Индекс]),Истина); КонецЦикла;
    КонецЕсли;
    ГраницаТаблицы = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
    Для НомерСтроки = 4 По Стр Цикл
        Для НомерКолонки = 1 По Заголовки.Количество() Цикл
            ТабДок.Область(НомерСтроки,НомерКолонки).Обвести(ГраницаТаблицы,ГраницаТаблицы,ГраницаТаблицы,ГраницаТаблицы);
        КонецЦикла;
    КонецЦикла;
    ТабДок.АвтоМасштаб = Истина; ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
КонецПроцедуры


Процедура ПодготовитьНакладную(ДокументОбъект) Экспорт
    Итог = 0;
    Для Каждого Строка Из ДокументОбъект.СписокНоменклатуры Цикл
        Если Строка.Сумма = 0 Тогда Строка.Сумма = Окр(Строка.Цена * Строка.Количество,2); КонецЕсли;
        Итог = Итог + Строка.Сумма;
    КонецЦикла;
    ДокументОбъект.СуммаПоДокументу = Итог;
КонецПроцедуры
