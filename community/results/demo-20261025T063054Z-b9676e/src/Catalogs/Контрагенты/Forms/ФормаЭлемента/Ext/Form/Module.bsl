#Область ОбработчикиСобытийФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
    МенеджерИзмененНаСервере();
КонецПроцедуры

&НаСервере
Процедура МенеджерИзмененНаСервере()
    СохранитьДополнительныеЗначения();
    ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
    ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    СохранитьДополнительныеЗначения();
    ТекущийОбъект.ДополнительныеСведения.Очистить();
    Для Каждого Стр Из Объект.ДополнительныеСведения Цикл
        ЗаполнитьЗначенияСвойств(ТекущийОбъект.ДополнительныеСведения.Добавить(), Стр);
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СохранитьДополнительныеЗначения()
    Для Каждого Стр Из СоответствиеПолей Цикл
        Найденные = Объект.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведений", Стр.ВидСведений));
        Если Найденные.Количество() = 0 Тогда
            Запись = Объект.ДополнительныеСведения.Добавить();
            Запись.ВидСведений = Стр.ВидСведений;
        Иначе
            Запись = Найденные[0];
        КонецЕсли;
        Запись.Значение = ЭтотОбъект[Стр.ИмяПоля];
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПостроитьДополнительныеПоля()
    Удаляемые = Новый Массив;
    Для Каждого Стр Из СоответствиеПолей Цикл
        Поле = Элементы.Найти(Стр.ИмяПоля);
        Если Поле <> Неопределено Тогда Элементы.Удалить(Поле); КонецЕсли;
        Удаляемые.Добавить(Стр.ИмяПоля);
    КонецЦикла;
    Если Удаляемые.Количество() > 0 Тогда ИзменитьРеквизиты(Новый Массив, Удаляемые); КонецЕсли;
    СоответствиеПолей.Очистить();
    Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ Р.ВидСведений, Р.ВидСведений.Наименование КАК Заголовок,
    | Р.ВидСведений.ТипЗначения КАК ТипЗначения
    | ИЗ Справочник.Сотрудники.ДополнительныеСведения КАК Р
    | ГДЕ Р.Ссылка = &Менеджер УПОРЯДОЧИТЬ ПО Р.НомерСтроки");
    Запрос.УстановитьПараметр("Менеджер", Объект.Менеджер);
    Виды = Запрос.Выполнить().Выбрать();
    Новые = Новый Массив;
    Пока Виды.Следующий() Цикл
        Если СоответствиеПолей.НайтиСтроки(Новый Структура("ВидСведений", Виды.ВидСведений)).Количество() > 0 Тогда Продолжить; КонецЕсли;
        Стр = СоответствиеПолей.Добавить();
        Стр.ИмяПоля = "ДопПоле" + Строка(СоответствиеПолей.Количество());
        Стр.ВидСведений = Виды.ВидСведений;
        Новые.Добавить(Новый РеквизитФормы(Стр.ИмяПоля, Виды.ТипЗначения, , Виды.Заголовок));
    КонецЦикла;
    ИзменитьРеквизиты(Новые);
    Виды.Сбросить();
    Пока Виды.Следующий() Цикл
        Строки = СоответствиеПолей.НайтиСтроки(Новый Структура("ВидСведений", Виды.ВидСведений));
        Стр = Строки[0];
        Если Элементы.Найти(Стр.ИмяПоля) <> Неопределено Тогда Продолжить; КонецЕсли;
        Поле = Элементы.Добавить(Стр.ИмяПоля, Тип("ПолеФормы"), Элементы.ГруппаСведений);
        Поле.Вид = ВидПоляФормы.ПолеВвода;
        Поле.ПутьКДанным = Стр.ИмяПоля;
        Поле.Заголовок = Виды.Заголовок;
        Значения = Объект.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведений", Виды.ВидСведений));
        Если Значения.Количество() > 0 Тогда ЭтотОбъект[Стр.ИмяПоля] = Значения[0].Значение; КонецЕсли;
    КонецЦикла;
КонецПроцедуры


