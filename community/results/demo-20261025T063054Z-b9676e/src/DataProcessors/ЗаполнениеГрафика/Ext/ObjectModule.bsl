Процедура ЗаполнитьГрафик(ДатаНачала, ДатаОкончания, ВыходныеДни, Подразделение = Неопределено, ЧасовВДень = 8) Экспорт
    Если Не ЗначениеЗаполнено(Подразделение) Тогда ВызватьИсключение "Укажите подразделение графика."; КонецЕсли;
    Если Не ЗначениеЗаполнено(ДатаНачала) Или ДатаОкончания < ДатаНачала Тогда ВызватьИсключение "Некорректный период графика."; КонецЕсли;
    Если ЧасовВДень < 0 Тогда ВызватьИсключение "Часы не могут быть отрицательными."; КонецЕсли;
    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        Элемент = Блокировка.Добавить("РегистрСведений.ГрафикиРаботы");
        Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        Элемент.УстановитьЗначение("Подразделение", Подразделение);
        Блокировка.Заблокировать();
        Набор = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей();
        Набор.Отбор.Подразделение.Установить(Подразделение);
        Набор.Прочитать();
        Данные = Набор.Выгрузить();
        Данные.Индексы.Добавить("Дата");
        День = НачалоДня(ДатаНачала);
        Пока День <= НачалоДня(ДатаОкончания) Цикл
            Строки = Данные.НайтиСтроки(Новый Структура("Дата", День));
            Если Строки.Количество() = 0 Тогда Запись = Данные.Добавить(); Иначе Запись = Строки[0]; КонецЕсли;
            Запись.Дата = День; Запись.Подразделение = Подразделение;
            Запись.Значение = ?(СтрНайти(ВыходныеДни, Строка(ДеньНедели(День))) > 0, 0, ЧасовВДень);
            Запись.Дни = ?(Запись.Значение > 0, 1, 0);
            День = День + 86400;
        КонецЦикла;
        Набор.Загрузить(Данные);
        Набор.Записать();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
