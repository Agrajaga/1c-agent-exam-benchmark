Процедура Заполнить() Экспорт
    Если ЗначениеЗаполнено(Документы.ПриходнаяНакладная.НайтиПоНомеру("ДЕМО00001")) Тогда Возврат; КонецЕсли;
    НачатьТранзакцию();
    Попытка
        РасчетЗарплаты.НастроитьВидыРасчета();
        Цех = Элемент("Подразделения", "Демо: основной цех");
        Сборочный = Элемент("Подразделения", "Демо: сборочный цех");
        Склад = Элемент("Склады", "Демо: основной склад");
        Деталь = Элемент("Номенклатура", "Демо: материнская плата");
        Блок = Элемент("Номенклатура", "Демо: системный блок");
        Товар = Элемент("Номенклатура", "Демо: принтер");
        Аналог = Элемент("Номенклатура", "Демо: принтер аналог");
        Об = Товар.ПолучитьОбъект(); Об.Артикул = "001"; Об.Записать();
        Об = Аналог.ПолучитьОбъект(); Об.Артикул = "002"; Об.Записать();
        Свойство = Элемент("СвойстваНоменклатуры", "Демо: ASUS");
        Об = Свойство.ПолучитьОбъект(); Об.Номенклатура = Деталь; Об.Записать();
        Вид = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
        Вид.Наименование = "Производитель";
        Вид.ТипЗначения = Новый ОписаниеТипов("Строка");
        Вид.Записать();
        Запись = РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи();
        Запись.Свойство = Свойство; Запись.Характеристика = Вид.Ссылка; Запись.Значение = "ASUS"; Запись.Записать();
        Для Каждого Подр Из Новый Структура("Цех,Сборочный", Цех, Сборочный) Цикл
            Запись = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи();
            Запись.Период = Дата(2024, 1, 1);
            Запись.Подразделение = Подр.Значение;
            Запись.Метод = Перечисления.УчетнаяПолитика.ФИФО;
            Запись.Записать();
        КонецЦикла;
        Запись = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи();
        Запись.Период = Дата(2024, 1, 1);
        Запись.Блок = Блок; Запись.Деталь = Деталь; Запись.Свойство = Свойство; Запись.Количество = 2; Запись.Записать();
        Запись = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи();
        Запись.Номенклатура = Товар; Запись.Аналог = Аналог; Запись.Записать();
        Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
        Приход.Дата = Дата(2024, 1, 2, 9, 0, 0);
        Приход.Номер = "ДЕМО00001"; Приход.Подразделение = Цех;
        Стр = Приход.СписокНоменклатуры.Добавить(); Стр.Номенклатура = Деталь; Стр.Свойство = Свойство; Стр.Количество = 20; Стр.Цена = 1000;
        Приход.Записать(РежимЗаписиДокумента.Проведение);
        Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
        Приход.Дата = Дата(2024, 1, 2, 10, 0, 0); Приход.Склад = Склад;
        Стр = Приход.СписокНоменклатуры.Добавить(); Стр.Номенклатура = Товар; Стр.Количество = 1; Стр.Цена = 100;
        Стр = Приход.СписокНоменклатуры.Добавить(); Стр.Номенклатура = Аналог; Стр.Количество = 4; Стр.Цена = 100;
        Приход.Записать(РежимЗаписиДокумента.Проведение);
        Сборка = Документы.Сборка.СоздатьДокумент();
        Сборка.Дата = Дата(2024, 1, 3, 9, 0, 0); Сборка.ПодразделениеИсточник = Цех; Сборка.ПодразделениеПолучатель = Сборочный;
        Стр = Сборка.Блоки.Добавить(); Стр.Блок = Блок; Стр.Количество = 3;
        Стр = Сборка.ДополнительныеДетали.Добавить(); Стр.Деталь = Деталь; Стр.Свойство = Свойство; Стр.Количество = 1;
        Сборка.Записать(РежимЗаписиДокумента.Проведение);
        Продажа = Документы.РасходнаяНакладная.СоздатьДокумент();
        Продажа.Дата = Дата(2024, 1, 4, 9, 0, 0); Продажа.Склад = Склад;
        Стр = Продажа.СписокНоменклатуры.Добавить(); Стр.Номенклатура = Товар; Стр.Количество = 3; Стр.Цена = 150;
        Продажа.Записать(РежимЗаписиДокумента.Проведение);
        Продажа = Документы.РасходнаяНакладная.СоздатьДокумент();
        Продажа.Дата = Дата(2024, 1, 4, 10, 0, 0);
        Стр = Продажа.СписокНоменклатуры.Добавить(); Стр.Подразделение = Сборочный; Стр.Номенклатура = Блок; Стр.Количество = 1; Стр.Цена = 3500;
        Продажа.Записать(РежимЗаписиДокумента.Проведение);
        Операция = Документы.Операция.СоздатьДокумент();
        Операция.Дата = Дата(2024, 1, 5);
        Стр = Операция.Проводки.Добавить(); Стр.СчетДт = ПланыСчетов.Управленческий.Покупатели; Стр.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки; Стр.Сумма = 10;
        Операция.Записать(РежимЗаписиДокумента.Проведение);
        Работник = Элемент("Сотрудники", "Демо: работник");
        Руководитель = Элемент("Сотрудники", "Демо: руководитель");
        Для Каждого Сотр Из Новый Структура("Работник,Руководитель", Работник, Руководитель) Цикл
            Об = Сотр.Значение.ПолучитьОбъект(); Об.НачалоСтажа = Дата(2020, 1, 1); Об.Записать();
            Запись = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи();
            Запись.Период = Дата(2024, 1, 1); Запись.Сотрудник = Сотр.Значение; Запись.Ставка = 100; Запись.Записать();
        КонецЦикла;
        Для Каждого Порог Из Новый Структура("Ноль,Год,ТриГода", 0, 1, 3) Цикл
            Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи();
            Запись.СтажОт = Порог.Значение;
            Запись.Процент = ?(Порог.Значение = 0, 5, ?(Порог.Значение = 1, 10, 15));
            Запись.Записать();
        КонецЦикла;
        НаборГрафика = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей();
        НаборГрафика.Отбор.Подразделение.Установить(Цех);
        ДеньГрафика = Дата(2024, 1, 1);
        Пока ДеньГрафика <= Дата(2024, 4, 30) Цикл
            Запись = НаборГрафика.Добавить(); Запись.Дата = ДеньГрафика; Запись.Подразделение = Цех;
            Запись.Значение = ?(ДеньНедели(ДеньГрафика) <= 5, 8, 0);
            Запись.Дни = ?(Запись.Значение > 0, 1, 0);
            ДеньГрафика = ДеньГрафика + 86400;
        КонецЦикла;
        НаборГрафика.Записать();
        Для МесяцНачисления = 1 По 4 Цикл
            Начало = Дата(2024, МесяцНачисления, 1);
            Начисление = Документы.НачислениеЗарплаты.СоздатьДокумент();
            Начисление.Дата = КонецМесяца(Начало);
            ДобавитьНачисление(Начисление, Работник, Цех, ПланыВидовРасчета.ОсновныеНачисления.Тариф, Начало, КонецМесяца(Начало));
            ДобавитьНачисление(Начисление, Руководитель, Цех, ПланыВидовРасчета.ОсновныеНачисления.Тариф, Начало, КонецМесяца(Начало));
            Если МесяцНачисления > 1 Тогда
                ДобавитьНачисление(Начисление, Руководитель, Цех, ПланыВидовРасчета.ДополнительныеНачисления.Премия, Начало, КонецМесяца(Начало));
            КонецЕсли;
            Если МесяцНачисления = 4 Тогда
                ДобавитьНачисление(Начисление, Работник, Цех, ПланыВидовРасчета.ОсновныеНачисления.Командировка, Дата(2024, 4, 8), Дата(2024, 4, 10));
            КонецЕсли;
            Начисление.Записать(РежимЗаписиДокумента.Проведение);
        КонецЦикла;
        Вид = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
        Вид.Наименование = "Срок кредита, дни"; Вид.ТипЗначения = Новый ОписаниеТипов("Число"); Вид.Записать();
        Об = Руководитель.ПолучитьОбъект(); Об.ДополнительныеСведения.Добавить().ВидСведений = Вид.Ссылка; Об.Записать();
        Контрагент = Элемент("Контрагенты", "Демо: завод Сатурн");
        Об = Контрагент.ПолучитьОбъект(); Об.Менеджер = Руководитель;
        Стр = Об.ДополнительныеСведения.Добавить(); Стр.ВидСведений = Вид.Ссылка; Стр.Значение = 10; Об.Записать();
        ДополнитьСведения();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Функция Элемент(ИмяСправочника, Наименование) Экспорт
    Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Наименование, Истина);
    Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;
    Об = Справочники[ИмяСправочника].СоздатьЭлемент();
    Об.Наименование = Наименование;
    Об.Записать();
    Возврат Об.Ссылка;
КонецФункции

Процедура ДобавитьНачисление(Документ, Сотрудник, Подразделение, ВидРасчета, Начало, Окончание) Экспорт
    Стр = Документ.ОсновныеНачисления.Добавить();
    Стр.Сотрудник = Сотрудник; Стр.Подразделение = Подразделение; Стр.ВидРасчета = ВидРасчета;
    Стр.ДатаНачала = Начало; Стр.ДатаОкончания = Окончание;
КонецПроцедуры

Процедура ДополнитьСведения() Экспорт
    Руководитель = Элемент("Сотрудники", "Демо: руководитель");
    ДругойМенеджер = Элемент("Сотрудники", "Демо: менеджер без кредитов");
    Регион = ВидСведения("Регион", Новый ОписаниеТипов("Строка"));
    Валюта = ВидСведения("Валюта кредита", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
    Для Каждого Менеджер Из Новый Структура("Первый,Второй", Руководитель, ДругойМенеджер) Цикл
        Об = Менеджер.Значение.ПолучитьОбъект();
        Если Об.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведений", Регион)).Количество() = 0 Тогда
            Об.ДополнительныеСведения.Добавить().ВидСведений = Регион;
        КонецЕсли;
        Если Менеджер.Значение = Руководитель И Об.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведений", Валюта)).Количество() = 0 Тогда
            Об.ДополнительныеСведения.Добавить().ВидСведений = Валюта;
        КонецЕсли;
        Об.Записать();
    КонецЦикла;
    Об = Элемент("Контрагенты", "Демо: завод Сатурн").ПолучитьОбъект();
    Если Об.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведений", Регион)).Количество() = 0 Тогда
        Стр = Об.ДополнительныеСведения.Добавить(); Стр.ВидСведений = Регион; Стр.Значение = "Москва";
    КонецЕсли;
    Если Об.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведений", Валюта)).Количество() = 0 Тогда
        Стр = Об.ДополнительныеСведения.Добавить(); Стр.ВидСведений = Валюта; Стр.Значение = Элемент("Валюты", "Доллар США");
    КонецЕсли;
    Об.Записать();
КонецПроцедуры

Функция ВидСведения(Наименование, ТипЗначения)
    Ссылка = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(Наименование, Истина);
    Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;
    Объект = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
    Объект.Наименование = Наименование; Объект.ТипЗначения = ТипЗначения; Объект.Записать();
    Возврат Объект.Ссылка;
КонецФункции
