// Зависимости заданы программно для предопределенных видов расчета.
// Процедура идемпотентна: после первоначального заполнения объектов не пишет.
Процедура НастроитьВидыРасчета() Экспорт
    Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф.ПолучитьОбъект();
    Если Тариф.ВытесняющиеВидыРасчета.Количество() = 0 Тогда
        Тариф.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
        Тариф.Записать();
    КонецЕсли;
    ВремяПремии = ПланыВидовРасчета.ОсновныеНачисления.ПериодПремии.ПолучитьОбъект();
    Если ВремяПремии.ВытесняющиеВидыРасчета.Количество() = 0 Тогда
        ВремяПремии.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
        ВремяПремии.Записать();
    КонецЕсли;
    Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка.ПолучитьОбъект();
    Если Командировка.БазовыеВидыРасчета.Количество() = 0 Тогда
        Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
        Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
        Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ДополнительныеНачисления.Премия;
        Командировка.Записать();
    КонецЕсли;
    Премия = ПланыВидовРасчета.ДополнительныеНачисления.Премия.ПолучитьОбъект();
    Если Премия.БазовыеВидыРасчета.Количество() = 0 Тогда
        Премия.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
        Премия.Записать();
    КонецЕсли;
КонецПроцедуры

Функция МассивИзмерений(СтрокаИмен)
    Возврат СтрРазделить(СтрокаИмен, ",", Ложь);
КонецФункции

Функция ДанныеГрафика(Регистратор)
    Запрос = Новый Запрос("ВЫБРАТЬ Регистратор, НомерСтроки,
    | ЕСТЬNULL(ЗначениеФактическийПериодДействия, 0) КАК Часы,
    | ЕСТЬNULL(ДниФактическийПериодДействия, 0) КАК Дни,
    | ЕСТЬNULL(ДниПериодРегистрации, 0) КАК ПланДней
    | ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор В (&Регистратор))");
    Если ТипЗнч(Регистратор) <> Тип("Массив") Тогда
        Список = Новый Массив; Список.Добавить(Регистратор);
    Иначе Список = Регистратор; КонецЕсли;
    Запрос.УстановитьПараметр("Регистратор", Список);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция БазаКомандировок(Регистратор, ИмяРегистра)
    Запрос = Новый Запрос("ВЫБРАТЬ НомерСтроки, РезультатБаза КАК Сумма "
        + ?(ИмяРегистра = "Начисления", ", ДниБаза КАК Дни ", ", 0 КАК Дни ")
        + "ИЗ РегистрРасчета.Начисления.База" + ИмяРегистра
        + "(&Основные, &Базовые, , Регистратор = &Регистратор И ВидРасчета = &Вид)");
    Запрос.УстановитьПараметр("Основные", МассивИзмерений("Сотрудник"));
    Запрос.УстановитьПараметр("Базовые", МассивИзмерений("Сотрудник"));
    Запрос.УстановитьПараметр("Регистратор", Регистратор);
    Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура Рассчитать(Объект) Экспорт
    НастроитьВидыРасчета();
    Учет.Заблокировать("РегистрРасчета.Начисления");
    Учет.Заблокировать("РегистрРасчета.Премии");
    Набор = Объект.Движения.Начисления;
    Премии = Объект.Движения.Премии;
    Набор.Очистить();
    Премии.Очистить();
    Набор.Записывать = Истина;
    Премии.Записывать = Истина;
    Набор.Записать();
    Премии.Записать();
    Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
    Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
    ВидПремия = ПланыВидовРасчета.ДополнительныеНачисления.Премия;
    Начисления = СтрокиНачислений(Объект.ОсновныеНачисления);
    Для Каждого Стр Из Начисления Цикл
        Если Не ЗначениеЗаполнено(Стр.Сотрудник) Или Не ЗначениеЗаполнено(Стр.Подразделение) Тогда
            ВызватьИсключение "Заполните сотрудника и подразделение.";
        КонецЕсли;
        Если Стр.ДатаОкончания < Стр.ДатаНачала Или Не ЗначениеЗаполнено(Стр.ДатаНачала) Тогда
            ВызватьИсключение "Некорректный период начисления.";
        КонецЕсли;
        Если Стр.ВидРасчета <> Командировка И НачалоМесяца(Стр.ДатаНачала) <> НачалоМесяца(Стр.ДатаОкончания) Тогда
            ВызватьИсключение "Тариф и премия вводятся в пределах одного месяца.";
        КонецЕсли;
        Начало = НачалоДня(Стр.ДатаНачала);
        Пока Начало <= Стр.ДатаОкончания Цикл
            Окончание = Мин(КонецМесяца(Начало), КонецДня(Стр.ДатаОкончания));
            Д = Набор.Добавить();
            Д.Сотрудник = Стр.Сотрудник;
            Д.Подразделение = Стр.Подразделение;
            Д.ПериодДействияНачало = Начало;
            Д.ПериодДействияКонец = Окончание;
            Д.ПериодРегистрации = НачалоМесяца(Начало);
            Д.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Стр.ДатаНачала), -3);
            Д.БазовыйПериодКонец = НачалоМесяца(Стр.ДатаНачала) - 1;
            Если Стр.ВидРасчета = ВидПремия Тогда
                Д.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.ПериодПремии;
                П = Премии.Добавить();
                П.Сотрудник = Стр.Сотрудник;
                П.Подразделение = Стр.Подразделение;
                П.ВидРасчета = ВидПремия;
                П.ПериодРегистрации = НачалоМесяца(Начало);
                П.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), -1);
                П.БазовыйПериодКонец = НачалоМесяца(Начало) - 1;
                П.Начало = Начало;
                П.Окончание = Окончание;
                П.СтрокаГрафика = Набор.Количество();
            ИначеЕсли Стр.ВидРасчета = Тариф Или Стр.ВидРасчета = Командировка Тогда
                Д.ВидРасчета = Стр.ВидРасчета;
                Если Д.ВидРасчета = Командировка Тогда
                    Д.ПериодРегистрации = Макс(НачалоМесяца(Объект.Дата), НачалоМесяца(Начало));
                КонецЕсли;
            Иначе
                ВызватьИсключение "Поддерживаются тариф, премия и командировка.";
            КонецЕсли;
            Начало = Окончание + 1;
        КонецЦикла;
    КонецЦикла;
    // Платформа определяет сторнируемые интервалы прошлых периодов.
    Дополнение = Набор.ПолучитьДополнение();
    Для Каждого Стр Из Дополнение Цикл
        Д = Набор.Добавить();
        ЗаполнитьЗначенияСвойств(Д, Стр, , "НомерСтроки,Регистратор");
        Д.Сторно = Истина;
        Д.ПериодРегистрации = Стр.ПериодРегистрацииСторно;
        Д.ПериодДействияНачало = Стр.ПериодДействияНачалоСторно;
        Д.ПериодДействияКонец = Стр.ПериодДействияКонецСторно;
    КонецЦикла;
    Набор.Записать();
    Премии.Записать();
    График = ДанныеГрафика(Объект.Ссылка);
    // Часовой тариф берется на начало месяца, а не на начало строки.
    ВсеСтавки = СтавкиДляНабора(Набор);
    Для Каждого Д Из Набор Цикл
        Если Д.ВидРасчета <> Тариф Тогда Продолжить; КонецЕсли;
        Строки = График.НайтиСтроки(Новый Структура("НомерСтроки", Д.НомерСтроки));
        Если Строки.Количество() = 0 Тогда Продолжить; КонецЕсли;
        Время = Строки[0];
        Если Не Д.Сторно Или Д.Ставка = 0 Тогда
            Ставки = ВсеСтавки.НайтиСтроки(Новый Структура("НомерСтроки", Д.НомерСтроки));
            Если Ставки.Количество() = 0 Или Не Ставки[0].Задана Тогда ВызватьИсключение "Не задан тариф сотрудника " + Строка(Д.Сотрудник); КонецЕсли;
            Д.Ставка = Ставки[0].Ставка;
        КонецЕсли;
        Д.Результат = Окр(Д.Ставка * Время.Часы, 2) * ?(Д.Сторно, -1, 1);
        Д.Дни = Время.Дни * ?(Д.Сторно, -1, 1);
    КонецЦикла;
    Набор.Записать();
    // Этапы зависят друг от друга: тарифы -> премии -> командировки.
    ОбновитьСвязанныеРасчеты(Объект);
    РассчитатьПремии(Объект, График);
    СторнироватьПремии(Объект, График);
    // Базы получаем после сохранения тарифа и премий всех месяцев.
    База = БазаКомандировок(Объект.Ссылка, "Начисления");
    БазаПремий = БазаКомандировок(Объект.Ссылка, "Премии");
    Командировки = Новый ТаблицаЗначений;
    Командировки.Колонки.Добавить("Начало"); Командировки.Колонки.Добавить("НомерСтроки"); Командировки.Колонки.Добавить("Запись");
    Для Каждого Д Из Набор Цикл
        Если Д.ВидРасчета = Командировка Тогда
            К = Командировки.Добавить(); К.Начало = Д.ПериодДействияНачало; К.НомерСтроки = Д.НомерСтроки; К.Запись = Д;
        КонецЕсли;
    КонецЦикла;
    Командировки.Сортировать("Начало,НомерСтроки");
    Рассчитанные = Новый Массив;
    Для Каждого К Из Командировки Цикл
        Д = К.Запись;
        СуммаБазы = 0;
        ДниБазы = 0;
        Для Каждого Б Из База.НайтиСтроки(Новый Структура("НомерСтроки", Д.НомерСтроки)) Цикл
            СуммаБазы = СуммаБазы + Б.Сумма;
            ДниБазы = ДниБазы + Б.Дни;
        КонецЦикла;
        Для Каждого Б Из БазаПремий.НайтиСтроки(Новый Структура("НомерСтроки", Д.НомерСтроки)) Цикл
            СуммаБазы = СуммаБазы + Б.Сумма;
        КонецЦикла;
        // В виртуальной базе текущего набора ранние командировки ещё нулевые.
        // Учитываем уже рассчитанные и записанные результаты того же документа.
        Для Каждого Ранее Из Рассчитанные Цикл
            Если Ранее.Сотрудник = Д.Сотрудник И Ранее.ПериодДействияНачало >= Д.БазовыйПериодНачало
                И Ранее.ПериодДействияКонец <= Д.БазовыйПериодКонец Тогда
                СуммаБазы = СуммаБазы + Ранее.Результат;
            КонецЕсли;
        КонецЦикла;
        Строки = График.НайтиСтроки(Новый Структура("НомерСтроки", Д.НомерСтроки));
        Если Строки.Количество() > 0 И ДниБазы > 0 Тогда
            Д.Результат = Окр(СуммаБазы / ДниБазы * Строки[0].Дни, 2);
        Иначе
            Д.Результат = 0;
        КонецЕсли;
        // Дни командировки не входят в отработанные дни.
        Д.Дни = 0;
        // Следующие периоды используют только сохраненные результаты.
        Набор.Записать();
        Рассчитанные.Добавить(Д);
    КонецЦикла;
    Набор.Записать();
КонецПроцедуры

Процедура РассчитатьПремии(Объект, График, Базы = Неопределено, Шкала = Неопределено)
    Если Базы = Неопределено Тогда
        Регистраторы = Новый Массив; Регистраторы.Добавить(Объект.Ссылка);
        Базы = БазыПремий(Регистраторы);
    КонецЕсли;
    Если Шкала = Неопределено Тогда Шкала = ШкалаПремий(); КонецЕсли;
    Для Каждого Д Из Объект.Движения.Премии Цикл
        Если Д.Корректировка Тогда Продолжить; КонецЕсли;
        Строки = Базы.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Объект.Ссылка, Д.НомерСтроки));
        Если Строки.Количество() = 0 Тогда Продолжить; КонецЕсли;
        Б = Строки[0];
        Если Не ЗначениеЗаполнено(Б.НачалоСтажа) Тогда ВызватьИсключение "Укажите дату начала стажа сотрудника."; КонецЕсли;
        Месяцы = (Год(Д.ПериодРегистрации) - Год(Б.НачалоСтажа)) * 12 + Месяц(Д.ПериодРегистрации) - Месяц(Б.НачалоСтажа);
        Если День(Д.ПериодРегистрации) < День(Б.НачалоСтажа) Тогда Месяцы = Месяцы - 1; КонецЕсли;
        Д.Стаж = Макс(0, Месяцы) / 12;
        Д.Процент = 0;
        Для Каждого Ступень Из Шкала Цикл
            Если Д.Стаж >= Ступень.СтажОт Тогда Д.Процент = Ступень.Процент; КонецЕсли;
        КонецЦикла;
        Время = График.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Объект.Ссылка, Д.СтрокаГрафика));
        Коэффициент = 0;
        Если Время.Количество() > 0 И Время[0].ПланДней > 0 Тогда
            Коэффициент = Время[0].Дни / Время[0].ПланДней;
        КонецЕсли;
        Д.Результат = Окр(Б.База * Д.Процент / 100 * Коэффициент, 2);
    КонецЦикла;
    Объект.Движения.Премии.Записать();
КонецПроцедуры

Процедура СторнироватьПремии(Объект, График)
    Начало = Дата(3999, 1, 1); Окончание = Дата(1, 1, 1); Регистрация = Дата(1, 1, 1);
    ЕстьСторно = Ложь;
    Для Каждого Д Из Объект.Движения.Начисления Цикл
        Если Д.Сторно И Д.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.ПериодПремии Тогда
            Начало = Мин(Начало, Д.ПериодДействияНачало); Окончание = Макс(Окончание, Д.ПериодДействияКонец);
            Регистрация = Макс(Регистрация, Д.ПериодРегистрации); ЕстьСторно = Истина;
        КонецЕсли;
    КонецЦикла;
    Если Не ЕстьСторно Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ П.Сотрудник, П.Подразделение, П.Стаж, П.Процент, П.Результат, П.Начало, П.Окончание, П.ПериодРегистрации,
    | Г.ДниФактическийПериодДействия КАК ОплаченоДней
    | ИЗ РегистрРасчета.Премии КАК П
    | ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрРасчета.Начисления.ДанныеГрафика(
    | Сотрудник В (&Сотрудники) И ВидРасчета = &Вид И НЕ Сторно) КАК Г
    | ПО П.Регистратор = Г.Регистратор И П.СтрокаГрафика = Г.НомерСтроки
    | ГДЕ П.Сотрудник В (&Сотрудники)
    | И П.Начало <= &Окончание И П.Окончание >= &Начало
    | И П.ПериодРегистрации < &Регистрация И НЕ П.Корректировка И П.Активность");
    Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.ПериодПремии);
    Запрос.УстановитьПараметр("Сотрудники", Объект.ОсновныеНачисления.ВыгрузитьКолонку("Сотрудник"));
    Запрос.УстановитьПараметр("Начало", Начало); Запрос.УстановитьПараметр("Окончание", Окончание);
    Запрос.УстановитьПараметр("Регистрация", Регистрация);
    ТаблицаИсточников = Запрос.Выполнить().Выгрузить();
    Для Каждого Д Из Объект.Движения.Начисления Цикл
        Если Не Д.Сторно Или Д.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.ПериодПремии Тогда Продолжить; КонецЕсли;
        Время = График.НайтиСтроки(Новый Структура("НомерСтроки", Д.НомерСтроки));
        Если Время.Количество() = 0 Тогда Продолжить; КонецЕсли;
        Для Каждого Источники Из ТаблицаИсточников.НайтиСтроки(Новый Структура("Сотрудник,Подразделение", Д.Сотрудник, Д.Подразделение)) Цикл
            Если Источники.Начало > Д.ПериодДействияКонец Или Источники.Окончание < Д.ПериодДействияНачало Или Источники.ПериодРегистрации >= Д.ПериодРегистрации Тогда Продолжить; КонецЕсли;
            Если Источники.ОплаченоДней <= 0 Тогда Продолжить; КонецЕсли;
            П = Объект.Движения.Премии.Добавить();
            П.Сотрудник = Д.Сотрудник; П.Подразделение = Д.Подразделение;
            П.ВидРасчета = ПланыВидовРасчета.ДополнительныеНачисления.Премия;
            П.ПериодРегистрации = Д.ПериодРегистрации;
            П.Сторно = Истина;
            П.Корректировка = Истина;
            П.Стаж = Источники.Стаж; П.Процент = Источники.Процент;
            П.Начало = Д.ПериодДействияНачало; П.Окончание = Д.ПериодДействияКонец;
            П.Результат = -Окр(Источники.Результат * Время[0].Дни / Источники.ОплаченоДней, 2);
        КонецЦикла;
    КонецЦикла;
    Объект.Движения.Премии.Записать();
КонецПроцедуры

Процедура ОбновитьСвязанныеРасчеты(Объект) Экспорт
    Если Объект.ОсновныеНачисления.Количество() = 0 Тогда Возврат; КонецЕсли;
    Начало = Дата(3999, 1, 1);
    Окончание = Дата(1, 1, 1);
    Для Каждого Стр Из Объект.ОсновныеНачисления Цикл
        Начало = Мин(Начало, Стр.ДатаНачала);
        Окончание = Макс(Окончание, КонецДня(Стр.ДатаОкончания));
    КонецЦикла;
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Регистратор
    | ИЗ РегистрРасчета.Начисления
    | ГДЕ Регистратор <> &Текущий И Сотрудник В (&Сотрудники)
    | И ПериодДействияНачало <= &Окончание И ПериодДействияКонец >= &Начало
    | УПОРЯДОЧИТЬ ПО Регистратор");
    Запрос.УстановитьПараметр("Текущий", Объект.Ссылка);
    Запрос.УстановитьПараметр("Сотрудники", Объект.ОсновныеНачисления.ВыгрузитьКолонку("Сотрудник"));
    Запрос.УстановитьПараметр("Начало", Начало);
    Запрос.УстановитьПараметр("Окончание", Окончание);
    ТаблицаРегистраторов = Запрос.Выполнить().Выгрузить();
    СписокРегистраторов = ТаблицаРегистраторов.ВыгрузитьКолонку("Регистратор");
    График = ДанныеГрафика(СписокРегистраторов);
    Для Каждого Регистраторы Из ТаблицаРегистраторов Цикл
        Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей();
        Набор.Отбор.Регистратор.Установить(Регистраторы.Регистратор); Набор.Прочитать();
        Изменен = Ложь;
        Для Каждого Д Из Набор Цикл
            Если Д.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда Продолжить; КонецЕсли;
            Время = График.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Регистраторы.Регистратор, Д.НомерСтроки));
            Если Время.Количество() = 0 Тогда Продолжить; КонецЕсли;
            НоваяСумма = Окр(Д.Ставка * Время[0].Часы, 2) * ?(Д.Сторно, -1, 1);
            НовыеДни = Время[0].Дни * ?(Д.Сторно, -1, 1);
            Если Д.Результат <> НоваяСумма Или Д.Дни <> НовыеДни Тогда
                Д.Результат = НоваяСумма; Д.Дни = НовыеДни; Изменен = Истина;
            КонецЕсли;
        КонецЦикла;
        Если Изменен Тогда Набор.Записать(); КонецЕсли;
    КонецЦикла;
    // Базу премий получаем после обновления всех тарифных наборов.
    Базы = БазыПремий(СписокРегистраторов);
    Шкала = ШкалаПремий();
    Для Каждого Регистраторы Из ТаблицаРегистраторов Цикл
        НаборПремий = РегистрыРасчета.Премии.СоздатьНаборЗаписей();
        НаборПремий.Отбор.Регистратор.Установить(Регистраторы.Регистратор); НаборПремий.Прочитать();
        Если НаборПремий.Количество() > 0 Тогда
            Контекст = Новый Структура("Ссылка,Движения", Регистраторы.Регистратор, Новый Структура("Премии", НаборПремий));
            РассчитатьПремии(Контекст, График, Базы, Шкала);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция СтавкиДляНабора(Набор)
    Периоды = Новый ТаблицаЗначений;
    Периоды.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
    Периоды.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
    Периоды.Колонки.Добавить("Месяц", Новый ОписаниеТипов("Дата"));
    Для Каждого Д Из Набор Цикл
        Если Д.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
            Стр = Периоды.Добавить(); Стр.НомерСтроки = Д.НомерСтроки; Стр.Сотрудник = Д.Сотрудник;
            Стр.Месяц = НачалоМесяца(Д.ПериодДействияНачало);
        КонецЕсли;
    КонецЦикла;
    Запрос = Новый Запрос("ВЫБРАТЬ НомерСтроки, Сотрудник, Месяц ПОМЕСТИТЬ ВТПериоды ИЗ &Периоды КАК П;
    | ВЫБРАТЬ П.НомерСтроки, П.Сотрудник, МАКСИМУМ(С.Период) КАК Период
    | ПОМЕСТИТЬ ВТПоследние ИЗ ВТПериоды КАК П
    | ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК С
    | ПО П.Сотрудник = С.Сотрудник И С.Период <= П.Месяц
    | СГРУППИРОВАТЬ ПО П.НомерСтроки, П.Сотрудник;
    | ВЫБРАТЬ П.НомерСтроки, ЕСТЬNULL(С.Ставка, 0) КАК Ставка,
    | ВЫБОР КОГДА С.Период ЕСТЬ NULL ТОГДА ЛОЖЬ ИНАЧЕ ИСТИНА КОНЕЦ КАК Задана
    | ИЗ ВТПоследние КАК П ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК С
    | ПО П.Сотрудник = С.Сотрудник И П.Период = С.Период");
    Запрос.УстановитьПараметр("Периоды", Периоды);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
Функция БазыПремий(Регистраторы)

    Запрос = Новый Запрос("ВЫБРАТЬ П.Регистратор, П.НомерСтроки, П.Сотрудник,
    | П.Сотрудник.НачалоСтажа КАК НачалоСтажа,
    | СУММА(ВЫБОР КОГДА Б.СотрудникРазрез <> П.Сотрудник
    | ТОГДА ЕСТЬNULL(Б.РезультатБаза, 0) ИНАЧЕ 0 КОНЕЦ) КАК База
    | ИЗ РегистрРасчета.Премии КАК П
    | ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.Премии.БазаНачисления(&Основные, &Базовые, &Разрезы,
    | Регистратор В (&Регистраторы)) КАК Б
    | ПО П.Регистратор = Б.Регистратор И П.НомерСтроки = Б.НомерСтроки
    | ГДЕ П.Регистратор В (&Регистраторы) И П.Активность И НЕ П.Корректировка
    | СГРУППИРОВАТЬ ПО П.Регистратор, П.НомерСтроки, П.Сотрудник, П.Сотрудник.НачалоСтажа");
    Запрос.УстановитьПараметр("Основные", МассивИзмерений("Подразделение"));
    Запрос.УстановитьПараметр("Базовые", МассивИзмерений("Подразделение"));
    Запрос.УстановитьПараметр("Разрезы", МассивИзмерений("Сотрудник"));
    Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ШкалаПремий()
    Запрос = Новый Запрос("ВЫБРАТЬ СтажОт, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО СтажОт");
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция СтрокиНачислений(ТабличнаяЧасть)
    Строки = ТабличнаяЧасть.Выгрузить();
    Строки.Сортировать("Сотрудник,Подразделение,ВидРасчета,ДатаНачала,ДатаОкончания");
    Результат = Строки.СкопироватьКолонки();
    Предыдущая = Неопределено;
    Для Каждого Стр Из Строки Цикл
        Если Стр.ДатаОкончания < Стр.ДатаНачала Или Не ЗначениеЗаполнено(Стр.ДатаНачала) Тогда
            ВызватьИсключение "Некорректный период начисления.";
        КонецЕсли;
        Если Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка И НачалоМесяца(Стр.ДатаНачала) <> НачалоМесяца(Стр.ДатаОкончания) Тогда
            ВызватьИсключение "Тариф и премия вводятся в пределах одного месяца.";
        КонецЕсли;
        Если Предыдущая <> Неопределено
            И Предыдущая.Сотрудник = Стр.Сотрудник И Предыдущая.Подразделение = Стр.Подразделение
            И Предыдущая.ВидРасчета = Стр.ВидРасчета
            И НачалоДня(Стр.ДатаНачала) <= КонецДня(Предыдущая.ДатаОкончания) + 1
            И (Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка Или НачалоМесяца(Предыдущая.ДатаНачала) = НачалоМесяца(Стр.ДатаНачала)) Тогда
            Предыдущая.ДатаОкончания = Макс(Предыдущая.ДатаОкончания, Стр.ДатаОкончания);
        Иначе
            Предыдущая = Результат.Добавить(); ЗаполнитьЗначенияСвойств(Предыдущая, Стр);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции
