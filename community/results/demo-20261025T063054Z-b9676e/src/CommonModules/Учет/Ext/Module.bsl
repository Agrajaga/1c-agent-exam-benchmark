// Общая серверная логика двух видов учета. Остатки читаются после удаления
// прежних движений, под исключительной управляемой блокировкой.
Процедура Заблокировать(ИмяРегистра) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить(ИмяРегистра);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция СуммаСтроки(Строка) Экспорт
    Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда ВызватьИсключение "Заполните номенклатуру в строке."; КонецЕсли;
    Если Строка.Количество <= 0 Тогда
        ВызватьИсключение "Количество должно быть положительным.";
    КонецЕсли;
    Сумма = Строка.Сумма;
    Если Сумма = 0 Тогда Сумма = Строка.Цена * Строка.Количество; КонецЕсли;
    Если Сумма < 0 Тогда ВызватьИсключение "Сумма не может быть отрицательной."; КонецЕсли;
    Возврат Окр(Сумма, 2);
КонецФункции

Функция Политика(Подразделение, Дата) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение = &Подразделение)");
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("Подразделение", Подразделение);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Метод;
    КонецЕсли;
    Возврат Перечисления.УчетнаяПолитика.ПоСредней;
КонецФункции

Функция ОстаткиОУ(Момент, Подразделения, Товары) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия,
    | КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость
    | ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент, Подразделение В (&Подразделения) И Номенклатура В (&Товары))
    | УПОРЯДОЧИТЬ ПО Партия.Дата, Партия");
    Запрос.УстановитьПараметр("Момент", Момент);
    Запрос.УстановитьПараметр("Подразделения", Подразделения);
    Запрос.УстановитьПараметр("Товары", Товары);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция СписатьОУ(Набор, Остатки, Дата, Подразделение, Товар, Свойство, Количество, Метод) Экспорт
    Если Количество <= 0 Тогда
        ВызватьИсключение "Количество списания должно быть положительным.";
    КонецЕсли;
    Отбор = Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство);
    Партии = Остатки.НайтиСтроки(Отбор);
    АктивныеПартии = Новый Массив;
    Для Каждого Партия Из Партии Цикл
        Если Партия.Количество > 0 Тогда АктивныеПартии.Добавить(Партия); КонецЕсли;
    КонецЦикла;
    Партии = АктивныеПартии;
    Доступно = 0;
    Стоимость = 0;
    Для Каждого Партия Из Партии Цикл
        Доступно = Доступно + Партия.Количество;
        Стоимость = Стоимость + Партия.Стоимость;
    КонецЦикла;
    Если Доступно < Количество Тогда
        ВызватьИсключение "Недостаточно товара " + Строка(Товар) + ", свойство " + Строка(Свойство)
            + " в подразделении " + Строка(Подразделение) + ". Не хватает " + Строка(Количество - Доступно);
    КонецЕсли;
    Если Метод = Перечисления.УчетнаяПолитика.ЛИФО Тогда
        ОбратныеПартии = Новый Массив;
        Индекс = Партии.Количество() - 1;
        Пока Индекс >= 0 Цикл
            ОбратныеПартии.Добавить(Партии[Индекс]);
            Индекс = Индекс - 1;
        КонецЦикла;
        Партии = ОбратныеПартии;
    КонецЕсли;
    Осталось = Количество;
    Списано = 0;
    Для Каждого Партия Из Партии Цикл
        Если Осталось <= 0 Тогда Прервать; КонецЕсли;
        Если Партия.Количество <= 0 Тогда Продолжить; КонецЕсли;
        Если Метод = Перечисления.УчетнаяПолитика.ПоСредней Тогда
            КСписанию = Мин(Осталось, Окр(Количество * Партия.Количество / Доступно, 6));
            Если Партия = Партии[Партии.Количество() - 1] Тогда КСписанию = Осталось; КонецЕсли;
        Иначе
            КСписанию = Мин(Осталось, Партия.Количество);
        КонецЕсли;
        Если КСписанию = 0 Тогда Продолжить; КонецЕсли;
        Сумма = ?(КСписанию = Партия.Количество, Партия.Стоимость, Окр(Партия.Стоимость * КСписанию / Партия.Количество, 2));
        Если Метод = Перечисления.УчетнаяПолитика.ПоСредней И КСписанию = Осталось Тогда
            Сумма = Окр(Стоимость * Количество / Доступно, 2) - Списано;
        КонецЕсли;
        Д = Набор.Добавить();
        Д.Период = Дата;
        Д.ВидДвижения = ВидДвиженияНакопления.Расход;
        Д.Подразделение = Подразделение;
        Д.Номенклатура = Товар;
        Д.Свойство = Свойство;
        Д.Партия = Партия.Партия;
        Д.Количество = КСписанию;
        Д.Стоимость = Сумма;
        Партия.Количество = Партия.Количество - КСписанию;
        Партия.Стоимость = Партия.Стоимость - Сумма;
        Осталось = Осталось - КСписанию;
        Списано = Списано + Сумма;
    КонецЦикла;
    Возврат Списано;
КонецФункции

Процедура ПриходОУ(Набор, Дата, Подразделение, Товар, Свойство, Партия, Количество, Стоимость) Экспорт
    Д = Набор.Добавить();
    Д.Период = Дата;
    Д.ВидДвижения = ВидДвиженияНакопления.Приход;
    Д.Подразделение = Подразделение;
    Д.Номенклатура = Товар;
    Д.Свойство = Свойство;
    Д.Партия = Партия;
    Д.Количество = Количество;
    Д.Стоимость = Стоимость;
КонецПроцедуры

Функция ОстаткиБУ(Момент, Товары) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ Номенклатура, Склад, КоличествоОстаток КАК Количество, СуммаОстаток КАК Сумма
    | ИЗ РегистрБухгалтерии.Управленческий.Остатки(&Момент, Счет = &Счет, Номенклатура В (&Товары))");
    Запрос.УстановитьПараметр("Момент", Момент);
    Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары);
    Запрос.УстановитьПараметр("Товары", Товары);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ГрафАналогов() Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ Номенклатура, Аналог ИЗ РегистрСведений.Аналоги");
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ГруппаАналогов(Товар, Граф) Экспорт
    Группа = Новый Массив;
    Группа.Добавить(Товар);
    Позиция = 0;
    Пока Позиция < Группа.Количество() Цикл
        Текущий = Группа[Позиция];
        Для Каждого Ребро Из Граф Цикл
            Кандидат = Неопределено;
            Если Ребро.Номенклатура = Текущий Тогда Кандидат = Ребро.Аналог; КонецЕсли;
            Если Ребро.Аналог = Текущий Тогда Кандидат = Ребро.Номенклатура; КонецЕсли;
            Если ЗначениеЗаполнено(Кандидат) И Группа.Найти(Кандидат) = Неопределено Тогда
                Группа.Добавить(Кандидат);
            КонецЕсли;
        КонецЦикла;
        Позиция = Позиция + 1;
    КонецЦикла;
    Возврат Группа;
КонецФункции

Процедура ПродажаБУ(Объект) Экспорт
    Граф = ГрафАналогов();
    Кандидаты = Новый Массив;
    Для Каждого Стр Из Объект.СписокНоменклатуры Цикл
        Для Каждого Товар Из ГруппаАналогов(Стр.Номенклатура, Граф) Цикл
            Если Кандидаты.Найти(Товар) = Неопределено Тогда Кандидаты.Добавить(Товар); КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Остатки = ОстаткиБУ(Объект.МоментВремени(), Кандидаты);
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Артикул ИЗ Справочник.Номенклатура ГДЕ Ссылка В (&Кандидаты) УПОРЯДОЧИТЬ ПО Артикул, Ссылка");
    Запрос.УстановитьПараметр("Кандидаты", Кандидаты);
    Номенклатура = Запрос.Выполнить().Выгрузить();
    Для Каждого Стр Из Объект.СписокНоменклатуры Цикл
        СуммаПродажи = СуммаСтроки(Стр);
        Группа = ГруппаАналогов(Стр.Номенклатура, Граф);
        Очередь = Новый Массив;
        Очередь.Добавить(Стр.Номенклатура);
        Для Каждого Т Из Номенклатура Цикл
            Если Т.Ссылка <> Стр.Номенклатура И Группа.Найти(Т.Ссылка) <> Неопределено Тогда
                Очередь.Добавить(Т.Ссылка);
            КонецЕсли;
        КонецЦикла;
        Осталось = Стр.Количество;
        ВыручкаОсталась = СуммаПродажи;
        Для Каждого Товар Из Очередь Цикл
            Если Осталось = 0 Тогда Прервать; КонецЕсли;
            Все = Остатки.НайтиСтроки(Новый Структура("Номенклатура", Товар));
            КоличествоВсего = 0;
            СуммаВсего = 0;
            Для Каждого Баланс Из Все Цикл
                КоличествоВсего = КоличествоВсего + Баланс.Количество;
                СуммаВсего = СуммаВсего + Баланс.Сумма;
            КонецЦикла;
            НаСкладе = Остатки.НайтиСтроки(Новый Структура("Номенклатура,Склад", Товар, Объект.Склад));
            Для Каждого Баланс Из НаСкладе Цикл
                Если Баланс.Количество <= 0 Тогда Продолжить; КонецЕсли;
                Кол = Мин(Осталось, Баланс.Количество);
                Если КоличествоВсего <= 0 Тогда ВызватьИсключение "Некорректный количественный остаток."; КонецЕсли;
                Себестоимость = ?(Кол = КоличествоВсего, СуммаВсего, Окр(СуммаВсего * Кол / КоличествоВсего, 2));
                Выручка = ?(Кол = Осталось, ВыручкаОсталась, Окр(СуммаПродажи * Кол / Стр.Количество, 2));
                Д = Объект.Движения.Управленческий.Добавить();
                Д.Период = Объект.Дата;
                Д.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки;
                Д.СчетКт = ПланыСчетов.Управленческий.Товары;
                Д.НоменклатураКт = Товар;
                Д.СкладКт = Объект.Склад;
                Д.КоличествоКт = Кол;
                Д.Сумма = Себестоимость;
                Д.Заказано = Стр.Номенклатура;
                Д.Продано = Товар;
                Д.Выручка = Выручка;
                Д = Объект.Движения.Управленческий.Добавить();
                Д.Период = Объект.Дата;
                Д.СчетДт = ПланыСчетов.Управленческий.Покупатели;
                Д.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
                Д.Сумма = Выручка;
                Баланс.Количество = Баланс.Количество - Кол;
                Баланс.Сумма = Баланс.Сумма - Себестоимость;
                КоличествоВсего = КоличествоВсего - Кол;
                СуммаВсего = СуммаВсего - Себестоимость;
                Осталось = Осталось - Кол;
                ВыручкаОсталась = ВыручкаОсталась - Выручка;
            КонецЦикла;
            ВыравнятьСтоимостьПоСкладам(Объект, Все, Товар);
        КонецЦикла;
        Если Осталось > 0 Тогда
            ВызватьИсключение "Недостаточно товара " + Строка(Стр.Номенклатура) + " и его аналогов. Не хватает " + Строка(Осталось);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ПечатьОтчета(Данные, Заголовок, ВидОтчета = "") Экспорт
    Документ = Новый ТабличныйДокумент;
    Если ВидОтчета = "ВедомостьПоПодразделению" Тогда
        Заголовки = "Производитель,Товар,Нач. ост.,Приход,Расход,Кон. ост.";
    ИначеЕсли ВидОтчета = "ПродажиТоваровИАналогов" Тогда
        Заголовки = "Номенклатура,Продано,Кол-во,Себест-сть,Продажа,Прибыль";
    ИначеЕсли ВидОтчета = "ПремииЗаМесяц" Тогда
        Заголовки = "Сотрудник,Трудовой стаж,% премии,Сумма премии";
    Иначе
        Заголовки = "Номенклатура,Кол-во,Себест-сть,Продажа,Прибыль";
    КонецЕсли;
    Шапка = СтрРазделить(Заголовки, ",");
    Если ВидОтчета = "ВедомостьПоПодразделению" Тогда Шапка[0] = Данные.Колонки.Производитель.Заголовок; КонецЕсли;
    Колонок = Шапка.Количество();
    Документ.Область(1, 1, 1, Колонок).Объединить();
    Документ.Область(1, 1).Текст = Заголовок;
    Документ.Область(1, 1).Шрифт = Новый Шрифт(, 12, Истина);
    ВывестиСтрокуОтчета(Документ, 3, Шапка, Истина);
    Для Индекс = 1 По Колонок Цикл Документ.Область(, Индекс, , Индекс).ШиринаКолонки = ?(Индекс = 1, 28, 18); КонецЦикла;
    Номер = 4;
    Если ВидОтчета = "ВедомостьПоПодразделению" Тогда
        Производитель = Неопределено;
        Для Каждого Стр Из Данные Цикл
            Если Производитель <> Стр.Производитель Тогда
                Производитель = Стр.Производитель;
                Значения = Новый Массив(6);
                Для Индекс = 0 По 5 Цикл Значения[Индекс] = ""; КонецЦикла;
                Значения[0] = Производитель;
                ВывестиСтрокуОтчета(Документ, Номер, Значения, Истина);
                Номер = Номер + 1;
            КонецЕсли;
            Значения = ПоляДляПечати(Стр, "Номенклатура,НачальныйОстатокКоличество,ПриходКоличество,РасходКоличество,КонечныйОстатокКоличество");
            Значения.Вставить(0, "");
            ВывестиСтрокуОтчета(Документ, Номер, Значения);
            Значения = ПоляДляПечати(Стр, "НачальныйОстаток,Приход,Расход,КонечныйОстаток");
            Значения.Вставить(0, ""); Значения.Вставить(0, "");
            ВывестиСтрокуОтчета(Документ, Номер + 1, Значения);
            Номер = Номер + 2;
        КонецЦикла;
    ИначеЕсли ВидОтчета = "ПродажиТоваровИАналогов" Тогда
        Группы = Данные.Скопировать();
        Группы.Свернуть("Номенклатура", "Количество,Себестоимость,Выручка,Прибыль");
        Группы.Сортировать("Номенклатура");
        Для Каждого Группа Из Группы Цикл
            Значения = ПоляДляПечати(Группа, "Номенклатура,Количество,Себестоимость,Выручка,Прибыль");
            Значения.Вставить(1, "");
            ВывестиСтрокуОтчета(Документ, Номер, Значения, Истина); Номер = Номер + 1;
            Для Каждого Стр Из Данные.НайтиСтроки(Новый Структура("Номенклатура", Группа.Номенклатура)) Цикл
                Значения = ПоляДляПечати(Стр, "Продано,Количество,Себестоимость,Выручка,Прибыль");
                Значения.Вставить(0, "");
                ВывестиСтрокуОтчета(Документ, Номер, Значения); Номер = Номер + 1;
            КонецЦикла;
        КонецЦикла;
    Иначе
        Для Каждого Стр Из Данные Цикл
            Поля = ?(ВидОтчета = "ПремииЗаМесяц", "Сотрудник,Стаж,Процент,Сумма", "Номенклатура,Количество,Себестоимость,Выручка,Прибыль");
            Значения = ПоляДляПечати(Стр, Поля);
            Если ВидОтчета = "ПремииЗаМесяц" Тогда Значения[1] = Формат(Стр.Стаж, "ЧДЦ=2") + " лет"; КонецЕсли;
            ВывестиСтрокуОтчета(Документ, Номер, Значения); Номер = Номер + 1;
        КонецЦикла;
    КонецЕсли;
    Итоги = Новый Массив(Колонок);
    Для Индекс = 0 По Колонок - 1 Цикл Итоги[Индекс] = ""; КонецЦикла;
    Итоги[0] = "ИТОГО";
    Если ВидОтчета = "ПремииЗаМесяц" Тогда
        Итоги[3] = Данные.Итог("Сумма");
    ИначеЕсли ВидОтчета = "ВедомостьПоПодразделению" Тогда
        Итоги[2] = Данные.Итог("НачальныйОстатокКоличество"); Итоги[3] = Данные.Итог("ПриходКоличество");
        Итоги[4] = Данные.Итог("РасходКоличество"); Итоги[5] = Данные.Итог("КонечныйОстатокКоличество");
    Иначе
        Смещение = ?(ВидОтчета = "ПродажиТоваровИАналогов", 2, 1);
        Итоги[Смещение] = Данные.Итог("Количество"); Итоги[Смещение + 1] = Данные.Итог("Себестоимость");
        Итоги[Смещение + 2] = Данные.Итог("Выручка"); Итоги[Смещение + 3] = Данные.Итог("Прибыль");
    КонецЕсли;
    ВывестиСтрокуОтчета(Документ, Номер, Итоги, Истина);
    Если ВидОтчета = "ВедомостьПоПодразделению" Тогда
        Итоги[0] = ""; Итоги[2] = Данные.Итог("НачальныйОстаток"); Итоги[3] = Данные.Итог("Приход");
        Итоги[4] = Данные.Итог("Расход"); Итоги[5] = Данные.Итог("КонечныйОстаток");
        ВывестиСтрокуОтчета(Документ, Номер + 1, Итоги, Истина);
    КонецЕсли;
    Документ.АвтоМасштаб = Истина;
    Возврат Документ;
КонецФункции

Функция ПоляДляПечати(СтрокаДанных, Имена)
    Значения = Новый Массив;
    Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл Значения.Добавить(СтрокаДанных[Имя]); КонецЦикла;
    Возврат Значения;
КонецФункции

Процедура ВывестиСтрокуОтчета(Документ, Номер, Значения, Жирный = Ложь)
    Для Индекс = 0 По Значения.Количество() - 1 Цикл
        Ячейка = Документ.Область(Номер, Индекс + 1);
        Если ТипЗнч(Значения[Индекс]) = Тип("Число") Тогда
            Ячейка.СодержитЗначение = Истина;
            Ячейка.ТипЗначения = Новый ОписаниеТипов("Число");
            Ячейка.Значение = Значения[Индекс];
        Иначе
            Ячейка.Текст = Строка(Значения[Индекс]);
        КонецЕсли;
        Если Жирный Тогда Ячейка.Шрифт = Новый Шрифт(, , Истина); КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ВыравнятьСтоимостьПоСкладам(Объект, ОстаткиТовара, Товар)
    // Средняя стоимость едина для номенклатуры. Внутренняя корреспонденция
    // распределяет ее по оставшимся складским остаткам и убирает суммы
    // на складах с нулевым количеством, не меняя общую стоимость товара.
    Количество = 0; Сумма = 0; Последний = Неопределено;
    Для Каждого Стр Из ОстаткиТовара Цикл
        Количество = Количество + Стр.Количество; Сумма = Сумма + Стр.Сумма;
        Если Стр.Количество > 0 Тогда Последний = Стр; КонецЕсли;
    КонецЦикла;
    Если Количество = 0 И Сумма <> 0 Тогда Возврат; КонецЕсли;
    Приемники = Новый Массив; Источники = Новый Массив;
    Распределено = 0;
    Для Каждого Стр Из ОстаткиТовара Цикл
        Если Стр.Количество = 0 Тогда
            Цель = 0;
        ИначеЕсли Стр = Последний Тогда
            Цель = Сумма - Распределено;
        Иначе
            Цель = Окр(Сумма * Стр.Количество / Количество, 2);
        КонецЕсли;
        Распределено = Распределено + Цель;
        Разница = Цель - Стр.Сумма;
        Если Разница > 0 Тогда Приемники.Добавить(Новый Структура("Строка,Сумма", Стр, Разница)); КонецЕсли;
        Если Разница < 0 Тогда Источники.Добавить(Новый Структура("Строка,Сумма", Стр, -Разница)); КонецЕсли;
    КонецЦикла;
    Индекс = 0;
    Для Каждого Приемник Из Приемники Цикл
        Пока Приемник.Сумма > 0 И Индекс < Источники.Количество() Цикл
            Источник = Источники[Индекс];
            СуммаПереноса = Мин(Приемник.Сумма, Источник.Сумма);
            Д = Объект.Движения.Управленческий.Добавить(); Д.Период = Объект.Дата;
            Д.СчетДт = ПланыСчетов.Управленческий.Товары; Д.СчетКт = ПланыСчетов.Управленческий.Товары;
            Д.НоменклатураДт = Товар; Д.НоменклатураКт = Товар;
            Д.СкладДт = Приемник.Строка.Склад; Д.СкладКт = Источник.Строка.Склад;
            Д.Сумма = СуммаПереноса;
            Приемник.Строка.Сумма = Приемник.Строка.Сумма + СуммаПереноса;
            Источник.Строка.Сумма = Источник.Строка.Сумма - СуммаПереноса;
            Приемник.Сумма = Приемник.Сумма - СуммаПереноса;
            Источник.Сумма = Источник.Сумма - СуммаПереноса;
            Если Источник.Сумма = 0 Тогда Индекс = Индекс + 1; КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

Функция ПолитикиНаДату(Дата, Подразделения) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ Подразделение, Метод
    | ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение В (&Подразделения))");
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("Подразделения", Подразделения);
    Методы = Новый Соответствие;
    Для Каждого Подразделение Из Подразделения Цикл Методы.Вставить(Подразделение, Перечисления.УчетнаяПолитика.ПоСредней); КонецЦикла;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл Методы.Вставить(Выборка.Подразделение, Выборка.Метод); КонецЦикла;
    Возврат Методы;
КонецФункции

Процедура КонтрольОстатковОУ(Подразделения, Товары) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Подразделение, Номенклатура, Свойство, КоличествоОстаток
    | ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(,
    | Подразделение В (&Подразделения) И Номенклатура В (&Товары))
    | ГДЕ КоличествоОстаток < 0");
    Запрос.УстановитьПараметр("Подразделения", Подразделения); Запрос.УстановитьПараметр("Товары", Товары);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        ВызватьИсключение "Изменение нарушает остатки: " + Строка(Выборка.Номенклатура) + " / "
            + Строка(Выборка.Свойство) + " / " + Строка(Выборка.Подразделение)
            + ". Сначала отмените зависимые документы.";
    КонецЕсли;
КонецПроцедуры

Процедура КонтрольОстатковБУ(Товары) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура, Склад, КоличествоОстаток
    | ИЗ РегистрБухгалтерии.Управленческий.Остатки(, Счет = &Счет, Номенклатура В (&Товары))
    | ГДЕ КоличествоОстаток < 0");
    Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары); Запрос.УстановитьПараметр("Товары", Товары);
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        ВызватьИсключение "Изменение нарушает остатки товара " + Строка(Выборка.Номенклатура)
            + " на складе " + Строка(Выборка.Склад) + ". Сначала отмените зависимые документы.";
    КонецЕсли;
КонецПроцедуры

Функция МассивЗначения(Значение) Экспорт
    Массив = Новый Массив; Массив.Добавить(Значение); Возврат Массив;
КонецФункции

Функция ТоварыДвиженийБУ(Набор) Экспорт
    Товары = Новый Массив;
    Для Каждого Д Из Набор Цикл
        Если Д.СчетДт = ПланыСчетов.Управленческий.Товары И Товары.Найти(Д.НоменклатураДт) = Неопределено Тогда
            Товары.Добавить(Д.НоменклатураДт);
        КонецЕсли;
        Если Д.СчетКт = ПланыСчетов.Управленческий.Товары И Товары.Найти(Д.НоменклатураКт) = Неопределено Тогда
            Товары.Добавить(Д.НоменклатураКт);
        КонецЕсли;
    КонецЦикла;
    Возврат Товары;
КонецФункции
