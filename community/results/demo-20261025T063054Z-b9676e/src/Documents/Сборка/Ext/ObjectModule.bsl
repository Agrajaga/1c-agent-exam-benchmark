Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Если Не ЗначениеЗаполнено(ПодразделениеИсточник) Или Не ЗначениеЗаполнено(ПодразделениеПолучатель) Тогда
        ВызватьИсключение "Укажите подразделения списания деталей и получения блоков.";
    КонецЕсли;
    Если Блоки.Количество() = 0 Тогда ВызватьИсключение "Укажите собираемые блоки."; КонецЕсли;
    Учет.Заблокировать("РегистрНакопления.ОстаткиНоменклатуры");
    Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Движения.ОстаткиНоменклатуры.Очистить();
    Движения.ОстаткиНоменклатуры.Записать();
    Запрос = Новый Запрос("ВЫБРАТЬ Блок, МАКСИМУМ(Период) КАК Период ПОМЕСТИТЬ ВТАктуальные
    | ИЗ РегистрСведений.Спецификации
    | ГДЕ Блок В (&Блоки) И Период <= &Дата СГРУППИРОВАТЬ ПО Блок;
    | ВЫБРАТЬ С.Блок, С.Деталь, С.Свойство, С.Количество
    | ИЗ РегистрСведений.Спецификации КАК С
    | ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТАктуальные КАК А ПО С.Блок = А.Блок И С.Период = А.Период
    | ГДЕ С.Количество > 0");
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("Блоки", Блоки.ВыгрузитьКолонку("Блок"));
    Спецификации = Запрос.Выполнить().Выгрузить();
    ВсеДетали = Спецификации.ВыгрузитьКолонку("Деталь");
    Для Каждого Деталь Из ДополнительныеДетали Цикл ВсеДетали.Добавить(Деталь.Деталь); КонецЦикла;
    Подразделения = Новый Массив; Подразделения.Добавить(ПодразделениеИсточник);
    Остатки = Учет.ОстаткиОУ(МоментВремени(), Подразделения, ВсеДетали);
    Метод = Учет.Политика(ПодразделениеИсточник, Дата);
    ДопСтоимость = 0;
    Для Каждого Стр Из ДополнительныеДетали Цикл
        ДопСтоимость = ДопСтоимость + Учет.СписатьОУ(Движения.ОстаткиНоменклатуры, Остатки, Дата,
            ПодразделениеИсточник, Стр.Деталь, Стр.Свойство, Стр.Количество, Метод);
    КонецЦикла;
    КолБлоков = Блоки.Итог("Количество");
    Если КолБлоков <= 0 Тогда ВызватьИсключение "Количество блоков должно быть положительным."; КонецЕсли;
    ОстДопСтоимость = ДопСтоимость;
    Для Каждого Стр Из Блоки Цикл
        Если Стр.Количество <= 0 Тогда ВызватьИсключение "Количество блоков должно быть положительным."; КонецЕсли;
        Состав = Спецификации.НайтиСтроки(Новый Структура("Блок", Стр.Блок));
        Если Состав.Количество() = 0 Тогда ВызватьИсключение "Не задана спецификация блока " + Строка(Стр.Блок); КонецЕсли;
        Стоимость = 0;
        Для Каждого Деталь Из Состав Цикл
            Если Деталь.Количество = 0 Тогда Продолжить; КонецЕсли;
            Стоимость = Стоимость + Учет.СписатьОУ(Движения.ОстаткиНоменклатуры, Остатки, Дата,
                ПодразделениеИсточник, Деталь.Деталь, Деталь.Свойство, Деталь.Количество * Стр.Количество, Метод);
        КонецЦикла;
        ДопНаБлок = ?(Стр.НомерСтроки = Блоки.Количество(), ОстДопСтоимость, Окр(ДопСтоимость * Стр.Количество / КолБлоков, 2));
        ОстДопСтоимость = ОстДопСтоимость - ДопНаБлок;
        Учет.ПриходОУ(Движения.ОстаткиНоменклатуры, Дата, ПодразделениеПолучатель,
            Стр.Блок, Справочники.СвойстваНоменклатуры.ПустаяСсылка(), Ссылка, Стр.Количество, Стоимость + ДопНаБлок);
    КонецЦикла;
    Движения.ОстаткиНоменклатуры.Записать();
    Для Каждого Стр Из Блоки Цикл ВсеДетали.Добавить(Стр.Блок); КонецЦикла;
    Подразделения.Добавить(ПодразделениеПолучатель);
    Учет.КонтрольОстатковОУ(Подразделения, ВсеДетали);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    Учет.Заблокировать("РегистрНакопления.ОстаткиНоменклатуры");
    Движения.ОстаткиНоменклатуры.Очистить(); Движения.ОстаткиНоменклатуры.Записать();
    Учет.КонтрольОстатковОУ(Учет.МассивЗначения(ПодразделениеПолучатель), Блоки.ВыгрузитьКолонку("Блок"));
КонецПроцедуры
