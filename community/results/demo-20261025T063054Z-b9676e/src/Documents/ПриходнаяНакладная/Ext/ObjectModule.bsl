Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Учет.Заблокировать("РегистрБухгалтерии.Управленческий");
    Учет.Заблокировать("РегистрНакопления.ОстаткиНоменклатуры");
    Движения.Управленческий.Записывать = Истина;
    Движения.Управленческий.Очистить();
    Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Движения.ОстаткиНоменклатуры.Очистить();
    Для Каждого Стр Из СписокНоменклатуры Цикл
        Сумма = Учет.СуммаСтроки(Стр);
        Если ЗначениеЗаполнено(Подразделение) Тогда
            Учет.ПриходОУ(Движения.ОстаткиНоменклатуры, Дата, Подразделение, Стр.Номенклатура,
                Стр.Свойство, Ссылка, Стр.Количество, Сумма);
        КонецЕсли;
        Если ЗначениеЗаполнено(Склад) Тогда
            Д = Движения.Управленческий.Добавить();
            Д.Период = Дата;
            Д.СчетДт = ПланыСчетов.Управленческий.Товары;
            Д.СчетКт = ПланыСчетов.Управленческий.Поставщики;
            Д.НоменклатураДт = Стр.Номенклатура;
            Д.СкладДт = Склад;
            Д.КоличествоДт = Стр.Количество;
            Д.Сумма = Сумма;
        КонецЕсли;
    КонецЦикла;
    Если Не ЗначениеЗаполнено(Подразделение) И Не ЗначениеЗаполнено(Склад) Тогда
        ВызватьИсключение "Укажите подразделение и/или склад.";
    КонецЕсли;
    Движения.Управленческий.Записать();
    Движения.ОстаткиНоменклатуры.Записать();
    Учет.КонтрольОстатковБУ(СписокНоменклатуры.ВыгрузитьКолонку("Номенклатура"));
    Учет.КонтрольОстатковОУ(Учет.МассивЗначения(Подразделение), СписокНоменклатуры.ВыгрузитьКолонку("Номенклатура"));
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    Учет.Заблокировать("РегистрБухгалтерии.Управленческий");
    Учет.Заблокировать("РегистрНакопления.ОстаткиНоменклатуры");
    Движения.Управленческий.Очистить(); Движения.Управленческий.Записать();
    Движения.ОстаткиНоменклатуры.Очистить(); Движения.ОстаткиНоменклатуры.Записать();
    Учет.КонтрольОстатковБУ(СписокНоменклатуры.ВыгрузитьКолонку("Номенклатура"));
    Учет.КонтрольОстатковОУ(Учет.МассивЗначения(Подразделение), СписокНоменклатуры.ВыгрузитьКолонку("Номенклатура"));
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    СуммаПоДокументу = 0;
    Для Каждого Стр Из СписокНоменклатуры Цикл
        Если Стр.Сумма = 0 Тогда Стр.Сумма = Окр(Стр.Количество * Стр.Цена, 2); КонецЕсли;
        СуммаПоДокументу = СуммаПоДокументу + Стр.Сумма;
    КонецЦикла;
КонецПроцедуры
