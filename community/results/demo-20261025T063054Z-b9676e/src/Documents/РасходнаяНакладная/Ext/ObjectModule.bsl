Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Учет.Заблокировать("РегистрБухгалтерии.Управленческий");
    Учет.Заблокировать("РегистрНакопления.ОстаткиНоменклатуры");
    Движения.Управленческий.Записывать = Истина;
    Движения.Управленческий.Очистить();
    Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Движения.ОстаткиНоменклатуры.Очистить();
    Движения.Продажи.Записывать = Истина;
    Движения.Продажи.Очистить();
    // Исключаем прежние движения при повторном проведении.
    Движения.Управленческий.Записать();
    Движения.ОстаткиНоменклатуры.Записать();
    Если ЗначениеЗаполнено(Склад) Тогда Учет.ПродажаБУ(ЭтотОбъект); КонецЕсли;
    Остатки = Учет.ОстаткиОУ(МоментВремени(), СписокНоменклатуры.ВыгрузитьКолонку("Подразделение"), СписокНоменклатуры.ВыгрузитьКолонку("Номенклатура"));
    Методы = Учет.ПолитикиНаДату(Дата, СписокНоменклатуры.ВыгрузитьКолонку("Подразделение"));
    Для Каждого Стр Из СписокНоменклатуры Цикл
        Выручка = Учет.СуммаСтроки(Стр);
        Если ЗначениеЗаполнено(Стр.Подразделение) Тогда
            Стоимость = Учет.СписатьОУ(Движения.ОстаткиНоменклатуры, Остатки, Дата,
                Стр.Подразделение, Стр.Номенклатура, Стр.Свойство, Стр.Количество, Методы.Получить(Стр.Подразделение));
            Д = Движения.Продажи.Добавить();
            Д.Период = Дата;
            Д.Подразделение = Стр.Подразделение;
            Д.Номенклатура = Стр.Номенклатура;
            Д.Количество = Стр.Количество;
            Д.Себестоимость = Стоимость;
            Д.Выручка = Выручка;
        ИначеЕсли Не ЗначениеЗаполнено(Склад) Тогда
            ВызватьИсключение "Укажите подразделение в строке либо склад документа.";
        КонецЕсли;
    КонецЦикла;
    Движения.Управленческий.Записать();
    Движения.ОстаткиНоменклатуры.Записать();
    Учет.КонтрольОстатковБУ(Учет.ТоварыДвиженийБУ(Движения.Управленческий));
    Учет.КонтрольОстатковОУ(СписокНоменклатуры.ВыгрузитьКолонку("Подразделение"), СписокНоменклатуры.ВыгрузитьКолонку("Номенклатура"));
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    Учет.Заблокировать("РегистрБухгалтерии.Управленческий");
    Учет.Заблокировать("РегистрНакопления.ОстаткиНоменклатуры");
    Движения.Управленческий.Очистить(); Движения.Управленческий.Записать();
    Движения.ОстаткиНоменклатуры.Очистить(); Движения.ОстаткиНоменклатуры.Записать();

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    СуммаПоДокументу = 0;
    Для Каждого Стр Из СписокНоменклатуры Цикл
        Если Стр.Сумма = 0 Тогда Стр.Сумма = Окр(Стр.Количество * Стр.Цена, 2); КонецЕсли;
        СуммаПоДокументу = СуммаПоДокументу + Стр.Сумма;
    КонецЦикла;
КонецПроцедуры
