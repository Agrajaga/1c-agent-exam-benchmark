        {
          "unzip-source": "unica-package.zip"
        },
        {
          "copy-tree": "*/plugins/unica",
          "to": "plugin"
        },
        {
          "verified-entrypoint": "unica-runtime.tar.gz",
          "manifest": "unica-runtime.json",
          "to": "unica.exe"
        }
      ],
      "configuration": {
        "version": "0.14.0-rc.1",
        "label": "Unica 0.14 RC1",
        "server": "unica",
        "command": "{package}/unica.exe",
        "args": [],
        "env": {
          "CLAUDE_PLUGIN_ROOT": "{package}/plugin",
          "CLAUDE_PROJECT_DIR": "{workspace}",
          "UNICA_HOST_CONTEXT_REQUIRED": "1",
          "UNICA_PROVIDER_STATE_DIR": "{tmp}/unica-state",
          "UNICA_RUNTIME_CACHE_DIR": "{tmp}/unica-runtimes",
          "UNICA_DAEMON_IDLE_GRACE_MS": "1000"
        },
        "skills": "plugin/skills",
        "skill_siblings": [
          "references",
          "third-party"
        ],
        "registration": "Verified official Windows runtime and unchanged marketplace skills; isolated state; no native plugin hooks"
