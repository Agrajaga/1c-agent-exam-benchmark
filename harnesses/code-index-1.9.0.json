{
  "schema_version": 1,
  "id": "code-index-1.9.0",
  "label": "Code Index 1.9.0",
  "version": "1.9.0",
  "homepage": "https://github.com/Regsorm/code-index-mcp",
  "description": "Индекс исходников конфигурации и MCP-поиск по объектам.",
  "probe": "code-index",
  "targets": {
    "windows-x64": {
      "downloads": {
        "index-win.zip": {
          "url": "https://github.com/Regsorm/code-index-mcp/releases/download/v1.9.0/bsl-indexer-windows-x64.zip",
          "sha256": "52930346b33401819066781365bf7a53809cbd8ca44d2abafe5e5fed71e92c3c",
          "bytes": 10262748
        }
      },
      "install": [
        {
          "unzip": "index-win.zip",
          "to": "."
        }
      ],
      "configuration": {
        "version": "1.9.0",
        "label": "Code Index 1.9.0",
        "server": "code-index",
        "command": "{package}/bsl-indexer.exe",
        "args": [
          "serve",
          "--path",
          "{src}"
        ],
        "env": {
          "CODE_INDEX_HOME": "{tmp}/code-index-home"
        },
        "registration": "Official Windows indexer; per-worker daemon and source index"
      }
    },
    "macos-arm64": {
      "downloads": {
        "index.tar.gz": {
