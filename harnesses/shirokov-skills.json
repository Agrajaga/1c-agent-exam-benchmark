      "configuration": {
        "version": "920ceda28f328cdba5f798942802845908066e1b",
        "label": "Skills Широкова · Python/Codex",
        "skills": ".codex/skills",
        "command": "{python}",
        "registration": "Unchanged author Python port for Codex; isolated skill tree and pinned Python dependencies",
        "worker_env": {
          "PYTHONPATH": "{package}/python-site-packages",
          "PYTHONDONTWRITEBYTECODE": "1",
          "PATH": "{package}/node;{python_bin}",
